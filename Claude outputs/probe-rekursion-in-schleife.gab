-- **A recursive call INSIDE a loop** -- the one wiring shape `unit_closed` did not write
-- until 2026-09-08 (`programmlogik/PLAN.md` §5.2 item 3).
--
-- The corpus had no unit of this shape: every self-recursion in it calls itself at the top
-- level of the body (`beispiele/33-rekursion`), and every loop that calls a routine calls
-- somebody else. **A wiring nobody measures is a wiring nobody has.** So this file is the
-- measurement: the smallest program the checker accepts in which a routine with a
-- `decreases` reaches itself from inside its own `traverse`.
--
-- What the model does with it (`Gabbro/Body.lean` §8, `contract_of_duty_rec_loop_in`): the
-- induction over `decreases` runs OUTSIDE the loop rule, so the pass may assume the routine's
-- own contract on states below the ROUTINE'S ENTRY state -- and owes in return that the
-- measure is still the one the routine entered with. Without that second half the bound
-- would be about a state the loop has already left.
--
-- The guard is `if n > 0` and not an early `return`: a `return` inside a loop body is
-- refused by name (`return-in-loop`), and `n - 1` needs `V1`/`V2` to have narrowed `n`.

module probe::rekursion_in_schleife {

const TIEFE  : u32 = 8;
const NSLOTS : u32 = 4;

table Zelle count NSLOTS {
    slot { marke : u32 in 0 .. TIEFE, }
}

impl fn faerben(z : ptr<normal, rw> Zelle, n : u32 in 0 .. TIEFE)
    ensures  forall s in slots of z : z.slots[s].marke <= TIEFE
    effects  { reads z.slots, writes z.slots }
    costs    <= 65536 ops
    decreases n
{
    traverse i over slots of z by unvisited
        touches reads z.slots, writes z.slots
        invariant n <= TIEFE
    {
        z.slots[i].marke = n;
        if n > 0 { faerben(z, n - 1); }
    }
}

}
