module probe::akzeptiertdiffguarded {

table T count 2 {
    slot { v : u32, }
}

lock L protects { T } rank 0 held <= 100 ops;

impl fn a()
    effects { reads T.slots, writes T.slots, locks L }
    costs   <= 64 ops
{
    locks L {
        T.slots[0].v = 1;
    }
}

impl fn b()
    effects { reads T.slots, writes T.slots, locks L }
    costs   <= 64 ops
{
    locks L {
        T.slots[1].v = 2;
    }
}

concurrent { a, b };

}
