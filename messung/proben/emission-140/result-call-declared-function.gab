-- ARM 3 twin, must LOWER: a call to a DECLARED function named `result` (lane-140).
--
-- `result` is a contextual word, so `fn result` declares an ordinary function -- and
-- a call to it is an ordinary call. The refusal beside it fires only where no
-- declaration stands behind the name; this twin proves the guard reads
-- `u.funktionen` instead of the spelling.
--
-- Measured verdicts (recorded after the run, not before):
--   pruefe: 0 errors, 0 hints
--   emit:   exit 0; the C calls `result`
--   cc:     takes the unit (-std=c11, -O0 and -O2, -Wall -Wextra -Werror, -c)

module probe::emission140_result_call_declared_function {

fn result(a : u64) -> u64
    effects { pure }
{
    return a;
}

fn f(a : u64) -> u64
    effects { pure }
{
    return result(a);
}

}
