-- Injektivitaetsprobe fuer `gabbro zeugnis`, Haelfte A -- Domaene `threads`.
--
-- **Diese Datei und ihre Schwester unterscheiden sich in GENAU EINER ZEILE**, der
-- Traversierungsdomaene. Beide gehen mit `0 errors, 0 hints` durch. Und ihre Zeugnisse
-- sind BYTEIDENTISCH (md5 `152d61a6`, gemessen 2026-08-31):
--
--      table.induktion          proved     1x  traverse
--
-- `zeugnis.rs` fuehrte `ElementeVon`, `KetteIn`, `Schlange`, `SlotsVon` und `Threads` auf
-- einem `_ => "traverse"` zusammen -- fuenf Domaenenformen, ein Ausweis.
--
-- **Ein Zeugnis, das zwei verschiedene Programme belegt, belegt keines von beiden.** Das
-- ist die eine Eigenschaft, die ein Uebersetzungsbeleg nicht haben darf, und sie haengt
-- nicht daran, ob der Erzeuger richtig arbeitet.
--
-- **GEHEILT am 2026-08-31**, und die Antwort folgte aus der Messung: `traversenausweis`
-- zaehlt alle NEUN Domaenen einzeln auf, und `EINORDNUNG` traegt je Form den Grund, auf dem
-- ihre Schranke ruht -- neun verschiedene Gruende, und **drei Formen ruhen auf gar keiner**
-- (`chain(…) in`, `fields of`, `threads`; `domaenenschranke` schweigt, `K003` verlangt eine
-- Deklaration). *Genau das verschwieg der eine Ausweis.*
--
-- Dieses Paar wird seither GEMESSEN und nicht behauptet:
-- `crates/gabbro-check/tests/zeugnis_injektiv.rs` rendert beide unter DEMSELBEN Dateinamen
-- -- der Kopf darf den Unterschied nicht machen -- und verlangt
--
--      das gemessene Paar          verschieden
--      zwei gleiche Programme      gleich          (sonst waere ein Zeitstempel „injektiv")
--      alle neun Domaenen          paarweise verschieden

module probe::inj {
const N : u32 = 8;
extern fn nie() -> never effects { diverges } costs <= 0 ops;
table Warteschlange count N {
    slot { a : u32, naechst : option index into Warteschlange, }
    tree { sibling naechst }
}
type Ring = { plaetze : [u32; 8], kopf : u32, };

divergent fn eine(q : ptr<normal, rw> Warteschlange, r : ptr<normal, rw> Ring) -> never
    effects { writes q.slots, diverges }
{
    traverse t over threads by unvisited touches writes q.slots {
        q.slots[0].a = 1;
    }
    nie();
}
}
