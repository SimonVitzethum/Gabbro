-- emission-143: pins `const` (Census C2, OffeneForm.cConst, 419 sites).
-- A generated reader takes a read-only handle: `const D *restrict v`.
-- Verdict: admit with price (ruled in messung/CFORM-REGEL-CONST.md). No emitter change.

module emission143::cconst {

opaque type Pa = u64;

device D(basis : Pa) at mmio {
    reg R : u32 @0x0 class r
}

impl fn lies(v : ptr<mmio, r> D) -> u32
    effects { reads v.R }
{
    return v.R;
}

}
