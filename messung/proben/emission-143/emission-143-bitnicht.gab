-- emission-143: pins `~` bitwise complement (Census C2, OffeneForm.bitNicht, 98 sites).
-- The lowering binds the operand width with the double cast:
-- `return (u16)~(u16)(x);`. The width-less `where`-clause position stays refused.
-- Verdict: admit with price (ruled in messung/CFORM-REGEL-TILDE.md). No emitter change.

module emission143::bitnicht {

fn spiegel(x : u16) -> u16 effects { pure } {
    return ~x;
}

}
