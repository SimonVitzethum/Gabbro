-- emission-155: pins `enum` over a reason channel (Census C1, OffeneForm.cEnum, 28 sites).
-- A reason lowers to `typedef enum { ... } Fehler;` over the closed alternative
-- list; the matching switch carries no default so `-Wswitch` re-reads the same
-- exhaustiveness the checker demands. Closed list, fixed values, no new conversion.
-- Verdict: admit with price (ruled in messung/CFORM-REGEL-ENUM.md). No emitter change.

module emission155::cenum_reason {

reason Fehler {
    Leer = 1 "leer"
    Voll = 2 "voll"
    exhaustive
}

extern fn gib_opt() -> u32 or Fehler effects { pure };

fn ruf() -> u32 effects { pure } {
    let v = gib_opt() else (e) {
        return 0;
    }
    return v;
}

}
