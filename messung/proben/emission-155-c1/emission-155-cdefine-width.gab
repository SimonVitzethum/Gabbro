-- emission-155: pins `#define` over a width constant (Census C1, OffeneForm.cDefine, 210 sites).
-- A width constant lowers to the suffixed shape, `#define BREITE 8u`: object-like,
-- no parameters, the type carried in the spelling so no conversion at the read.
-- The table count reuses the same single definition point.
-- Verdict: admit with price (ruled in messung/CFORM-REGEL-DEFINE.md). No emitter change.

module emission155::cdefine_width {

const BREITE : u32 = 8;

table Puffer count BREITE {
    slot { aktiv : bool, }
}

fn breite() -> u32
    effects { pure }
{
    return BREITE;
}

}
