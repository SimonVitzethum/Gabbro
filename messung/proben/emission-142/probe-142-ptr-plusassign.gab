-- erwartet: C001
-- Lane 142, CForm zeigerArithmetik, compound-assignment arm. Same form, second
-- spelling: `p += 1` on a pointer place. The place's C type ends with `*`, so
-- the Zuweisung arm refuses by name instead of emitting `p += 1`. Integer
-- places (`s.len += 1`, register writes, slot counters) carry no `*` and are
-- unaffected -- the scan over the corpus found no pointer-typed `+=`/`-=`.
-- Checker half merge-verified (this lane runs no builds); this unit proves the
-- emitter path.
module probe::ptrzuw142 {
type Zelle = { wert : u32, };
impl fn eins_weiter_zu(p : ptr<normal, rw> Zelle)
    effects { reads p, writes p }
    costs   <= 8 ops
{
    p += 1;
}
}
