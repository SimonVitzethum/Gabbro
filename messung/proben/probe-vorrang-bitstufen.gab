-- ---- die zwei Grenzen daneben ---------------------------------------------

impl fn flach_grenze_und_gleich(a : Klein, b : Klein, c : Klein) -> bool
    effects { pure }
    costs   <= 16 ops
{
    return a & b == c;
}

impl fn klammer_grenze_und_gleich(a : Klein, b : Klein, c : Klein) -> bool
    effects { pure }
    costs   <= 16 ops
{
    return (a & b) == c;
}

impl fn flach_grenze_xor_gleich(a : Klein, b : Klein, c : Klein) -> bool
    effects { pure }
    costs   <= 16 ops
{
    return a ^ b == c;
}

impl fn klammer_grenze_xor_gleich(a : Klein, b : Klein, c : Klein) -> bool
    effects { pure }
    costs   <= 16 ops
{
    return (a ^ b) == c;
}

impl fn flach_grenze_oder_gleich(a : Klein, b : Klein, c : Klein) -> bool
    effects { pure }
    costs   <= 16 ops
{
    return a | b == c;
}

impl fn klammer_grenze_oder_gleich(a : Klein, b : Klein, c : Klein) -> bool
    effects { pure }
    costs   <= 16 ops
{
    return (a | b) == c;
}

impl fn flach_grenze_schiebl_klein(a : Klein, b : Klein, c : Klein) -> bool
    effects { pure }
    costs   <= 16 ops
{
    return a << b < c;
}

impl fn klammer_grenze_schiebl_klein(a : Klein, b : Klein, c : Klein) -> bool
    effects { pure }
    costs   <= 16 ops
{
    return (a << b) < c;
}

impl fn flach_grenze_plus_schiebl(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
    costs   <= 16 ops
{
    return a + b << c;
}

impl fn klammer_grenze_plus_schiebl(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
    costs   <= 16 ops
{
    return (a + b) << c;
}

impl fn flach_grenze_schiebl_plus(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
    costs   <= 16 ops
{
    return a << b + c;
}

impl fn klammer_grenze_schiebl_plus(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
    costs   <= 16 ops
{
    return a << (b + c);
}

