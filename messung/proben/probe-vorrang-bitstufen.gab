    effects { pure }
    costs   <= 16 ops
{
    return (a ^ b) << c;
}

impl fn klammer_xor_schiebr(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
    costs   <= 16 ops
{
    return (a ^ b) >> c;
}

impl fn klammer_xor_und(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
    costs   <= 16 ops
{
    return (a ^ b) & c;
}

impl fn klammer_xor_xor(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
