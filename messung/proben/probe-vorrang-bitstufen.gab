{
    return (a | b) << c;
}

impl fn klammer_oder_schiebr(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
    costs   <= 16 ops
{
    return (a | b) >> c;
}

impl fn klammer_oder_und(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
    costs   <= 16 ops
{
    return (a | b) & c;
}

