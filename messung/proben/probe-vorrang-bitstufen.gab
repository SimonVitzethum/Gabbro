}

impl fn klammer_schiebr_oder(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
    costs   <= 16 ops
{
    return (a >> b) | c;
}

impl fn klammer_und_schiebl(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
    costs   <= 16 ops
{
    return (a & b) << c;
}

impl fn klammer_und_schiebr(a : Klein, b : Klein, c : Klein) -> u32
    effects { pure }
