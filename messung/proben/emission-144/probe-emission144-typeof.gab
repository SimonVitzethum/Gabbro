-- emission-144/typeof: `__typeof__` is the lowering of the checked reference.
--
-- Census slot C2 `typOfErw`, 9 sites (`dokumente/BEWEIS.md` Subject 2;
-- `grammatik/Grammatik/Erhaltung.lean`, `OffeneForm.typOfErw`). Emitter site:
-- `crates/gabbro-check/src/emit.rs`, `bezugnahme`, which writes
-- `static __typeof__(ziel) *const marke __attribute__((unused)) = ziel;`.
-- The form stands so the signature is written ONCE: deriving it from the
-- declaration here and spelling it out a second time would be two registers
-- over one fact. Where the target names no body this unit declares, the
-- emitter writes a comment instead (`N006` holds the declaration side).
--
-- Verdict: LOWERED. `gabbro pruefe` reports 0 errors, `gabbro emit` writes the
-- `__typeof__` binding with 0 refusals, and the emitted unit compiles under
-- `cc -std=c11 -Wall -Wextra -Werror` at `-O0` and `-O2`.

module probe::emission144_typeof {

-- An entry that destroys nothing says so: the empty lists are a statement.
entry leiser_eintritt vector 32 arch x86_64 {
    regs in  { nr : rax }
    regs out { ret : rax }
    preserves { }
    clobbers  { }
    stack kernstapel
    dispatch behandler;
}

-- **Changed 2026-09-26 (Opus agent L, OFFEN O32 (7), `N561`):** the dispatch took no
-- parameter and answered nothing while the entry binds one register(s) in and `rax` out,
-- so no stub could bind them without guessing. The head now takes one `u64` per
-- `regs in` register, in order, and answers the `regs out` value.
extern fn behandler(nr : u64) -> u64 effects { pure };

}
