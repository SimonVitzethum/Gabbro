-- @gabi 1
-- link-erwartet: N502
-- **Link probe 1242 (Opus agent E): the exported contract is TOO WEAK for the importer.**
-- The head promises one conjunct more than `setze` ensures (`konto.slots[1].stand == x`
-- stated separately, as an importer that relies on it would write it): the app checks clean
-- against this head, the link refuses -- the linked program has ONE contract per function.

module bib {
pub const NSLOTS : u32 = 2;
pub type Stand = u32 in 0 .. 100;
pub table konto count NSLOTS {
    slot {
        stand : Stand,
    }
}
pub lock L protects { konto } rank 0 held <= 100 ops
    invariant konto.slots[0].stand == konto.slots[1].stand;
pub extern fn setze(x : Stand)
    requires Held(L), konto.slots[0].stand == konto.slots[1].stand
    ensures  konto.slots[0].stand == konto.slots[1].stand && konto.slots[0].stand == x,
             konto.slots[1].stand == x
    effects  { reads konto.slots, writes konto.slots, locks L }
    costs    <= 64 ops;
}
