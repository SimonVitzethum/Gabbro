-- @gabi 1
-- link-erwartet: N503
-- **Link probe 1243 (Opus agent E): the head hides a read -- the footprints do not compose.**
-- The head says `setze` only WRITES `konto`; the body also reads it. The importer's race and
-- footprint checks read exactly this summary, so the app checks clean against it; the link
-- refuses.

module bib {
pub const NSLOTS : u32 = 2;
pub type Stand = u32 in 0 .. 100;
pub table konto count NSLOTS {
    slot {
        stand : Stand,
    }
}
pub lock L protects { konto } rank 0 held <= 100 ops
    invariant konto.slots[0].stand == konto.slots[1].stand;
pub extern fn setze(x : Stand)
    requires Held(L), konto.slots[0].stand == konto.slots[1].stand
    ensures  konto.slots[0].stand == konto.slots[1].stand && konto.slots[0].stand == x
    effects  { writes konto.slots, locks L }
    costs    <= 64 ops;
}
