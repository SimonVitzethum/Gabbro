-- **Link probe (Opus agent E, 2026-09-26): the LIBRARY -- a lock-guarded table writer with a
-- contract.** The Rust twin of the Lean witness `vz_ziel` (`Zielsatz/VerbundZeuge.lean`).
--
-- Alone: `gabbro check messung/proben/verbund/tabelle-bib.gab`. Its interface:
-- `gabbro abi messung/proben/verbund/tabelle-bib.gab > bib.gabi`. Linked with its app:
-- `gabbro link messung/proben/verbund/tabelle-bib.gab messung/proben/verbund/tabelle-app.gab
--  --with bib.gabi` (`crates/gabbro-cli/tests/verbund.rs`).
--
-- `setze` holds the lock by signature, writes both slots of `konto` and promises the lock
-- invariant back plus the value it wrote; the library starts no thread of its own.
module bib {

pub const NSLOTS : u32 = 2;

pub type Stand = u32 in 0 .. 100;

pub table konto count NSLOTS {
    slot {
        stand : Stand,
    }
}

pub lock L protects { konto } rank 0 held <= 100 ops
    invariant konto.slots[0].stand == konto.slots[1].stand;

assume takt_stabil
    "The platform clock advances steadily."
    falsifier sonde_takt;

pub impl fn setze(x : Stand)
    requires Held(L), konto.slots[0].stand == konto.slots[1].stand
    ensures  konto.slots[0].stand == konto.slots[1].stand && konto.slots[0].stand == x
    effects  { reads konto.slots, writes konto.slots, locks L }
    costs    <= 64 ops
{
    konto.slots[0].stand = x;
    konto.slots[1].stand = x;
}

}
