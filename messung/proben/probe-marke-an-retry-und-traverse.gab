-- MINIMISED, from the `probe_ecam` attempt (`caprock-virtio/src/lib.rs:173`).
--
-- **`leave`/`next` naming a `retry` CHECKED and until 2026-09-03 did NOT LOWER.**
--
-- `retry [ident] …` (`SYNTAX.md`:1000) and `forever [ident] …` (:1008) both carry a label;
-- `traverse ident` does not -- there the `ident` is the loop VARIABLE, and `next i` falls at
-- `S001`, correctly. So the question was about two forms, not three.
--
-- The checker resolves both labels: `S001` is its refusal for a label that names no
-- enclosing loop, and it stayed silent at the `retry`. The EMITTER registered exactly ONE.
-- **`emit.rs`'s `forever` writer held the only `schleifen.push` in the whole file** -- line
-- 7821 on 2026-09-03, and the COUNT was the durable half of that, not the line.
--
-- The corpus hid it by construction: every `leave`/`next` in `beispiele/41` names `runde`,
-- `bootlauf` or `leerlauf`, and all three are `forever` labels.
--
-- Two functions, one loop form each, so that no refusal masks the other.
--
-- **Repaired 2026-09-03, `D21` (`messung/ERZEUGERREST.md`).** `retry`'s own lowering
-- (`emit.rs::retry`) now does what `forever`'s already did: compute the label (the written
-- one, or a fallback from the loop's span), push it onto `austritt.schleifen`, and emit the
-- `_weiter`/`_ende` labels a `next`/`leave` needs. Both functions below now check AND lower;
-- this file is the regression lock for that.

module probe::marke_an_schleifen {

extern fn haengt() -> never effects { diverges } costs <= 1 ops;

assume geht_weiter
    "The condition becomes true within the bound."
    falsifier sonde_haengt;

static mut zaehler : u32 = 0;

-- 1. `next` at a `forever` label -- the one the corpus uses, and the one that lowers.
impl fn an_forever()
    effects { writes zaehler, reads zaehler }
{
    forever runde
        per_pass  bounded 16 ops
        on_exceeded haengt
        effects   { writes zaehler, reads zaehler }
        progress  geht_weiter
    {
        if zaehler == 0 {
            next runde;
        }
        zaehler = 0;
    }
}

-- 2. `next` at a `retry` label.
impl fn an_retry()
    effects { writes zaehler, reads zaehler }
    costs   <= 128 ops
{
    retry lauf until zaehler == 3
        bounded 64 ops
        progress geht_weiter
        on_exceeded haengt
        effects { writes zaehler, reads zaehler }
    {
        if zaehler == 0 {
            next lauf;
        }
        zaehler = 3;
    }
}

}
