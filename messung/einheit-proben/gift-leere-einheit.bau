-- GIFT: eine Einheit ohne Datei.
--
-- Ein Bau ueber nichts meldet Erfolg, und „nichts gefunden" sieht dann aus wie „nichts
-- angesehen" -- genau die Verwechslung, gegen die die Deckungszeile steht. Also faellt sie
-- schon am Manifest.

compiler cc -std=c11 -Wall -Wextra -Werror
out      target/bau-gift

unit leer object
