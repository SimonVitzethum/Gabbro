-- EINE Einheit, ein Sperrname, den niemand deklariert. Faellt das?
-- **`pub` an Tabelle und Sperre, seit dem 2026-08-25.** Bis dahin trugen die Traeger kein
-- Sichtbarkeitswort, und `gabbro abi` zog sie ueber ERREICHBARKEIT hinaus -- weil die
-- exportierte Signatur sie nennt. *Das ist eine implizite Ausfuhrmenge, und D2 verbietet
-- sie.* `N038` weist die Signatur jetzt ab, solange der Traeger nicht selbst hinaus soll.
module unbek {

pub const N : u32 = 8;

pub table T count N {
    slot { a : u32, }
}

pub impl fn f(i : index into T) -> bool
    effects { writes T.slots, locks NIEDA }
    costs   <= 30 ops
{
    locks NIEDA {
        T.slots[i].a = 1;
    }
    return true;
}

}
