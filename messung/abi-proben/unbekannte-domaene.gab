-- Die Gegenprobe zu `unbekannte-sperre.gab`, EINE Ebene weiter: eine RCU-Domaene, die
-- keine Deklaration erklaert. Faellt das? (Gemessen 2026-08-21 fuer `messung/ABI.md`.)
-- **`pub` an Tabelle und Sperre, seit dem 2026-08-25.** Bis dahin trugen die Traeger kein
-- Sichtbarkeitswort, und `gabbro abi` zog sie ueber ERREICHBARKEIT hinaus -- weil die
-- exportierte Signatur sie nennt. *Das ist eine implizite Ausfuhrmenge, und D2 verbietet
-- sie.* `N038` weist die Signatur jetzt ab, solange der Traeger nicht selbst hinaus soll.
module unbekdom {

pub const N : u32 = 8;

pub table T count N {
    slot { a : u32, }
}

pub impl fn liest(i : index into T) -> u32
    effects { reads T.slots }
    costs   <= 30 ops
{
    let mut v : u32 = 0;
    observes NIEDADOM {
        v = T.slots[i].a;
    }
    return v;
}

}
