-- W24-Vorlauf: `measures` nennt eine Groesse, die es nicht gibt.
module w24::t5 {

static mut k : u32 = 0;

impl fn tor() effects { reads k } costs <= 1 ops { return; }

check c {
    claim    "Gemessen wird etwas, das nirgends steht."
    measures gibt_es_nicht
    gates    tor
    can_fail { if k >= 3 { return false; } return true; }
    floor    k >= 1
}

}
