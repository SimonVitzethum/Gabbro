-- W24-Vorlauf: das Tor nennt einen Traeger, der KEINE Funktion und KEIN check ist.
module w24::t3 {

static mut k : u32 = 0;
static mut tor : u32 = 0;

check c {
    claim    "Das Tor ist ein Speicherplatz."
    measures k
    gates    tor
    can_fail { if k >= 3 { return false; } return true; }
    floor    k >= 1
}

}
