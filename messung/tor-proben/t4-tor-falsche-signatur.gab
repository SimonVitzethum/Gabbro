-- W24-Vorlauf: das Tor hat eine Signatur, die keine Pflicht verbrauchen kann.
module w24::t4 {

static mut k : u32 = 0;

impl fn tor(x : u32) -> u32 effects { reads k } costs <= 1 ops { return x; }

check c {
    claim    "Das Tor nimmt ein Argument und gibt einen Wert zurueck."
    measures k
    gates    tor
    can_fail { if k >= 3 { return false; } return true; }
    floor    k >= 1
}

}
