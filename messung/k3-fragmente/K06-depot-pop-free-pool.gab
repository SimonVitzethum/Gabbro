--   function depot_pop_free_pool
--   picked   by the rule in `messung/K3-AUSWAHL.md`
--
-- **NOT MEASURED AT THE TIME OF THIS COMMIT.**
--
-- ## The excerpt, verbatim
--
--  361  static struct stack_record *depot_pop_free_pool(void **prealloc, size_t size)
--  362  	__must_hold(&pool_lock)
--  363  {
--  364  	struct stack_record *stack;
--  365  	void *current_pool;
--  366  	u32 pool_index;
--  367
--  368  	lockdep_assert_held(&pool_lock);
--  369
--  370  	if (pool_offset + size > DEPOT_POOL_SIZE) {
