--   picked   by the rule in `messung/K3-AUSWAHL.md` -- the largest of the eight, 56 body
--            lines, one line under the window's upper bound
--
-- **NOT MEASURED AT THE TIME OF THIS COMMIT.**
--
-- ## The excerpt, verbatim
--
--  536  static int test_func(void *private)
--  537  {
--  538  	struct test_driver *t = private;
--  539  	int random_array[ARRAY_SIZE(test_case_array)];
--  540  	int index, i, j, ret;
--  541  	ktime_t kt;
--  542  	u64 delta;
--  543
--  544  	for (i = 0; i < ARRAY_SIZE(test_case_array); i++)
--  545  		random_array[i] = i;
--  546
--  547  	if (!sequential_test_order)
--  548  		shuffle_array(random_array, ARRAY_SIZE(test_case_array));
