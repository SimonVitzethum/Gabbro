// (a) Source buffer: the fixed program text under test lives in a byte
// table. There is no file input in a probe, so `main` fills the table from
// an embedded constant and every later stage reads through `byte_at`.
// The text exercises every form the lexer and parser implement:
//
//   fn max(a, b) {
//   /* smaller of the two */
//   if a < b { return a; } else { return b; }
//   }
//   // end of max
//   fn main() {
//   let x = 2 * (3 + 4);
//   return x + max(x, 1);
//   }
//
// All four files of this unit share one module: write rights do not cross
// module boundaries (see WANTED below), so one module holds all tables.
module front {
// WANTED: one cursor loop that copies the text, written the way a compiler
// writer would write it first:
//   fill the table with `while pos < SRCLEN { src.slots[pos].b = TEXT[pos]; }`
// Stage 0 refuses the loop: `stage0: assignment or call expected` (there is
// no `while` in the language; only `traverse`, `retry` and `forever` exist).
// Workaround below: explicit recursion with a fuel parameter and `decreases`.
// WANTED: the shared text as a string constant, `const TEXT : string max 160`,
// copied byte by byte. Stage 0 refuses any use of a string constant:
// `stage0: name unknown: TEXT` at the use, then
// `note: elaboration: function main: name unknown: TEXT`. Workaround below:
// a constant array of byte values plus a recursive copy.
// WANTED: one module per file (`module srcbuf`, `module lex`, ...) with the
// later stages calling the earlier ones' writers, e.g. `srcbuf::fill()` from
// `main`. Stage 0 refuses the call: with a pure caller,
// `stage0: call writes without right`; when the caller claims the foreign
// write (`writes srcbuf.src.slots`), `stage0: writes clause without G form`
// with `note: elaboration: ... (statement 1 of 1: call fill)`; the same for
// modules in one file, and for `use` imports of `pub` items, which fail with
// `stage0: public interface is not closed` plus
// `note: export gate refuses: SItemTief.useT: ...`. Only reads cross module
// boundaries. Workaround below: all four files share `module front` and call
// each other directly; names are kept apart by stage prefixes.
const SRCLEN : u32 in 0 .. 160 = 155;
const TEXT : [u32 in 0 .. 255; 160] = [
    102, 110, 32, 109, 97, 120, 40, 97,
    44, 32, 98, 41, 32, 123, 10, 47,
    42, 32, 115, 109, 97, 108, 108, 101,
    114, 32, 111, 102, 32, 116, 104, 101,
    32, 116, 119, 111, 32, 42, 47, 10,
    105, 102, 32, 97, 32, 60, 32, 98,
    32, 123, 32, 114, 101, 116, 117, 114,
    110, 32, 97, 59, 32, 125, 32, 101,
    108, 115, 101, 32, 123, 32, 114, 101,
    116, 117, 114, 110, 32, 98, 59, 32,
    125, 10, 125, 10, 47, 47, 32, 101,
    110, 100, 32, 111, 102, 32, 109, 97,
    120, 10, 102, 110, 32, 109, 97, 105,
    110, 40, 41, 32, 123, 10, 108, 101,
    116, 32, 120, 32, 61, 32, 50, 32,
    42, 32, 40, 51, 32, 43, 32, 52,
    41, 59, 10, 114, 101, 116, 117, 114,
    110, 32, 120, 32, 43, 32, 109, 97,
    120, 40, 120, 44, 32, 49, 41, 59,
    10, 125, 10, 0, 0, 0, 0, 0,
];
table src count 160 { slot { b : u32 in 0 .. 255, } }
static mut srclen : u32 in 0 .. 160 = 0;
impl fn fill_rec(k : u32 in 0 .. 159, fuel : u32 in 0 .. 160)
    effects { reads src.slots, writes src.slots }
    decreases fuel
{
    narrow fuel to 1 .. 160 else { return; }
    if k == SRCLEN { return; }
    let v = TEXT[k];
    src.slots[k].b = v;
    narrow k to 0 .. 158 else { return; }
    fill_rec(k + 1, fuel - 1);
}
impl fn fill()
    effects { reads src.slots, writes src.slots, writes srclen }
{
    fill_rec(0, 160);
    srclen = SRCLEN;
}
impl fn byte_at(i : u32 in 0 .. 159) -> u32 in 0 .. 255
    effects { reads src.slots }
{
    return src.slots[i].b;
}
impl fn src_len() -> u32 in 0 .. 160
    effects { reads srclen }
{
    return srclen;
}
}
