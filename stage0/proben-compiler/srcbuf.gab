// (a) Source buffer: the fixed program text under test lives in a byte
// table. There is no file input in a probe, so `main` fills the table from
// an embedded constant and every later stage reads through `byte_at`.
// The text exercises every form the lexer and parser implement:
//
//   fn max(a, b) {
//   /* smaller of the two */
//   if a < b { return a; } else { return b; }
//   }
//   // end of max
//   fn main() {
//   let x = 2 * (3 + 4);
//   return x + max(x, 1);
//   }
//
// Each of the four files of this unit is one module (`srcbuf`, `lex`,
// `parse`, `front`); writers are called across modules with qualified
// effect places (e.g. `main` claims `writes srcbuf::src.slots`).
module srcbuf {
// No `while` loop exists: the fill is a `traverse` sweep over the table,
// one pass per slot (`stage0: assignment or call expected`). Indexing the
// constant array with the traverse binder is refused (`constant TEXT:
// constant without G form`), so the body calls a plain `u32` helper for
// the read (entry 2). A `retry` loop was tried first: it unrolls the body
// once per bound unit at compile time (`retryC`), so `bounded 2560 ops`
// on a body with two table accesses takes over eight minutes to compile
// and emits about 41 KB per pass; `traverse` lowers the body once.
// A `string` constant cannot hold the text: string literals have no escape
// for byte 10 and a literal newline is refused (`stage0: lex`), so the text
// stays a constant array, now written with character literals.
const SRCLEN : u32 in 0 .. 160 = 155;
const TEXT : [u32 in 0 .. 255; 160] = [
    'f', 'n', ' ', 'm', 'a', 'x', '(', 'a',
    ',', ' ', 'b', ')', ' ', '{', '\n', '/',
    '*', ' ', 's', 'm', 'a', 'l', 'l', 'e',
    'r', ' ', 'o', 'f', ' ', 't', 'h', 'e',
    ' ', 't', 'w', 'o', ' ', '*', '/', '\n',
    'i', 'f', ' ', 'a', ' ', '<', ' ', 'b',
    ' ', '{', ' ', 'r', 'e', 't', 'u', 'r',
    'n', ' ', 'a', ';', ' ', '}', ' ', 'e',
    'l', 's', 'e', ' ', '{', ' ', 'r', 'e',
    't', 'u', 'r', 'n', ' ', 'b', ';', ' ',
    '}', '\n', '}', '\n', '/', '/', ' ', 'e',
    'n', 'd', ' ', 'o', 'f', ' ', 'm', 'a',
    'x', '\n', 'f', 'n', ' ', 'm', 'a', 'i',
    'n', '(', ')', ' ', '{', '\n', 'l', 'e',
    't', ' ', 'x', ' ', '=', ' ', '2', ' ',
    '*', ' ', '(', '3', ' ', '+', ' ', '4',
    ')', ';', '\n', 'r', 'e', 't', 'u', 'r',
    'n', ' ', 'x', ' ', '+', ' ', 'm', 'a',
    'x', '(', 'x', ',', ' ', '1', ')', ';',
    '\n', '}', '\n', 0, 0, 0, 0, 0,
];
table src count 160 { slot { b : u32 in 0 .. 255, } }
static mut srclen : u32 in 0 .. 160 = 0;
impl fn text_at(j : u32 in 0 .. 159) -> u32 in 0 .. 255
    effects { pure }
{
    return TEXT[j];
}
impl fn fill()
    effects { reads src.slots, writes src.slots, writes srclen }
{
    traverse i over slots of src by unvisited touches reads src.slots, writes src.slots {
        if i < SRCLEN {
            let v = text_at(i);
            src.slots[i].b = v;
        }
    }
    srclen = SRCLEN;
}
impl fn byte_at(i : u32 in 0 .. 159) -> u32 in 0 .. 255
    effects { reads src.slots }
{
    return src.slots[i].b;
}
impl fn src_len() -> u32 in 0 .. 160
    effects { reads srclen }
{
    return srclen;
}
}
