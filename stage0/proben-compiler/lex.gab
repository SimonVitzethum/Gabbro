// (b) Lexer: bytes become a token table. Tokens are kind plus start plus
// length; the kind codes are 0 End, 1 Ident, 2 Int, 3 Fn, 4 Let, 5 If,
// 6 Else, 7 Return, 8 Plus, 9 Minus, 10 Star, 11 Slash, 12 Lparen,
// 13 Rparen, 14 Lbrace, 15 Rbrace, 16 Comma, 17 Semi, 18 Lt, 19 Gt, 20 Eq,
// 21 EqEq, 22 Bang, 23 BangEq, 24 Le, 25 Ge. White space and both comment
// forms are skipped; an unterminated block comment sets `lex_err`.
module lex {
// The classifier uses character literals; the scan is recursion with fuel
// plus `decreases` (no `while` exists) and hand-written per-keyword byte
// checks. In-branch `return f(...)` compiles for plain arguments; a call
// whose argument projects a record field still needs `let q = f(...);
// return q;` (`stage0: value without G form`).
type TOut = { kind : u32 in 0 .. 31, start : u32 in 0 .. 159, len : u32 in 0 .. 159, pos : u32 in 0 .. 160, };
table toks count 64 { slot { k : u32 in 0 .. 31, start : u32 in 0 .. 159, len : u32 in 0 .. 159, } }
static mut tok_used : u32 in 0 .. 64 = 0;
static mut lex_err : bool = false;
impl fn is_alpha(b : u32 in 0 .. 255) -> bool
    effects { pure }
{
    if b >= 'A' { if b <= 'Z' { return true; } }
    if b >= 'a' { if b <= 'z' { return true; } }
    if b == '_' { return true; }
    return false;
}
impl fn is_digit(b : u32 in 0 .. 255) -> bool
    effects { pure }
{
    if b >= '0' { if b <= '9' { return true; } }
    return false;
}
impl fn kw_kind(start : u32 in 0 .. 159, len : u32 in 0 .. 159) -> u32 in 0 .. 31
    effects { pure }
{
    narrow start to 0 .. 153 else { return 1; }
    let b0 = srcbuf::byte_at(start);
    if len == 2 {
        let b1 = srcbuf::byte_at(start + 1);
        if b0 == 'f' { if b1 == 'n' { return 3; } }
        if b0 == 'i' { if b1 == 'f' { return 5; } }
        return 1;
    }
    if len == 3 {
        let b1 = srcbuf::byte_at(start + 1);
        let b2 = srcbuf::byte_at(start + 2);
        if b0 == 'l' { if b1 == 'e' { if b2 == 't' { return 4; } } }
        return 1;
    }
    if len == 4 {
        let b1 = srcbuf::byte_at(start + 1);
        let b2 = srcbuf::byte_at(start + 2);
        let b3 = srcbuf::byte_at(start + 3);
        if b0 == 'e' { if b1 == 'l' { if b2 == 's' { if b3 == 'e' { return 6; } } } }
        return 1;
    }
    if len == 6 {
        let b1 = srcbuf::byte_at(start + 1);
        let b2 = srcbuf::byte_at(start + 2);
        let b3 = srcbuf::byte_at(start + 3);
        let b4 = srcbuf::byte_at(start + 4);
        let b5 = srcbuf::byte_at(start + 5);
        if b0 == 'r' { if b1 == 'e' { if b2 == 't' { if b3 == 'u' { if b4 == 'r' { if b5 == 'n' { return 7; } } } } } }
        return 1;
    }
    return 1;
}
impl fn skip_ws(pos : u32 in 0 .. 160, fuel : u32 in 0 .. 160) -> u32 in 0 .. 160
    effects { writes lex_err }
    decreases fuel
{
    narrow fuel to 1 .. 160 else { lex_err = true; return pos; }
    let n = srcbuf::src_len();
    if pos == n { return pos; }
    narrow pos to 0 .. 159 else { return n; }
    let b = srcbuf::byte_at(pos);
    if b == ' ' { return skip_ws(pos + 1, fuel - 1); }
    if b == '\n' { return skip_ws(pos + 1, fuel - 1); }
    if b == '\t' { return skip_ws(pos + 1, fuel - 1); }
    if b == '/' {
        narrow pos to 0 .. 158 else { return n; }
        let c = srcbuf::byte_at(pos + 1);
        if c == '/' { return skip_line(pos + 2, fuel - 1); }
        if c == '*' {
            let q = skip_block(pos + 2, 1, fuel - 1);
            return skip_ws(q, fuel - 1);
        }
        return pos;
    }
    return pos;
}
impl fn skip_line(pos : u32 in 0 .. 160, fuel : u32 in 0 .. 160) -> u32 in 0 .. 160
    effects { writes lex_err }
    decreases fuel
{
    narrow fuel to 1 .. 160 else { lex_err = true; return pos; }
    let n = srcbuf::src_len();
    if pos == n { return pos; }
    narrow pos to 0 .. 159 else { return n; }
    let b = srcbuf::byte_at(pos);
    if b == '\n' { return skip_ws(pos + 1, fuel - 1); }
    return skip_line(pos + 1, fuel - 1);
}
impl fn skip_block(pos : u32 in 0 .. 160, depth : u32 in 0 .. 8, fuel : u32 in 0 .. 160) -> u32 in 0 .. 160
    effects { writes lex_err }
    decreases fuel
{
    narrow fuel to 1 .. 160 else { lex_err = true; return pos; }
    let n = srcbuf::src_len();
    if pos == n { lex_err = true; return pos; }
    narrow pos to 0 .. 158 else { lex_err = true; return n; }
    narrow depth to 1 .. 8 else { lex_err = true; return n; }
    let b = srcbuf::byte_at(pos);
    if b == '*' {
        let c = srcbuf::byte_at(pos + 1);
        if c == '/' {
            if depth == 1 { return pos + 2; }
            narrow depth to 2 .. 8 else { lex_err = true; return n; }
            return skip_block(pos + 2, depth - 1, fuel - 1);
        }
        return skip_block(pos + 1, depth, fuel - 1);
    }
    if b == '/' {
        let c = srcbuf::byte_at(pos + 1);
        if c == '*' {
            narrow depth to 0 .. 7 else { lex_err = true; return n; }
            return skip_block(pos + 2, depth + 1, fuel - 1);
        }
        return skip_block(pos + 1, depth, fuel - 1);
    }
    return skip_block(pos + 1, depth, fuel - 1);
}
impl fn scan_span(start : u32 in 0 .. 159, pos : u32 in 0 .. 160, len : u32 in 0 .. 159, plain : u32 in 0 .. 1, fuel : u32 in 0 .. 160) -> TOut
    effects { writes lex_err }
    decreases fuel
{
    narrow fuel to 1 .. 160 else { lex_err = true; return TOut(kind: 0, start: 0, len: 0, pos: pos); }
    let n = srcbuf::src_len();
    if pos == n {
        if plain == 1 {
            let k = kw_kind(start, len);
            return TOut(kind: k, start: start, len: len, pos: pos);
        }
        return TOut(kind: 2, start: start, len: len, pos: pos);
    }
    narrow pos to 0 .. 159 else { lex_err = true; return TOut(kind: 0, start: 0, len: 0, pos: n); }
    let b = srcbuf::byte_at(pos);
    if is_alpha(b) {
        narrow len to 0 .. 158 else { lex_err = true; return TOut(kind: 0, start: 0, len: 0, pos: pos); }
        return scan_span(start, pos + 1, len + 1, plain, fuel - 1);
    }
    if is_digit(b) {
        narrow len to 0 .. 158 else { lex_err = true; return TOut(kind: 0, start: 0, len: 0, pos: pos); }
        return scan_span(start, pos + 1, len + 1, plain, fuel - 1);
    }
    if plain == 1 {
        let k = kw_kind(start, len);
        return TOut(kind: k, start: start, len: len, pos: pos);
    }
    return TOut(kind: 2, start: start, len: len, pos: pos);
}
impl fn next_tok(pos : u32 in 0 .. 160, fuel : u32 in 0 .. 160) -> TOut
    effects { writes lex_err }
    decreases fuel
{
    narrow fuel to 1 .. 160 else { lex_err = true; return TOut(kind: 0, start: 0, len: 0, pos: pos); }
    let p = skip_ws(pos, fuel - 1);
    let n = srcbuf::src_len();
    if p == n { return TOut(kind: 0, start: 0, len: 0, pos: p); }
    narrow p to 0 .. 158 else { lex_err = true; return TOut(kind: 0, start: 0, len: 0, pos: n); }
    let b = srcbuf::byte_at(p);
    if b == '(' { return TOut(kind: 12, start: p, len: 1, pos: p + 1); }
    if b == ')' { return TOut(kind: 13, start: p, len: 1, pos: p + 1); }
    if b == '{' { return TOut(kind: 14, start: p, len: 1, pos: p + 1); }
    if b == '}' { return TOut(kind: 15, start: p, len: 1, pos: p + 1); }
    if b == ',' { return TOut(kind: 16, start: p, len: 1, pos: p + 1); }
    if b == ';' { return TOut(kind: 17, start: p, len: 1, pos: p + 1); }
    if b == '+' { return TOut(kind: 8, start: p, len: 1, pos: p + 1); }
    if b == '-' { return TOut(kind: 9, start: p, len: 1, pos: p + 1); }
    if b == '*' { return TOut(kind: 10, start: p, len: 1, pos: p + 1); }
    if b == '/' { return TOut(kind: 11, start: p, len: 1, pos: p + 1); }
    if b == '<' {
        let c = srcbuf::byte_at(p + 1);
        if c == '=' { return TOut(kind: 24, start: p, len: 2, pos: p + 2); }
        return TOut(kind: 18, start: p, len: 1, pos: p + 1);
    }
    if b == '>' {
        let c = srcbuf::byte_at(p + 1);
        if c == '=' { return TOut(kind: 25, start: p, len: 2, pos: p + 2); }
        return TOut(kind: 19, start: p, len: 1, pos: p + 1);
    }
    if b == '=' {
        let c = srcbuf::byte_at(p + 1);
        if c == '=' { return TOut(kind: 21, start: p, len: 2, pos: p + 2); }
        return TOut(kind: 20, start: p, len: 1, pos: p + 1);
    }
    if b == '!' {
        let c = srcbuf::byte_at(p + 1);
        if c == '=' { return TOut(kind: 23, start: p, len: 2, pos: p + 2); }
        return TOut(kind: 22, start: p, len: 1, pos: p + 1);
    }
    if is_alpha(b) { return scan_span(p, p + 1, 1, 1, fuel - 1); }
    if is_digit(b) { return scan_span(p, p + 1, 1, 0, fuel - 1); }
    lex_err = true;
    return TOut(kind: 0, start: 0, len: 0, pos: p);
}
impl fn emit(kind : u32 in 0 .. 31, start : u32 in 0 .. 159, len : u32 in 0 .. 159) -> u32 in 0 .. 64
    effects { reads tok_used, writes tok_used, writes toks.slots, writes lex_err }
{
    let i = tok_used;
    narrow i to 0 .. 63 else { lex_err = true; return 64; }
    toks.slots[i].k = kind;
    toks.slots[i].start = start;
    toks.slots[i].len = len;
    tok_used = i + 1;
    return i;
}
impl fn lex_all(pos : u32 in 0 .. 160, fuel : u32 in 0 .. 160)
    effects { writes tok_used, writes toks.slots, writes lex_err }
    decreases fuel
{
    narrow fuel to 1 .. 160 else { lex_err = true; return; }
    let t = next_tok(pos, fuel - 1);
    if t.kind == 0 {
        if lex_err { return; }
        let e = emit(0, 0, 0);
        if e == 64 { return; }
        return;
    }
    let e = emit(t.kind, t.start, t.len);
    if e == 64 { return; }
    if lex_err { return; }
    lex_all(t.pos, fuel - 1);
}
impl fn lex_failed() -> bool
    effects { reads lex_err }
{
    return lex_err;
}
impl fn tok_count() -> u32 in 0 .. 64
    effects { reads tok_used }
{
    return tok_used;
}
impl fn tok_kind(i : u32 in 0 .. 63) -> u32 in 0 .. 31
    effects { reads toks.slots }
{
    return toks.slots[i].k;
}
impl fn tok_start(i : u32 in 0 .. 63) -> u32 in 0 .. 159
    effects { reads toks.slots }
{
    return toks.slots[i].start;
}
impl fn tok_len(i : u32 in 0 .. 63) -> u32 in 0 .. 159
    effects { reads toks.slots }
{
    return toks.slots[i].len;
}
}
