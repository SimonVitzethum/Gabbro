// (c) Recursive-descent parser with precedence. Levels: comparison,
// addition, multiplication, unary, primary (numbers, names, calls,
// parentheses). Statements are `let`, `if`/`else` (with `else if`),
// `return`; a function holds a name, parameters and a block. Every node
// goes into the `nodes` table; child links are indexes, 255 means none.
// Node kinds: 0 Num, 1 Name, 2 Add, 3 Sub, 4 Mul, 5 Div, 6 Lt, 7 Eq,
// 8 Call, 9 Let, 10 If, 11 Return, 12 Seq, 13 Fn, 14 Arg, 15 Gt, 16 Le,
// 17 Ge, 18 Ne, 19 Param, 20 Sig (a function head: params plus body).
module parse {
// Every function carries an explicit fuel parameter with `decreases` (kept
// for cycle consistency even where the body no longer recurses: a call
// cycle with differing `decreases` tuples is refused); cursor loops are
// `traverse` sweeps over the token table with a plain `u32` cursor plus
// done flag (no `while` exists). The sweep visits every slot once in index
// order; only the visit with `i` equal to the cursor does work and `leave`
// ends the sweep early. Cursors only move forward, so every cursor value
// meets its visit. Chain-building loops (`parse_block`, `parse_unit`,
// `parse_args`, `parse_params`, `else if`) allocate nodes with a placeholder
// tail and patch the previous tail, since the rest must be known first.
// A bare `return` of the recursive call from a branch is `let`-bound only
// where a call argument projects a record field (see lex.gab). The parser
// result is the `POut` record with a `bool` flag (tuples are refused:
// `stage0: ( without )`). Dispatch stays `if` chains over the u32 kind
// codes: `match` arms need names (`stage0: name expected`), so a wildcard
// covers only tagged values. `narrow` on a record field or table slot is
// refused (`stage0: stmt without G form: trim`); the field is bound to a
// local first. Ordering facts do not travel through nested `if`s or past a
// `mut` assignment inside a loop body, so every bounded operation repeats
// its own guard directly at its use.
type POut = { node : u32 in 0 .. 255, pos : u32 in 0 .. 64, ok : bool, };
table nodes count 96 { slot { k : u32 in 0 .. 31, a : u32 in 0 .. 100000, b : u32 in 0 .. 255, c : u32 in 0 .. 255, } }
static mut node_used : u32 in 0 .. 96 = 0;
static mut parse_err : bool = false;
impl fn span_value_rec(start : u32 in 0 .. 159, k : u32 in 0 .. 159, acc : u32 in 0 .. 100000, fuel : u32 in 0 .. 128) -> u32 in 0 .. 100000
    effects { writes parse_err }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return acc; }
    let mut s : u32 in 0 .. 159 = start;
    let mut a : u32 in 0 .. 100000 = acc;
    let mut kn : u32 in 0 .. 159 = k;
    traverse i over slots of srcbuf::src by unvisited touches reads srcbuf::src.slots, writes parse_err {
        if i == s {
            if kn == 0 { return a; }
            let b = srcbuf::byte_at(s);
            narrow b to '0' .. '9' else { parse_err = true; return 0; }
            let d = b - '0';
            let ac = a;
            narrow ac to 0 .. 10000 else { parse_err = true; return 0; }
            let m = ac * 10;
            let v = m + d;
            narrow v to 0 .. 100000 else { parse_err = true; return 0; }
            a = v;
            if s < 159 { s = s + 1; }
            else { parse_err = true; return 0; }
            if kn >= 1 { kn = kn - 1; }
        }
    }
    parse_err = true;
    return 0;
}
impl fn new_node(kind : u32 in 0 .. 31, a : u32 in 0 .. 100000, b : u32 in 0 .. 255, c : u32 in 0 .. 255) -> u32 in 0 .. 95
    effects { reads node_used, writes node_used, writes nodes.slots, writes parse_err }
{
    let i = node_used;
    narrow i to 0 .. 95 else { parse_err = true; return 0; }
    nodes.slots[i].k = kind;
    nodes.slots[i].a = a;
    nodes.slots[i].b = b;
    nodes.slots[i].c = c;
    node_used = i + 1;
    return i;
}
impl fn parse_primary(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    narrow ti to 0 .. 63 else { return POut(node: 0, pos: ti, ok: false); }
    let k = lex::tok_kind(ti);
    if k == 2 {
        let s = lex::tok_start(ti);
        let l = lex::tok_len(ti);
        let v = span_value_rec(s, l, 0, fuel - 1);
        if parse_err { return POut(node: 0, pos: ti, ok: false); }
        let nd = new_node(0, v, 0, 0);
        return POut(node: nd, pos: ti + 1, ok: true);
    }
    if k == 1 {
        let s = lex::tok_start(ti);
        let l = lex::tok_len(ti);
        narrow ti to 0 .. 62 else { return POut(node: 0, pos: ti, ok: false); }
        let k2 = lex::tok_kind(ti + 1);
        if k2 == 12 {
            let a = parse_args(ti + 2, fuel - 1);
            if !a.ok { return POut(node: 0, pos: ti, ok: false); }
            let nd = new_node(8, s, l, a.node);
            return POut(node: nd, pos: a.pos, ok: true);
        }
        let nd = new_node(1, s, l, 0);
        return POut(node: nd, pos: ti + 1, ok: true);
    }
    if k == 12 {
        let e = parse_expr(ti + 1, fuel - 1);
        if !e.ok { return POut(node: 0, pos: ti, ok: false); }
        let ep = e.pos;
        narrow ep to 0 .. 63 else { return POut(node: 0, pos: ti, ok: false); }
        let k2 = lex::tok_kind(ep);
        if k2 == 13 {
            return POut(node: e.node, pos: ep + 1, ok: true);
        }
        return POut(node: 0, pos: ti, ok: false);
    }
    return POut(node: 0, pos: ti, ok: false);
}
impl fn parse_unary(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    narrow ti to 0 .. 63 else { return POut(node: 0, pos: ti, ok: false); }
    let k = lex::tok_kind(ti);
    if k == 9 {
        let e = parse_unary(ti + 1, fuel - 1);
        if !e.ok { return POut(node: 0, pos: ti, ok: false); }
        let z = new_node(0, 0, 0, 0);
        let nd = new_node(3, z, e.node, 0);
        return POut(node: nd, pos: e.pos, ok: true);
    }
    return parse_primary(ti, fuel - 1);
}
impl fn parse_mul_rest(left : u32 in 0 .. 255, ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: left, pos: ti, ok: false); }
    if ti == 64 { return POut(node: left, pos: ti, ok: true); }
    let mut l : u32 in 0 .. 255 = left;
    let mut p : u32 in 0 .. 64 = ti;
    let mut fp : u32 in 0 .. 64 = ti;
    let mut ok : bool = true;
    let mut done : bool = false;
    traverse i over slots of lex::toks by unvisited touches reads lex::toks.slots, writes nodes.slots, writes node_used, writes parse_err {
        if done { leave i; }
        if i == p {
            if p < 64 {
                let k = lex::tok_kind(p);
                if k == 10 {
                    if p < 64 {
                        let r = parse_unary(p + 1, fuel - 1);
                        if !r.ok { ok = false; fp = p; done = true; }
                        else {
                            let nn = new_node(4, l, r.node, 0);
                            l = nn;
                            p = r.pos;
                        }
                    }
                }
                else {
                    if k == 11 {
                        if p < 64 {
                            let r = parse_unary(p + 1, fuel - 1);
                            if !r.ok { ok = false; fp = p; done = true; }
                            else {
                                let nn = new_node(5, l, r.node, 0);
                                l = nn;
                                p = r.pos;
                            }
                        }
                    }
                    else { done = true; }
                }
            }
            else { done = true; }
        }
    }
    if !ok { return POut(node: 0, pos: fp, ok: false); }
    return POut(node: l, pos: p, ok: true);
}
impl fn parse_mul(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    let l = parse_unary(ti, fuel - 1);
    if !l.ok { return POut(node: 0, pos: ti, ok: false); }
    let q = parse_mul_rest(l.node, l.pos, fuel - 1);
    return q;
}
impl fn parse_add_rest(left : u32 in 0 .. 255, ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: left, pos: ti, ok: false); }
    if ti == 64 { return POut(node: left, pos: ti, ok: true); }
    let mut l : u32 in 0 .. 255 = left;
    let mut p : u32 in 0 .. 64 = ti;
    let mut fp : u32 in 0 .. 64 = ti;
    let mut ok : bool = true;
    let mut done : bool = false;
    traverse i over slots of lex::toks by unvisited touches reads lex::toks.slots, writes nodes.slots, writes node_used, writes parse_err {
        if done { leave i; }
        if i == p {
            if p < 64 {
                let k = lex::tok_kind(p);
                if k == 8 {
                    if p < 64 {
                        let r = parse_mul(p + 1, fuel - 1);
                        if !r.ok { ok = false; fp = p; done = true; }
                        else {
                            let nn = new_node(2, l, r.node, 0);
                            l = nn;
                            p = r.pos;
                        }
                    }
                }
                else {
                    if k == 9 {
                        if p < 64 {
                            let r = parse_mul(p + 1, fuel - 1);
                            if !r.ok { ok = false; fp = p; done = true; }
                            else {
                                let nn = new_node(3, l, r.node, 0);
                                l = nn;
                                p = r.pos;
                            }
                        }
                    }
                    else { done = true; }
                }
            }
            else { done = true; }
        }
    }
    if !ok { return POut(node: 0, pos: fp, ok: false); }
    return POut(node: l, pos: p, ok: true);
}
impl fn parse_add(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    let l = parse_mul(ti, fuel - 1);
    if !l.ok { return POut(node: 0, pos: ti, ok: false); }
    let q = parse_add_rest(l.node, l.pos, fuel - 1);
    return q;
}
impl fn parse_cmp_rest(left : u32 in 0 .. 255, ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: left, pos: ti, ok: false); }
    if ti == 64 { return POut(node: left, pos: ti, ok: true); }
    let mut l : u32 in 0 .. 255 = left;
    let mut p : u32 in 0 .. 64 = ti;
    let mut fp : u32 in 0 .. 64 = ti;
    let mut ok : bool = true;
    let mut done : bool = false;
    traverse i over slots of lex::toks by unvisited touches reads lex::toks.slots, writes nodes.slots, writes node_used, writes parse_err {
        if done { leave i; }
        if i == p {
            if p < 64 {
                let k = lex::tok_kind(p);
                if k == 18 {
                    if p < 64 {
                        let r = parse_add(p + 1, fuel - 1);
                        if !r.ok { ok = false; fp = p; done = true; }
                        else {
                            let nn = new_node(6, l, r.node, 0);
                            l = nn;
                            p = r.pos;
                        }
                    }
                }
                else {
                    if k == 19 {
                        if p < 64 {
                            let r = parse_add(p + 1, fuel - 1);
                            if !r.ok { ok = false; fp = p; done = true; }
                            else {
                                let nn = new_node(15, l, r.node, 0);
                                l = nn;
                                p = r.pos;
                            }
                        }
                    }
                    else {
                        if k == 21 {
                            if p < 64 {
                                let r = parse_add(p + 1, fuel - 1);
                                if !r.ok { ok = false; fp = p; done = true; }
                                else {
                                    let nn = new_node(7, l, r.node, 0);
                                    l = nn;
                                    p = r.pos;
                                }
                            }
                        }
                        else {
                            if k == 23 {
                                if p < 64 {
                                    let r = parse_add(p + 1, fuel - 1);
                                    if !r.ok { ok = false; fp = p; done = true; }
                                    else {
                                        let nn = new_node(18, l, r.node, 0);
                                        l = nn;
                                        p = r.pos;
                                    }
                                }
                            }
                            else {
                                if k == 24 {
                                    if p < 64 {
                                        let r = parse_add(p + 1, fuel - 1);
                                        if !r.ok { ok = false; fp = p; done = true; }
                                        else {
                                            let nn = new_node(16, l, r.node, 0);
                                            l = nn;
                                            p = r.pos;
                                        }
                                    }
                                }
                                else {
                                    if k == 25 {
                                        if p < 64 {
                                            let r = parse_add(p + 1, fuel - 1);
                                            if !r.ok { ok = false; fp = p; done = true; }
                                            else {
                                                let nn = new_node(17, l, r.node, 0);
                                                l = nn;
                                                p = r.pos;
                                            }
                                        }
                                    }
                                    else { done = true; }
                                }
                            }
                        }
                    }
                }
            }
            else { done = true; }
        }
    }
    if !ok { return POut(node: 0, pos: fp, ok: false); }
    return POut(node: l, pos: p, ok: true);
}
impl fn parse_cmp(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    let l = parse_add(ti, fuel - 1);
    if !l.ok { return POut(node: 0, pos: ti, ok: false); }
    let q = parse_cmp_rest(l.node, l.pos, fuel - 1);
    return q;
}
impl fn parse_expr(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    return parse_cmp(ti, fuel - 1);
}
impl fn parse_args(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    if ti == 64 { return POut(node: 0, pos: ti, ok: false); }
    let mut p : u32 in 0 .. 64 = ti;
    let mut root : u32 in 0 .. 255 = 255;
    let mut prev : u32 in 0 .. 255 = 255;
    traverse i over slots of lex::toks by unvisited touches reads lex::toks.slots, writes nodes.slots, writes node_used, writes parse_err {
        if i == p {
            if p < 64 {
                let pp : u32 in 0 .. 63 = p;
                let k = lex::tok_kind(pp);
                if k == 13 {
                    return POut(node: root, pos: pp + 1, ok: true);
                }
                let e = parse_expr(pp, fuel - 1);
                if !e.ok { return POut(node: 0, pos: pp, ok: false); }
                let ep : u32 in 0 .. 64 = e.pos;
                if ep == 64 { return POut(node: 0, pos: pp, ok: false); }
                else {
                    if ep < 64 {
                        let k2 = lex::tok_kind(ep);
                        if k2 == 16 {
                            let nn = new_node(14, e.node, 255, 0);
                            if root == 255 { root = nn; }
                            else {
                                let pv = prev;
                                narrow pv to 0 .. 95 else { parse_err = true; return POut(node: 0, pos: pp, ok: false); }
                                nodes.slots[pv].b = nn;
                            }
                            prev = nn;
                            if ep < 64 { p = ep + 1; }
                        }
                        else {
                            if k2 == 13 {
                                let mm = new_node(14, e.node, 255, 0);
                                if root == 255 { root = mm; }
                                else {
                                    let pw = prev;
                                    narrow pw to 0 .. 95 else { parse_err = true; return POut(node: 0, pos: pp, ok: false); }
                                    nodes.slots[pw].b = mm;
                                }
                                if ep < 64 {
                                    return POut(node: root, pos: ep + 1, ok: true);
                                }
                                return POut(node: 0, pos: pp, ok: false);
                            }
                            return POut(node: 0, pos: pp, ok: false);
                        }
                    }
                    else { return POut(node: 0, pos: pp, ok: false); }
                }
            }
        }
    }
    return POut(node: 0, pos: p, ok: false);
}
impl fn parse_params(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    if ti == 64 { return POut(node: 0, pos: ti, ok: false); }
    let mut p : u32 in 0 .. 64 = ti;
    let mut root : u32 in 0 .. 255 = 255;
    let mut prev : u32 in 0 .. 255 = 255;
    traverse i over slots of lex::toks by unvisited touches reads lex::toks.slots, writes nodes.slots, writes node_used, writes parse_err {
        if i == p {
            if p < 64 {
                let pp : u32 in 0 .. 63 = p;
                let k = lex::tok_kind(pp);
                if k == 13 {
                    return POut(node: root, pos: pp + 1, ok: true);
                }
                if k == 1 {
                    let s = lex::tok_start(pp);
                    let l = lex::tok_len(pp);
                    if pp < 63 {
                        let k2 = lex::tok_kind(pp + 1);
                        if k2 == 16 {
                            let nn = new_node(19, s, l, 255);
                            if root == 255 { root = nn; }
                            else {
                                let pv = prev;
                                narrow pv to 0 .. 95 else { parse_err = true; return POut(node: 0, pos: pp, ok: false); }
                                nodes.slots[pv].c = nn;
                            }
                            prev = nn;
                            if pp < 63 { p = pp + 2; }
                        }
                        else {
                            if k2 == 13 {
                                let mm = new_node(19, s, l, 255);
                                if root == 255 { root = mm; }
                                else {
                                    let pw = prev;
                                    narrow pw to 0 .. 95 else { parse_err = true; return POut(node: 0, pos: pp, ok: false); }
                                    nodes.slots[pw].c = mm;
                                }
                                if pp < 63 {
                                    return POut(node: root, pos: pp + 2, ok: true);
                                }
                                return POut(node: 0, pos: pp, ok: false);
                            }
                            return POut(node: 0, pos: pp, ok: false);
                        }
                    }
                    else { return POut(node: 0, pos: pp, ok: false); }
                }
                else { return POut(node: 0, pos: pp, ok: false); }
            }
        }
    }
    return POut(node: 0, pos: p, ok: false);
}
impl fn parse_stmt(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    narrow ti to 0 .. 63 else { return POut(node: 0, pos: ti, ok: false); }
    let k = lex::tok_kind(ti);
    if k == 15 {
        return POut(node: 255, pos: ti, ok: true);
    }
    if k == 4 {
        narrow ti to 0 .. 61 else { return POut(node: 0, pos: ti, ok: false); }
        let k2 = lex::tok_kind(ti + 1);
        if k2 == 1 {
            let s = lex::tok_start(ti + 1);
            let l = lex::tok_len(ti + 1);
            let k3 = lex::tok_kind(ti + 2);
            if k3 == 20 {
                let e = parse_expr(ti + 3, fuel - 1);
                if !e.ok { return POut(node: 0, pos: ti, ok: false); }
                let ep = e.pos;
                narrow ep to 0 .. 63 else { return POut(node: 0, pos: ti, ok: false); }
                let k4 = lex::tok_kind(ep);
                if k4 == 17 {
                    let nd = new_node(9, s, l, e.node);
                    return POut(node: nd, pos: ep + 1, ok: true);
                }
                return POut(node: 0, pos: ti, ok: false);
            }
            return POut(node: 0, pos: ti, ok: false);
        }
        return POut(node: 0, pos: ti, ok: false);
    }
    if k == 5 {
        let e = parse_expr(ti + 1, fuel - 1);
        if !e.ok { return POut(node: 0, pos: ti, ok: false); }
        let ep = e.pos;
        narrow ep to 0 .. 63 else { return POut(node: 0, pos: ti, ok: false); }
        let k2 = lex::tok_kind(ep);
        if k2 == 14 {
            let th = parse_block(ep + 1, fuel - 1);
            if !th.ok { return POut(node: 0, pos: ti, ok: false); }
            let tp = th.pos;
            narrow tp to 0 .. 63 else { return POut(node: 0, pos: ti, ok: false); }
            let k3 = lex::tok_kind(tp);
            if k3 == 6 {
                narrow tp to 0 .. 62 else { return POut(node: 0, pos: ti, ok: false); }
                let k4 = lex::tok_kind(tp + 1);
                if k4 == 5 {
                    let ei = parse_stmt_else(tp + 1, fuel - 1);
                    if !ei.ok { return POut(node: 0, pos: ti, ok: false); }
                    let nd = new_node(10, e.node, th.node, ei.node);
                    return POut(node: nd, pos: ei.pos, ok: true);
                }
                let eb = parse_else_block(tp + 1, fuel - 1);
                if !eb.ok { return POut(node: 0, pos: ti, ok: false); }
                let nd = new_node(10, e.node, th.node, eb.node);
                return POut(node: nd, pos: eb.pos, ok: true);
            }
            let nd = new_node(10, e.node, th.node, 255);
            return POut(node: nd, pos: tp, ok: true);
        }
        return POut(node: 0, pos: ti, ok: false);
    }
    if k == 7 {
        let e = parse_expr(ti + 1, fuel - 1);
        if !e.ok { return POut(node: 0, pos: ti, ok: false); }
        let rp = e.pos;
        narrow rp to 0 .. 63 else { return POut(node: 0, pos: ti, ok: false); }
        let k2 = lex::tok_kind(rp);
        if k2 == 17 {
            let nd = new_node(11, e.node, 0, 0);
            return POut(node: nd, pos: rp + 1, ok: true);
        }
        return POut(node: 0, pos: ti, ok: false);
    }
    return POut(node: 0, pos: ti, ok: false);
}
impl fn parse_stmt_else(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    if ti == 64 { return POut(node: 0, pos: ti, ok: false); }
    let mut tp : u32 in 0 .. 64 = ti;
    let mut root : u32 in 0 .. 255 = 255;
    let mut prev : u32 in 0 .. 255 = 255;
    traverse i over slots of lex::toks by unvisited touches reads lex::toks.slots, writes nodes.slots, writes node_used, writes parse_err {
        if i == tp {
            if tp < 64 {
                let pp : u32 in 0 .. 63 = tp;
                let e = parse_expr(pp + 1, fuel - 1);
                if !e.ok { return POut(node: 0, pos: pp, ok: false); }
                let ep : u32 in 0 .. 64 = e.pos;
                if ep == 64 { return POut(node: 0, pos: pp, ok: false); }
                else {
                    if ep < 64 {
                        let k = lex::tok_kind(ep);
                        if k == 14 {
                            if ep < 64 {
                                let th = parse_block(ep + 1, fuel - 1);
                                if !th.ok { return POut(node: 0, pos: pp, ok: false); }
                                let tpp : u32 in 0 .. 64 = th.pos;
                                if tpp == 64 { return POut(node: 0, pos: pp, ok: false); }
                                else {
                                    if tpp < 64 {
                                        let nn = new_node(10, e.node, th.node, 255);
                                        if root == 255 { root = nn; }
                                        else {
                                            let pv = prev;
                                            narrow pv to 0 .. 95 else { parse_err = true; return POut(node: 0, pos: pp, ok: false); }
                                            nodes.slots[pv].c = nn;
                                        }
                                        prev = nn;
                                        let k3 = lex::tok_kind(tpp);
                                        if k3 == 6 {
                                            if tpp < 63 {
                                                let k4 = lex::tok_kind(tpp + 1);
                                                if k4 == 5 {
                                                    if tpp < 64 { tp = tpp + 1; }
                                                }
                                                else {
                                                    if tpp < 64 {
                                                        let eb = parse_else_block(tpp + 1, fuel - 1);
                                                        if !eb.ok { return POut(node: 0, pos: pp, ok: false); }
                                                        let pw = prev;
                                                        narrow pw to 0 .. 95 else { parse_err = true; return POut(node: 0, pos: pp, ok: false); }
                                                        nodes.slots[pw].c = eb.node;
                                                        return POut(node: root, pos: eb.pos, ok: true);
                                                    }
                                                    return POut(node: 0, pos: pp, ok: false);
                                                }
                                            }
                                            else { return POut(node: 0, pos: pp, ok: false); }
                                        }
                                        else {
                                            return POut(node: root, pos: tpp, ok: true);
                                        }
                                    }
                                    else { return POut(node: 0, pos: pp, ok: false); }
                                }
                            }
                        }
                        else { return POut(node: 0, pos: pp, ok: false); }
                    }
                    else { return POut(node: 0, pos: pp, ok: false); }
                }
            }
        }
    }
    return POut(node: 0, pos: tp, ok: false);
}
impl fn parse_else_block(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    narrow ti to 0 .. 63 else { return POut(node: 0, pos: ti, ok: false); }
    let k = lex::tok_kind(ti);
    if k == 14 {
        return parse_block(ti + 1, fuel - 1);
    }
    return POut(node: 0, pos: ti, ok: false);
}
impl fn parse_block(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    let mut p : u32 in 0 .. 64 = ti;
    let mut root : u32 in 0 .. 255 = 255;
    let mut prev : u32 in 0 .. 255 = 255;
    traverse i over slots of lex::toks by unvisited touches reads lex::toks.slots, writes nodes.slots, writes node_used, writes parse_err {
        if i == p {
            if p < 64 {
                let pp : u32 in 0 .. 63 = p;
                let s = parse_stmt(pp, fuel - 1);
                if !s.ok { return POut(node: 0, pos: pp, ok: false); }
                let sp : u32 in 0 .. 64 = s.pos;
                if s.node == 255 {
                    if sp < 64 {
                        return POut(node: root, pos: sp + 1, ok: true);
                    }
                    return POut(node: 0, pos: pp, ok: false);
                }
                let nn = new_node(12, s.node, 255, 0);
                if root == 255 { root = nn; }
                else {
                    let pv = prev;
                    narrow pv to 0 .. 95 else { parse_err = true; return POut(node: 0, pos: pp, ok: false); }
                    nodes.slots[pv].b = nn;
                }
                prev = nn;
                p = sp;
            }
        }
    }
    return POut(node: 0, pos: p, ok: false);
}
impl fn parse_fn(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    narrow ti to 0 .. 61 else { return POut(node: 0, pos: ti, ok: false); }
    let k = lex::tok_kind(ti);
    if k == 3 {
        let k2 = lex::tok_kind(ti + 1);
        if k2 == 1 {
            let s = lex::tok_start(ti + 1);
            let l = lex::tok_len(ti + 1);
            let k3 = lex::tok_kind(ti + 2);
            if k3 == 12 {
                let p = parse_params(ti + 3, fuel - 1);
                if !p.ok { return POut(node: 0, pos: ti, ok: false); }
                let pp = p.pos;
                narrow pp to 0 .. 63 else { return POut(node: 0, pos: ti, ok: false); }
                let k4 = lex::tok_kind(pp);
                if k4 == 14 {
                    let b = parse_block(pp + 1, fuel - 1);
                    if !b.ok { return POut(node: 0, pos: ti, ok: false); }
                    let sg = new_node(20, p.node, b.node, 0);
                    let nd = new_node(13, s, l, sg);
                    return POut(node: nd, pos: b.pos, ok: true);
                }
                return POut(node: 0, pos: ti, ok: false);
            }
            return POut(node: 0, pos: ti, ok: false);
        }
        return POut(node: 0, pos: ti, ok: false);
    }
    return POut(node: 0, pos: ti, ok: false);
}
impl fn parse_unit(ti : u32 in 0 .. 64, fuel : u32 in 0 .. 128) -> POut
    effects { writes parse_err, writes node_used, writes nodes.slots }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { parse_err = true; return POut(node: 0, pos: ti, ok: false); }
    if ti == 64 { return POut(node: 255, pos: ti, ok: false); }
    let mut p : u32 in 0 .. 64 = ti;
    let mut root : u32 in 0 .. 255 = 255;
    let mut prev : u32 in 0 .. 255 = 255;
    traverse i over slots of lex::toks by unvisited touches reads lex::toks.slots, writes nodes.slots, writes node_used, writes parse_err {
        if i == p {
            if p < 64 {
                let pp : u32 in 0 .. 63 = p;
                let k = lex::tok_kind(pp);
                if k == 0 {
                    return POut(node: root, pos: pp + 1, ok: true);
                }
                let f = parse_fn(pp, fuel - 1);
                if !f.ok { return POut(node: 0, pos: pp, ok: false); }
                let fp : u32 in 0 .. 64 = f.pos;
                let nn = new_node(12, f.node, 255, 0);
                if root == 255 { root = nn; }
                else {
                    let pv = prev;
                    narrow pv to 0 .. 95 else { parse_err = true; return POut(node: 0, pos: pp, ok: false); }
                    nodes.slots[pv].b = nn;
                }
                prev = nn;
                p = fp;
            }
        }
    }
    return POut(node: 0, pos: p, ok: false);
}
impl fn parse_failed() -> bool
    effects { reads parse_err }
{
    return parse_err;
}
impl fn node_count() -> u32 in 0 .. 96
    effects { reads node_used }
{
    return node_used;
}
impl fn node_kind(i : u32 in 0 .. 95) -> u32 in 0 .. 31
    effects { reads nodes.slots }
{
    return nodes.slots[i].k;
}
impl fn node_a(i : u32 in 0 .. 95) -> u32 in 0 .. 100000
    effects { reads nodes.slots }
{
    return nodes.slots[i].a;
}
impl fn node_b(i : u32 in 0 .. 95) -> u32 in 0 .. 255
    effects { reads nodes.slots }
{
    return nodes.slots[i].b;
}
impl fn node_c(i : u32 in 0 .. 95) -> u32 in 0 .. 255
    effects { reads nodes.slots }
{
    return nodes.slots[i].c;
}
}
