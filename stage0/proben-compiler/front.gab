// (d) Symbol table with scopes and one checking pass. Scopes nest for
// functions and for `if` branches: entering pushes the symbol count,
// leaving truncates it, so only live scopes are ever searched and the
// innermost declaration wins. The pass reports the first undeclared name
// in `bad_start`/`bad_len` and answers 0. `main` runs the whole front end
// and returns the token count plus the node count, so a correct run is
// visible in the exit code: 255 means the lexer failed, 254 the parser,
// 252 the checker.
module front {
// The scope search is a `traverse` over the symbol table: the body calls the
// comparison, skips dead slots past the live count, and every hit overwrites
// the answer, so the innermost declaration wins. Only live scopes are ever
// searched because the traversal is bounded by `sym_used`.
table syms count 32 { slot { start : u32 in 0 .. 159, len : u32 in 0 .. 159, depth : u32 in 0 .. 8, } }
table scopebase count 8 { slot { base : u32 in 0 .. 32, } }
static mut sym_used : u32 in 0 .. 32 = 0;
static mut cur_depth : u32 in 0 .. 8 = 0;
static mut scope_top : u32 in 0 .. 8 = 0;
static mut bad_start : u32 in 0 .. 159 = 0;
static mut bad_len : u32 in 0 .. 159 = 0;
static mut check_bad : bool = false;
impl fn sym_enter()
    effects { reads scope_top, writes scope_top, reads sym_used, writes scopebase.slots, reads cur_depth, writes cur_depth, writes check_bad }
{
    let t = scope_top;
    narrow t to 0 .. 7 else { check_bad = true; return; }
    let b = sym_used;
    scopebase.slots[t].base = b;
    scope_top = t + 1;
    let d = cur_depth;
    narrow d to 0 .. 7 else { check_bad = true; return; }
    cur_depth = d + 1;
}
impl fn sym_leave()
    effects { reads scope_top, writes scope_top, writes sym_used, reads scopebase.slots, reads cur_depth, writes cur_depth, writes check_bad }
{
    let t = scope_top;
    narrow t to 1 .. 8 else { check_bad = true; return; }
    scope_top = t - 1;
    let s = scope_top;
    narrow s to 0 .. 7 else { check_bad = true; return; }
    let b = scopebase.slots[s].base;
    sym_used = b;
    let d = cur_depth;
    narrow d to 1 .. 8 else { check_bad = true; return; }
    cur_depth = d - 1;
}
impl fn sym_declare(start : u32 in 0 .. 159, len : u32 in 0 .. 159)
    effects { reads sym_used, writes sym_used, writes syms.slots, reads cur_depth, writes check_bad }
{
    let i = sym_used;
    narrow i to 0 .. 31 else { check_bad = true; return; }
    syms.slots[i].start = start;
    syms.slots[i].len = len;
    syms.slots[i].depth = cur_depth;
    sym_used = i + 1;
}
impl fn cmp_rec(s1 : u32 in 0 .. 159, s2 : u32 in 0 .. 159, k : u32 in 0 .. 159, fuel : u32 in 0 .. 160) -> bool
    effects { pure }
    decreases fuel
{
    narrow fuel to 1 .. 160 else { return false; }
    if k == 0 { return true; }
    narrow s1 to 0 .. 158 else { return false; }
    narrow s2 to 0 .. 158 else { return false; }
    let b1 = srcbuf::byte_at(s1);
    let b2 = srcbuf::byte_at(s2);
    if b1 == b2 {
        narrow k to 1 .. 159 else { return false; }
        return cmp_rec(s1 + 1, s2 + 1, k - 1, fuel - 1);
    }
    return false;
}
impl fn cmp_span(s1 : u32 in 0 .. 159, l1 : u32 in 0 .. 159, s2 : u32 in 0 .. 159, l2 : u32 in 0 .. 159) -> bool
    effects { pure }
{
    if l1 == l2 {
        return cmp_rec(s1, s2, l1, 160);
    }
    return false;
}
impl fn sym_lookup(start : u32 in 0 .. 159, len : u32 in 0 .. 159) -> u32 in 0 .. 33
    effects { reads syms.slots, reads sym_used }
{
    let mut found : u32 in 0 .. 33 = 33;
    let u = sym_used;
    traverse i over slots of syms by unvisited touches reads syms.slots {
        if i < u {
            let s = syms.slots[i].start;
            let l = syms.slots[i].len;
            if cmp_span(s, l, start, len) {
                found = i;
            }
        }
    }
    return found;
}
impl fn is_binop(k : u32 in 0 .. 31) -> bool
    effects { pure }
{
    if k == 2 { return true; }
    if k == 3 { return true; }
    if k == 4 { return true; }
    if k == 5 { return true; }
    if k == 6 { return true; }
    if k == 7 { return true; }
    if k == 15 { return true; }
    if k == 16 { return true; }
    if k == 17 { return true; }
    if k == 18 { return true; }
    return false;
}
impl fn check_expr(ni : u32 in 0 .. 95, fuel : u32 in 0 .. 128) -> bool
    effects { reads nodes.slots, writes check_bad, writes bad_start, writes bad_len, writes sym_used, writes syms.slots, writes scopebase.slots, writes cur_depth, writes scope_top }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { check_bad = true; return false; }
    let k = parse::node_kind(ni);
    if k == 0 { return true; }
    if k == 1 {
        let s = parse::node_a(ni);
        narrow s to 0 .. 159 else { check_bad = true; return false; }
        let l = parse::node_b(ni);
        narrow l to 0 .. 159 else { check_bad = true; return false; }
        let f = sym_lookup(s, l);
        if f == 33 {
            bad_start = s;
            bad_len = l;
            check_bad = true;
            return false;
        }
        return true;
    }
    if k == 8 {
        let s = parse::node_a(ni);
        narrow s to 0 .. 159 else { check_bad = true; return false; }
        let l = parse::node_b(ni);
        narrow l to 0 .. 159 else { check_bad = true; return false; }
        let f = sym_lookup(s, l);
        if f == 33 {
            bad_start = s;
            bad_len = l;
            check_bad = true;
            return false;
        }
        let c = parse::node_c(ni);
        return check_args(c, fuel - 1);
    }
    if is_binop(k) {
        let l = parse::node_a(ni);
        narrow l to 0 .. 95 else { check_bad = true; return false; }
        let r = parse::node_b(ni);
        narrow r to 0 .. 95 else { check_bad = true; return false; }
        let q = check_expr(l, fuel - 1);
        if !q { return false; }
        return check_expr(r, fuel - 1);
    }
    check_bad = true;
    return false;
}
impl fn check_args(ai : u32 in 0 .. 255, fuel : u32 in 0 .. 128) -> bool
    effects { reads nodes.slots, writes check_bad, writes bad_start, writes bad_len, writes sym_used, writes syms.slots, writes scopebase.slots, writes cur_depth, writes scope_top }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { check_bad = true; return false; }
    if ai == 255 { return true; }
    narrow ai to 0 .. 95 else { check_bad = true; return false; }
    let k = parse::node_kind(ai);
    if k == 14 {
        let e = parse::node_a(ai);
        narrow e to 0 .. 95 else { check_bad = true; return false; }
        let q = check_expr(e, fuel - 1);
        if !q { return false; }
        let n = parse::node_b(ai);
        return check_args(n, fuel - 1);
    }
    check_bad = true;
    return false;
}
impl fn check_seq(si : u32 in 0 .. 255, fuel : u32 in 0 .. 128) -> bool
    effects { reads nodes.slots, writes check_bad, writes bad_start, writes bad_len, writes sym_used, writes syms.slots, writes scopebase.slots, writes cur_depth, writes scope_top }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { check_bad = true; return false; }
    if si == 255 { return true; }
    narrow si to 0 .. 95 else { check_bad = true; return false; }
    let k = parse::node_kind(si);
    if k == 12 {
        let a = parse::node_a(si);
        narrow a to 0 .. 95 else { check_bad = true; return false; }
        let q = check_stmt(a, fuel - 1);
        if !q { return false; }
        let b = parse::node_b(si);
        return check_seq(b, fuel - 1);
    }
    check_bad = true;
    return false;
}
impl fn declare_params(p : u32 in 0 .. 255, fuel : u32 in 0 .. 128) -> bool
    effects { reads nodes.slots, writes sym_used, writes syms.slots, reads cur_depth, writes check_bad }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { check_bad = true; return false; }
    if p == 255 { return true; }
    narrow p to 0 .. 95 else { check_bad = true; return false; }
    let k = parse::node_kind(p);
    if k == 19 {
        let s = parse::node_a(p);
        narrow s to 0 .. 159 else { check_bad = true; return false; }
        let l = parse::node_b(p);
        narrow l to 0 .. 159 else { check_bad = true; return false; }
        sym_declare(s, l);
        let n = parse::node_c(p);
        return declare_params(n, fuel - 1);
    }
    check_bad = true;
    return false;
}
impl fn check_stmt(ni : u32 in 0 .. 95, fuel : u32 in 0 .. 128) -> bool
    effects { reads nodes.slots, writes check_bad, writes bad_start, writes bad_len, writes sym_used, writes syms.slots, writes scopebase.slots, writes cur_depth, writes scope_top }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { check_bad = true; return false; }
    let k = parse::node_kind(ni);
    if k == 9 {
        let c = parse::node_c(ni);
        narrow c to 0 .. 95 else { check_bad = true; return false; }
        let q = check_expr(c, fuel - 1);
        if !q { return false; }
        let s = parse::node_a(ni);
        narrow s to 0 .. 159 else { check_bad = true; return false; }
        let l = parse::node_b(ni);
        narrow l to 0 .. 159 else { check_bad = true; return false; }
        sym_declare(s, l);
        return true;
    }
    if k == 10 {
        let cd = parse::node_a(ni);
        narrow cd to 0 .. 95 else { check_bad = true; return false; }
        let q = check_expr(cd, fuel - 1);
        if !q { return false; }
        sym_enter();
        let th = parse::node_b(ni);
        let w = check_seq(th, fuel - 1);
        sym_leave();
        if !w { return false; }
        let e = parse::node_c(ni);
        if e == 255 { return true; }
        narrow e to 0 .. 95 else { check_bad = true; return false; }
        let kc = parse::node_kind(e);
        if kc == 10 {
            sym_enter();
            let u = check_stmt(e, fuel - 1);
            sym_leave();
            return u;
        }
        if kc == 12 {
            sym_enter();
            let v = check_seq(e, fuel - 1);
            sym_leave();
            return v;
        }
        check_bad = true;
        return false;
    }
    if k == 11 {
        let r = parse::node_a(ni);
        narrow r to 0 .. 95 else { check_bad = true; return false; }
        return check_expr(r, fuel - 1);
    }
    if k == 12 {
        let a = parse::node_a(ni);
        narrow a to 0 .. 95 else { check_bad = true; return false; }
        let q = check_stmt(a, fuel - 1);
        if !q { return false; }
        let b = parse::node_b(ni);
        return check_seq(b, fuel - 1);
    }
    if k == 13 {
        sym_enter();
        let sg = parse::node_c(ni);
        narrow sg to 0 .. 95 else { check_bad = true; sym_leave(); return false; }
        let p = parse::node_a(sg);
        narrow p to 0 .. 255 else { check_bad = true; sym_leave(); return false; }
        let d = declare_params(p, fuel - 1);
        if !d { sym_leave(); return false; }
        let bd = parse::node_b(sg);
        let w = check_seq(bd, fuel - 1);
        sym_leave();
        return w;
    }
    check_bad = true;
    return false;
}
impl fn declare_fns(ui : u32 in 0 .. 255, fuel : u32 in 0 .. 128) -> bool
    effects { reads nodes.slots, writes sym_used, writes syms.slots, reads cur_depth, writes check_bad }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { check_bad = true; return false; }
    if ui == 255 { return true; }
    narrow ui to 0 .. 95 else { check_bad = true; return false; }
    let k = parse::node_kind(ui);
    if k == 12 {
        let a = parse::node_a(ui);
        narrow a to 0 .. 95 else { check_bad = true; return false; }
        let ka = parse::node_kind(a);
        if ka == 13 {
            let s = parse::node_a(a);
            narrow s to 0 .. 159 else { check_bad = true; return false; }
            let l = parse::node_b(a);
            narrow l to 0 .. 159 else { check_bad = true; return false; }
            sym_declare(s, l);
            let b = parse::node_b(ui);
            return declare_fns(b, fuel - 1);
        }
        check_bad = true;
        return false;
    }
    check_bad = true;
    return false;
}
impl fn check_unit(ui : u32 in 0 .. 255, fuel : u32 in 0 .. 128) -> bool
    effects { reads nodes.slots, writes check_bad, writes bad_start, writes bad_len, writes sym_used, writes syms.slots, writes scopebase.slots, writes cur_depth, writes scope_top }
    decreases fuel
{
    narrow fuel to 1 .. 128 else { check_bad = true; return false; }
    if ui == 255 { return true; }
    narrow ui to 0 .. 95 else { check_bad = true; return false; }
    let k = parse::node_kind(ui);
    if k == 12 {
        let a = parse::node_a(ui);
        narrow a to 0 .. 95 else { check_bad = true; return false; }
        let q = check_stmt(a, fuel - 1);
        if !q { return false; }
        let b = parse::node_b(ui);
        return check_unit(b, fuel - 1);
    }
    check_bad = true;
    return false;
}
impl fn check_failed() -> bool
    effects { reads check_bad }
{
    return check_bad;
}
impl fn main() -> u32 in 0 .. 255
    effects { writes srcbuf::src.slots, writes srcbuf::srclen, writes lex::tok_used, writes lex::toks.slots, writes lex::lex_err, writes parse::node_used, writes parse::nodes.slots, writes parse::parse_err, writes sym_used, writes syms.slots, writes scopebase.slots, writes cur_depth, writes scope_top, writes check_bad, writes bad_start, writes bad_len }
{
    srcbuf::fill();
    lex::lex_all(0, 160);
    if lex::lex_failed() { return 255; }
    let u = parse::parse_unit(0, 128);
    if !u.ok { return 254; }
    if parse::parse_failed() { return 253; }
    let d = declare_fns(u.node, 128);
    if !d { return 252; }
    if check_failed() { return 252; }
    let c = check_unit(u.node, 128);
    if !c { return 252; }
    if check_failed() { return 252; }
    let t = lex::tok_count();
    let n = parse::node_count();
    let s = t + n;
    return s;
}
}
