/- A nonzero reservation, captured operands and a live sentinel satisfy the byte-write premises together. -/
import Stage0.Senke.Anweisung.Bytes.Put
import Runner.Prog.IRAsm
import Grammatik.Parser.Elab.UebersetzeAllg

namespace Gabbro.Stage0.Senke.ReservedByteProbe
open Gabbro.Grammatik Runner.IR Runner.Mem
open Gabbro.Grammatik.Parser.Uebersetze Gabbro.Grammatik.Parser.UebersetzeAllg
set_option maxRecDepth 100000
set_option maxHeartbeats 2000000

def source : UProg := { tabs := [{ name := "Bytes", count := 1, cols := [("byte", (0, 255))] }], locks := [], fns := [] }
abbrev D := declOf source
abbrev tab : D.Tab := ⟨0, by decide⟩
abbrev field : D.Feld tab := ⟨0, by decide⟩
instance : Subsingleton D.Tab := by
  change Subsingleton (Fin 1)
  infer_instance
instance (t : D.Tab) : Subsingleton (D.Feld t) := by
  have ht : t = tab := Subsingleton.elim _ _
  subst t
  change Subsingleton (Fin 1)
  infer_instance

def layout : Lay D where
  col _ _ := 8192
  ga g := Fin.elim0 g
  lo := 8192
  hi := 8200
  tor a := Fin.elim0 a
  byte _ := none

def world : World D where
  slots t _ f := by
    have ht : t = tab := Subsingleton.elim _ _
    subst t
    have hf : f = field := Subsingleton.elim _ _
    subst f
    exact ⟨0, by decide, by decide⟩
  globs g := Fin.elim0 g
  spur := []

def value : Zahl 0 255 := ⟨42, by decide, by decide⟩
def index : Zahl 0 0 := ⟨0, by decide, by decide⟩
def env : Env D [.int 0 0, .int 0 255] := .cons index (.cons value .nil)
def lowered := putBytesL layout (Γ := []) (Λ := []) tab field 0 0 255 (by decide) 4 1 0 (by decide)
def code : List II := (lowered.getD ([], 0)).1
def top : Nat := (lowered.getD ([], 0)).2

def bytes := code.flatMap (fun i => Runner.Prog.insB i.o i.a i.b i.c)

def memory : Runner.Mem where
  b a := if a.toNat < bytes.length then (bytes[a.toNat]?).getD 0
    else if a.toNat = 4128 then 77 else if a.toNat = 4160 then 42 else 0
  rd _ := true
  wr _ := true

theorem layout_in : LayIn layout := by
  refine ⟨fun t f k hk => ?_, (fun g => Fin.elim0 g), by decide⟩
  have ht : t = tab := Subsingleton.elim _ _
  subst t
  change (k : Int) < 1 at hk
  have : k = 0 := by omega
  subst k
  change 8192 ≤ 8192 + 8 * 0 ∧ 8192 + 8 * 0 + 8 ≤ 8200
  decide

theorem layout_dis : LayDis layout := by
  constructor
  · intro c c' hc hc' he
    cases c with
    | glob g => exact Fin.elim0 g
    | elem t f k =>
      cases c' with
      | glob g => exact Fin.elim0 g
      | elem t' f' k' =>
        have ht : t = t' := Subsingleton.elim _ _
        subst t'
        have hf : f = f' := Subsingleton.elim _ _
        subst f'
        change 8192 + 8 * k = 8192 + 8 * k' at he
        have : k = k' := by omega
        subst k'
        rfl
  · intro c hc
    cases c with
    | glob g => exact Fin.elim0 g
    | elem t f k => change (8192 + 8 * k) % 8 = 8192 % 8; omega

theorem pre [Kern] : PreS layout memory 0 4096 64 10 code env 4 := by
  refine ⟨by decide, by decide, ⟨by decide, fun _ _ => rfl, fun _ _ => rfl⟩, ?_, ?_, ?_, trivial, wstab_true _ _⟩
  · intro k hk
    have hc : ∀ k : Fin code.length,
        memory.rd8 (BitVec.ofNat 64 (16 * k.val)) = some (BitVec.ofNat 8 code[k].o) ∧
        memory.rd32 (BitVec.ofNat 64 (16 * k.val) + 4) = some (II.f code[k].a) ∧
        memory.rd32 (BitVec.ofNat 64 (16 * k.val) + 8) = some (II.f code[k].b) ∧
        memory.rd32 (BitVec.ofNat 64 (16 * k.val) + 12) = some (II.f code[k].c) := by decide +kernel +revert
    have h := hc ⟨k, hk⟩
    exact ⟨by simpa using h.1, by simpa using h.2.1, by simpa using h.2.2.1, by simpa using h.2.2.2⟩
  · unfold CodeFar; decide +kernel
  · intro τ x
    cases x with
    | here => exact ⟨0, by decide +kernel, rfl⟩
    | there x =>
      cases x with
      | here => exact ⟨42, by decide +kernel, rfl⟩
      | there x => nomatch x

theorem world_at : WeltAt memory layout world := by
  refine ⟨fun t f k hk => ?_, (fun g => Fin.elim0 g), fun _ _ _ => rfl⟩
  have ht : t = tab := Subsingleton.elim _ _
  subst t
  have hf : f = field := Subsingleton.elim _ _
  subst f
  change (k : Int) < 1 at hk
  have : k = 0 := by omega
  subst k
  exact ⟨0, by decide +kernel, rfl⟩

/-- Actual generated byte stores preserve slot four while consuming captured slots eight and nine. -/
theorem putBytes_reserved_sentinel_zeuge [Kern] :
    lowered = some (code, top) ∧ PreS layout memory 0 4096 64 10 code env 4 ∧
    ∃ m', Star ⟨0, 4096⟩ memory ⟨0 + BitVec.ofNat 64 (16 * code.length), 4096⟩ m' ∧
      WeltAt m' layout (world.schreibBytes tab field rfl [] 0 (zahlZuBytes 1 42)) ∧
      m'.rd64 (slot 4096 4) = some 77 := by
  have hcode : lowered = some (code, top) := by decide +kernel
  have hW : WIn layout 4096 64 64 := ⟨layout_in, layout_dis, by decide, by decide, by decide⟩
  obtain ⟨m', hs, ha, _, hw⟩ := putBytesL_ok (reserved := 4) rfl (by decide) hW value index
    (Env.nil : Env D []) (by decide) 1 0 (by decide) (by decide) code top hcode
    (by decide +kernel) memory 0 world pre world_at
  refine ⟨hcode, pre, m', hs, ?_, ?_⟩
  · exact hw
  · have h := agreeW_rdW hW ha (i := 4) (by decide) (by decide)
    exact h.trans (by decide +kernel)
end Gabbro.Stage0.Senke.ReservedByteProbe
