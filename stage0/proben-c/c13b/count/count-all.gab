// Counting over slots: every slot satisfies the predicate, so the count is the table size.
module c13b_count_all {
table Flags count 4 { slot { flag : bool, } }
impl fn main() -> u32 in 0 .. 4
    effects { reads Flags.slots, writes Flags.slots }
{
    Flags.slots[0].flag = true;
    Flags.slots[1].flag = true;
    Flags.slots[2].flag = true;
    Flags.slots[3].flag = true;
    let n = count k in slots of Flags : Flags.slots[k].flag;
    return n;
}
}
