// A count ranges over one table only; this predicate also reads table B.
module c13b_count_cross_table {
table A count 2 { slot { flag : bool, } }
table B count 2 { slot { flag : bool, } }
impl fn main() -> u32 in 0 .. 2
    effects { reads A.slots, reads B.slots, writes A.slots, writes B.slots }
{
    A.slots[0].flag = true;
    A.slots[1].flag = false;
    B.slots[0].flag = true;
    B.slots[1].flag = false;
    let n = count k in slots of A : A.slots[k].flag && B.slots[0].flag;
    return n;
}
}
