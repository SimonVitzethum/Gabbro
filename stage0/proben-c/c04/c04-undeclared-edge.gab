// A stage name no declaration knows is refused even when the source stage exists.
module ir_probe {
table T count 2 { slot { s : u32 in 0 .. 2, } }
state S { transition begin { s : Idle -> Busy } }
impl fn main() -> u32 in 0 .. 2
    effects { reads T.slots, writes T.slots }
{
    transition T.slots[1].s : Idle -> Gone;
    return T.slots[1].s;
}
}
