// A declared edge whose target stage leaves the field's range is refused.
module ir_probe {
table T count 2 { slot { s : u32 in 0 .. 1, } }
state S {
    transition begin { s : Idle -> Busy }
    transition finish { s : Busy -> Done }
}
impl fn main() -> u32 in 0 .. 1
    effects { reads T.slots, writes T.slots }
{
    transition T.slots[1].s : Busy -> Done;
    return T.slots[1].s;
}
}
