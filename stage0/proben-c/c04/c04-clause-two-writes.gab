// C04: a guarded two-step transition performs both stores in order.
module ir_probe {
table T count 2 { slot { s : u32 in 0 .. 2, t : u32 in 0 .. 2, flag : bool, } }
state S { transition cycle { s : Idle -> Busy, t : Idle -> Busy } requires T.slots[1].flag effects { writes T.slots } }
impl fn main() -> u32 in 0 .. 10
    effects { reads T.slots, writes T.slots }
{
    T.slots[1].flag = true;
    transition T.slots[1].s : Idle -> Busy;
    transition T.slots[1].t : Idle -> Busy;
    return T.slots[1].s + T.slots[1].t;
}
}
