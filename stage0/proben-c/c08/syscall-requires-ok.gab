// C08 probe: a real gate with requires/ensures; the literal 0 decides the requires,
// and the ensures (result <= len, hence 0) puts n + 42 inside main's range.
// Shape mirrors the stage0 gateelse/puffer probes; write(1, 0, 0) answers 0.
module c08_syscall_requires_ok {
reason IoError {
    BadFd       = 9 "the file descriptor is not open"
    Interrupted = 4 "the call was interrupted before anything was written"
    exhaustive
}
assume linux_write_n
    "The Linux x86_64 `write` writes the buffer's first len bytes and answers how many."
    falsifier sonde_write_n;
syscall schreibe(fd : u64, buf : u64, len : u64) -> u64 in 0 .. 4096 or IoError
    abi linux arch x86_64 number 1
    regs in { rdi = fd, rsi = buf, rdx = len }
    regs out { rax }
    clobbers { rcx, r11 }
    errors { EBADF => BadFd, EINTR => Interrupted }
    requires len <= 1024
    ensures result <= len
    effects { pure }
    costs <= 8 ops
    assume linux_write_n falsifier sonde_write_n;
impl fn main() -> u64 in 0 .. 100
    effects { pure }
{
    let n = schreibe(1, 0, 0) else (e) {
        return 50;
    }
    return n + 42;
}
}
