// C05 refusal probe: the global twin of `beispiele/gift/281`. The group names
// the lock `K` as if it were a carrier. Carriers are `table`, `static` and
// `state` -- a lock protects carriers, it is none (U001).
module c05_unknown_carrier {
static mut cnt : u32 in 0 .. 100 = 30;
static mut total : u32 in 0 .. 100 = 70;
lock K protects { cnt, total } rank 0;
group Summe over { cnt, K } {
    invariant summe_bleibt : cnt + total == 100;
}
impl fn main() -> u8 { return 0; }
}
