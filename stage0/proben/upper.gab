// stage-0 probe (instrumente/pruefe-lean.py stage 7): no gate: the input arrives in io.ein, the output leaves from io.aus (the kernel witness of Zeuge.lean)
module stage0_probe { static mut ein_len : u32 in 0 .. 8 = 0; static mut aus_len : u32 in 0 .. 8 = 0; table io count 8 { slot { ein : u32 in 0 .. 255, aus : u32 in 0 .. 255, } } impl fn gross(b : u32 in 0 .. 255) -> u32 in 0 .. 255 { if b >= 97 { narrow b to 97 .. 122 else { return b; } return b - 32; } return b; } impl fn main(t : ptr<normal, rw> io) effects { reads t.slots, writes t.slots, reads ein_len, writes aus_len } { traverse k over slots of t by unvisited touches writes t.slots { let c : u32 in 0 .. 255 = gross(t.slots[k].ein); t.slots[k].aus = c; } aus_len = ein_len; } }
