// Different entry cells must not silently share one snapshot word.
module ir_probe {
static mut g : u32 in 0 .. 100 = 0;
static mut h : u32 in 0 .. 100 = 0;
impl fn change() effects { reads g, reads h, writes g }
    ensures g == old(g) + 12 && h == old(h)
{ g = 19; }
impl fn main() -> u32 in 0 .. 100 effects { reads g, reads h, writes g } {
    g = 7;
    change();
    return g;
}
}
