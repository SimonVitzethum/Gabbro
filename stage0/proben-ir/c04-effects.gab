// C04: a transition declaration with an effects clause naming the store.
module c04_effects {
table T count 2 { slot { s : u32 in 0 .. 2, } }
state S { transition begin { s : Idle -> Busy } effects { writes T.slots } }
impl fn main() -> u32 in 0 .. 2
    effects { reads T.slots, writes T.slots }
{
    transition T.slots[1].s : Idle -> Busy;
    return T.slots[1].s;
}
}
