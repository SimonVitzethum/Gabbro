// C04: a transition declaration with a requires clause, satisfied at use.
module c04_requires {
table T count 2 { slot { s : u32 in 0 .. 2, v : u8, } }
state S { transition begin { s : Idle -> Busy } requires T.slots[1].v == 7 }
impl fn main() -> u32 in 0 .. 2
    effects { reads T.slots, writes T.slots }
{
    T.slots[1].v = 7;
    transition T.slots[1].s : Idle -> Busy;
    return T.slots[1].s;
}
}
