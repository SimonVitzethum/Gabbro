// C10: nested exclusive locks in rank order, returns 42.
module c10_lock_rank_ok {
table A count 1 { slot { v : u32 in 0 .. 10, } }
table B count 1 { slot { v : u32 in 0 .. 10, } }
lock L0 protects { A } rank 0;
lock L1 protects { B } rank 1;
impl fn main() -> u32 in 0 .. 255 effects { reads A.slots, reads B.slots, writes A.slots, writes B.slots, locks L0, locks L1 } {
    locks L0 {
        locks L1 {
            A.slots[0].v = 1;
            B.slots[0].v = 2;
        }
    }
    return 42;
}
}
