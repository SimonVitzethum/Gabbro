// Each guarded increment reads a fresh snapshot at 0 .. 19 and assigns the original counter at 0 .. 20.
// Three increments take c from 0 to 3; the plain else block of c < 1 reads a snapshot at 1 .. 20 and
// decrements c to 2. Exit code: 0 + 1 + 1 + 1 - 1 = 2.
module ir_probe {
impl fn main() -> u32 in 0 .. 20 {
    let mut c : u32 in 0 .. 20 = 0;
    if c < 20 { c = c + 1; }
    if c < 20 { c = c + 1; }
    if c < 20 { c = c + 1; }
    if c < 1 { c = 0; } else { c = c - 1; }
    return c;
}
}
