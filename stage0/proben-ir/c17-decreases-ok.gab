// C17: decreases on a simple countdown; narrow keeps the call in range.
module c17_decreases_ok {
impl fn down(n : u32 in 0 .. 10) -> u32 in 0 .. 11
    effects { pure }
    decreases n
{
    if n == 0 { return 0; }
    narrow n to 1 .. 10 else { return 0; }
    let r = down(n - 1) + 1;
    narrow r to 0 .. 11 else { return 0; }
    return r;
}
impl fn main() -> u32 in 0 .. 255 effects { pure } {
    return down(5);
}
}
