// Refused: the front end recognizes arrow access only through local references.
module ir_probe {
table T from provider { slot { x : u64 in 0 .. 255, } }
extern fn provider() -> index into T effects { pure } costs <= 1000 ops;
impl fn read(r : index into T) -> u64 in 0 .. 255
    effects { reads T.slots }
{
    return r->x;
}
impl fn main() -> u64 in 0 .. 100 effects { pure } {
    return 42;
}
}
