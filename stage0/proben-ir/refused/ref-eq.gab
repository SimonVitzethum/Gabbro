// Refused: the front end has no reference comparison form for provider-bound locals.
module ir_probe {
table T from provider { slot { x : u64 in 0 .. 255, } }
extern fn provider() -> index into T effects { pure } costs <= 1000 ops;
impl fn equal() -> bool effects { pure } {
    let a = alloc T;
    let b = alloc T;
    return a == b;
}
impl fn main() -> u64 in 0 .. 100 effects { pure } {
    return 0;
}
}
