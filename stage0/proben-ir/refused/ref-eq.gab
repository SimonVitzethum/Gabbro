// Refused: the front end currently treats parameter comparisons as numeric comparisons.
module ir_probe {
table T from provider { slot { x : u64 in 0 .. 255, } }
extern fn provider() -> index into T effects { pure } costs <= 1000 ops;
impl fn equal(a : index into T, b : index into T) -> bool effects { pure } {
    return a == b;
}
impl fn main() -> u64 in 0 .. 100 effects { pure } {
    return 0;
}
}
