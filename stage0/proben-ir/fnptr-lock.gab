// IR probe: ignored and bound indirect results inside a return-free lock body. The locks declare
// no hold bound: a section with a declared bound takes no indirect call (K002 has no cost for one).
module ir_probe {
lock L protects { } rank 0;
lock M protects { } rank 1;
impl fn target() -> u32 in 0 .. 100
    effects { locks M }
    costs <= 32 ops
{
    locks M { }
    return 43;
}
impl fn main() -> u32 in 0 .. 100
    effects { locks L, locks M }
{
    let mut value : u32 in 0 .. 100 = 0;
    locks L {
        let p = &target;
        p();
        let answer = p();
        value = answer;
    }
    return value;
}
}
