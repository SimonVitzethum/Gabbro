// C08: extern gate variable without target binding is refused.
module c08_no_target {
assume hw_ok "Hardware answers." falsifier probe_hw;
extern fn ext(x : u32 in 0 .. 10) -> u32 in 0 .. 20 effects { pure } costs <= 8 ops;
impl fn main() -> u32 in 0 .. 255 effects { pure } {
    let v = ext(5);
    return 42;
}
}
