// C03: a closed reason forwarded through two elses, then matched at the end.
module c03_forward_match {
reason Fault {
    First = 1 "first reason"
    Second = 2 "second reason"
    exhaustive
}
impl fn fail(n : u32 in 0 .. 2) -> u32 in 0 .. 42 or Fault
    effects { pure }
{
    if n == 0 { return Fault::First; }
    if n == 1 { return Fault::Second; }
    return 39;
}
impl fn pass(n : u32 in 0 .. 2) -> u32 in 0 .. 42 or Fault
    effects { pure }
{
    let value = fail(n) else (reason) {
        return reason;
    }
    return value;
}
impl fn main() -> u32 in 0 .. 255
    effects { pure }
{
    let value = pass(0) else (reason) {
        match reason {
            First => { return 42; }
            Second => { return 7; }
        }
        return 7;
    }
    return 7;
}
}
