// Array-only calls must also receive constant-backed canonical signatures.
module const_signature_array {
type Base = u8;
const LIMIT : Base = 40 + 2;
const fn identity(x : u8 in 0 .. LIMIT) -> u8 in 0 .. LIMIT effects { pure } { return x; }
const VALUES : [Base; 1] = [identity(42)];
impl fn main() -> Base effects { pure } { return VALUES[0]; }
}
