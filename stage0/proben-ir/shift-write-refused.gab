// A state declaration grants no write permission to its user.
module ir_probe {
table T count 2 { slot { s : u32 in 0 .. 2, } }
state S { transition begin { s : Idle -> Busy } }
impl fn main() -> u32 in 0 .. 2
    effects { reads T.slots }
{
    transition T.slots[1].s : Idle -> Busy;
    return T.slots[1].s;
}
}
