];
table Count count 4096 { slot { } }
table Store count 1 { slot { xs : [u32 in 0 .. 9; 4096], } }
static mut acc : u32 in 0 .. 250 = 0;
impl fn scan(xs : [u32 in 0 .. 9; 4096]) -> u32 in 0 .. 250
    effects { reads Count.slots, reads acc, writes acc }
{
    acc = 0;
    traverse j over slots of Count by unvisited touches reads Count.slots, reads acc, writes acc {
        acc = (acc + xs[j]) % 251;
    }
    return acc;
}
impl fn main() -> u32 in 0 .. 250
    effects { reads DATA, reads Count.slots, reads Store.slots, writes Store.slots, reads acc, writes acc }
{
    let mut xs : [u32 in 0 .. 9; 4096] = DATA;
    Store.slots[0].xs = xs;
    xs[0] = 2;
    let parameter_sum = scan(xs);
    acc = 0;
    traverse j over slots of Count by unvisited
        touches reads DATA, reads Count.slots, reads Store.slots, reads acc, writes acc {
        acc = (acc + DATA[j] + xs[j] + Store.slots[0].xs[j]) % 251;
    }
    return (acc + parameter_sum) % 251;
}
}
