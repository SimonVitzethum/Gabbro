// Narrowing by a relation between two locals: a guard that compares two immutable number locals bounds their
// difference in the guarded block, with no `narrow` statement and no new return path.
//   distance: `if a >= b` makes `a - b` at least 0 (the declared ranges alone give -100 .. 100);
//   gap:      `if a > b` makes `a - b` at least 1, so `a - b - 1` is at least 0;
//   remain:   `if i < n` makes `n - i` at least 1, so `n - i - 1` is at least 0.
// main: distance(30, 12) = 18, distance(5, 9) = 0; gap(10, 3) = 10 - 3 - 1 = 6, gap(3, 3) = 0;
// remain(2, 7) = 7 - 2 - 1 = 4, remain(7, 7) = 0. Exit code 18 + 0 + 6 + 0 + 4 + 0 = 28.
module ir_probe {
impl fn distance(a : u32 in 0 .. 100, b : u32 in 0 .. 100) -> u32 in 0 .. 100 {
    if a >= b { return a - b; }
    return 0;
}

impl fn gap(a : u32 in 0 .. 100, b : u32 in 0 .. 100) -> u32 in 0 .. 100 {
    if a > b {
        let d = a - b - 1;
        return d;
    }
    return 0;
}

impl fn remain(i : u32 in 0 .. 100, n : u32 in 0 .. 100) -> u32 in 0 .. 100 {
    if i < n {
        let r = n - i;
        let s = r - 1;
        return s;
    }
    return 0;
}

impl fn main() -> u32 in 0 .. 600 {
    let p = distance(30, 12);
    let q = distance(5, 9);
    let r = gap(10, 3);
    let s = gap(3, 3);
    let t = remain(2, 7);
    let u = remain(7, 7);
    return p + q + r + s + t + u;
}
}
