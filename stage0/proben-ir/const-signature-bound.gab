// Constant-backed parameter/result ranges use the certified full original type environment.
module const_signature_bound {
type Base = u8;
const LIMIT : Base = 40 + 2;
const fn identity(x : u8 in 0 .. LIMIT) -> u8 in 0 .. LIMIT effects { pure } { return x; }
const ANSWER : Base = identity(42);
impl fn main() -> Base effects { pure } { return ANSWER; }
}
