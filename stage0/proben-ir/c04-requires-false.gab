// C04: the requires clause is false at use.
module c04_requires_false {
table T count 2 { slot { s : u32 in 0 .. 2, v : u8, } }
state S { transition begin { s : Idle -> Busy } requires T.slots[1].v == 7 effects { writes T.slots } }
impl fn main() -> u32 in 0 .. 2
    effects { reads T.slots, writes T.slots }
{
    T.slots[1].v = 3;
    transition T.slots[1].s : Idle -> Busy;
    return T.slots[1].s;
}
}
