// C05: writer omits one of the two locks of a mixed group.
module c05_missing_lock {
table A count 2 { slot { v : u8, } }
table B count 2 { slot { w : u8, } }
lock LA protects { A } rank 0;
lock LB protects { B } rank 1;
group G over { A, B } {
    invariant same : forall i in slots of A : A.slots[i].v == B.slots[i].w;
}
impl fn set_both(x : u8) effects { writes A.slots, writes B.slots } requires Held(LA) {
    A.slots[0].v = x;
    B.slots[0].w = x;
}
impl fn main() -> u32 in 0 .. 255 effects { reads A.slots, reads B.slots, writes A.slots, writes B.slots, locks LA, locks LB } {
    locks LA {
        locks LB {
            set_both(21);
            return A.slots[0].v + B.slots[0].w;
        }
    }
}
}
