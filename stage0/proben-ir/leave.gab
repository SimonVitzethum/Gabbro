// stage-0 IR probe (instrumente/pruefe-lean.py stage 7): stage0 --ir, then the runner; exit code 25
module ir_probe {
static mut summe : u32 in 0 .. 100000 = 0;
table t count 10 { slot { a : u32 in 0 .. 255, } }
impl fn main() -> u32 in 0 .. 100000
    effects { reads t.slots, writes t.slots, reads summe, writes summe }
{
    traverse i over slots of t by unvisited touches writes t.slots {
        t.slots[i].a = i + 1;
    }
    traverse j over slots of t by unvisited touches reads t.slots, reads summe, writes summe {
        if t.slots[j].a == 3 {
            next j;
        }
        if t.slots[j].a == 8 {
            leave j;
        }
        summe = (summe + t.slots[j].a) % 60000;
    }
    return summe;
}
}
