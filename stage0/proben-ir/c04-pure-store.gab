// C04 refusal probe: a pure transition declaring a store.
module c04_pure_store {
table T count 2 { slot { s : u32 in 0 .. 2, } }
state S { transition begin { s : Idle -> Busy } effects { pure } }
impl fn main() -> u32 in 0 .. 2
    effects { reads T.slots, writes T.slots }
{
    transition T.slots[1].s : Idle -> Busy;
    return T.slots[1].s;
}
}
