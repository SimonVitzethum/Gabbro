// A mutable guard snapshot stops before a potential assignment: the conservative assigned-place walk
// counts j in T.slots[j].v as a barrier. No read is replaced before it, so this indexed write stays refused.
module ir_probe {
table T count 10 { slot { v : u32 in 0 .. 100, } }

impl fn store(i : u32 in 0 .. 100) -> u32 in 0 .. 100
    effects { reads T.slots, writes T.slots }
{
    let mut j : u32 in 0 .. 100 = i;
    if j < 10 {
        T.slots[j].v = 7;
        return 1;
    }
    return 0;
}

impl fn main() -> u32 in 0 .. 100
    effects { reads T.slots, writes T.slots }
{
    let a = store(4);
    return a;
}
}
