// Run-time checks: a precondition the checker cannot prove is checked by the callee (`checks`), and
// the caller checks a result (`check`); after each check the code runs where its condition holds.
// half(84) = 42 passes both checks. Exit 42.
module ir_checks_runtime {
reason Fault { TooBig = 1 "too big" exhaustive }
impl fn half(x : u32 in 0 .. 1000) -> u32 in 0 .. 50 or Fault
    effects { pure }
    checks x <= 100 else Fault::TooBig
{
    return x / 2;
}
impl fn main() -> u32 in 0 .. 255
    effects { pure }
{
    let a = half(84) else (e) { return 1; };
    check a == 42 else { return 3; }
    return a;
}
}
