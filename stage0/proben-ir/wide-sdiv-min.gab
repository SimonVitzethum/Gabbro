// The signed minimum of a 128-bit range divided by -1: the quotient needs the extra limb the result type provides.
module ir_probe {
impl fn quo(a : i64 in -170141183460469231731687303715884105728 .. 170141183460469231731687303715884105727, b : i64 in -1 .. -1) -> i64 in -170141183460469231731687303715884105728 .. 170141183460469231731687303715884105728 effects { pure } {
    return a / b;
}
impl fn rm(a : i64 in -170141183460469231731687303715884105728 .. 170141183460469231731687303715884105727, b : i64 in -1 .. -1) -> i64 in -1 .. 1 effects { pure } {
    return a % b;
}
impl fn main() -> u32 in 0 .. 255 effects { pure } {
    let q = quo(-170141183460469231731687303715884105728, -1);
    let r = rm(-170141183460469231731687303715884105728, -1);
    let p = quo(170141183460469231731687303715884105727, -1);
    if q == 170141183460469231731687303715884105728 {
        if r == 0 {
            if p == -170141183460469231731687303715884105727 { return 42; }
        }
    }
