// A call in the right operand of `&&` or `||`, or in the condition of an `else if`, runs only when
// the operands and conditions in front of it admit it: the static records the last call made.
module ir_call_conditional {
static mut n : u32 in 0 .. 20 = 0;
impl fn big(b : u32 in 0 .. 20) -> bool effects { reads n, writes n } { n = b; return b >= 5; }
impl fn main() -> u32 in 0 .. 255 effects { reads n, writes n } {
    let mut r1 : u32 in 0 .. 1 = 0;
    let mut r2 : u32 in 0 .. 1 = 0;
    let mut r3 : u32 in 0 .. 1 = 0;
    let mut r4 : u32 in 0 .. 1 = 0;
    let mut bad : u32 in 0 .. 1 = 0;
    let a : u32 in 0 .. 20 = 3;
    if a > 5 && big(7) { bad = 1; }
    if n == 7 { bad = 1; }
    if a < 5 && big(8) { r1 = 1; }
    if n == 8 { r2 = 1; }
    if a < 5 || big(9) { r3 = 1; }
    if n == 9 { bad = 1; }
    if a > 5 || big(2) { bad = 1; }
    if a > 5 { bad = 1; } else if big(11) { r4 = 1; } else if big(12) { bad = 1; } else { bad = 1; }
    if n == 12 { bad = 1; }
    return r1 + r2 * 2 + r3 * 4 + r4 * 8 + bad * 100 + n;
}
}
