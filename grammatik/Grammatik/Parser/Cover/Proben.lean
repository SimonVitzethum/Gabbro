def predIs (toks : List Token) (want : SExpr) : Bool :=
  match parsePred 400 toks with
  | .ok (e, [.ende]) => beqSExpr e want
  | _ => false

def predFails (toks : List Token) : Bool :=
  match parsePred 400 toks with
  | .ok (_, [.ende]) => false
  | _ => true

def exprIs (toks : List Token) (want : SExpr) : Bool :=
  match parseOr 400 toks with
  | .ok (e, [.ende]) => beqSExpr e want
  | _ => false

def stmtIs (toks : List Token) (want : SAnw) : Bool :=
  beqTopStmt (parseTopStmt toks) (.ok want)

def stmtFails (toks : List Token) : Bool :=
  match parseTopStmt toks with
  | .ok _ => false
  | .error _ => true

def itemsOk (toks : List Token) : Bool :=
