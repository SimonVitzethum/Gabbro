          cases hc
          rw [semHA_alsBlock_schrumpf]
          exact ZErgG.folgt_refl _
      | logik e => trivial
      | hardware e => trivial)
  exact ⟨hFad, logOk_eintritt hL hReq⟩

end Gabbro.Grammatik
