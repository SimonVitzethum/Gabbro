    (fun O' U A R σ κ e _ hκ h => by
      rw [semHA_dann]
      simp only [execBlockHA, hκ, h]
      exact weiterHA_logik S O' U A passes R _ e)
    (fun O' U A R σ κ _ hκ => by
      rw [semHA_dann]
      simp only [execBlockHA, hκ]
      cases R g κ (evalArgs κ args κ ρ) with
