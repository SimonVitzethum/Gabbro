set_option maxHeartbeats 4000000 in
theorem akteurSA_dannNarrowOk {D : Deklaration} {P : Programm D} {O : Orakel D} {passes : Nat}
  {Q : AxEns D} {S : SperrInv D} {lok : D.Tab ⊕ D.Glob → Bool} {Tg : D.Tab ⊕ D.Glob → Prop} {m : Mass D}
  {zyk : D.Fn → D.Fn → Bool} (hO : GutO O) (hRL : RegLokal O) (hQ : AxVertragO Q O) (hlok : AxEnsLokal Q)
  (hS : SperrInvOk S) {sp : Speicher D} (hsp : ∀ (L : D.Lock), S.inv L sp = true)
  (hK : ∀ (f : D.Fn), KoerperGutSA P passes Q S Tg f) (hM : ∀ (f : D.Fn), MassPflicht P passes Q S Tg m zyk f)
  (hTV : ∀ (c : D.Tab ⊕ D.Glob), Tg c → VertragsFrei P c)
  (hFragS : ∀ (f : D.Fn), Endblock.gOk (kandP P (fussOrteG P f)) (regP (sicher P lok f)) (P.rumpf f) = true)
  (hFS : ∀ (f : D.Fn), FussSX P S lok Tg f) {M : RufMaschineG D} {u : Faden}
  (hF : FadenSA P O passes Q S lok Tg m zyk (M.faeden u) (M.weltVon u)) (hL : LogOk P (M.faeden u).log)
  (hRS : RahmenStapelS P S lok M.speicher (RufSchluesselG (M.faeden u).kopf) (M.faeden u).stapel) (hSG : SperrInvG S M)
  (l : Bool) (Γ : Ctx) (Λ Λ' Λ'' : List (Res D)) (lo hi lo' hi' : Int) (e : Expr D Γ Λ (Ty.int lo hi))
  (sonst : Endblock D (vertragVon D (M.faeden u).kopf.f) l Γ Λ)
  (rest : Block D (vertragVon D (M.faeden u).kopf.f) l (Ty.int lo' hi' :: Γ) Λ Λ')
  (k : GRest D (vertragVon D (M.faeden u).kopf.f) l Γ Λ') (ρ : Env D Γ)
  (hhead :
    (M.faeden u).kopf.rest =
      (⟨l,
          (⟨Γ,
              (⟨Λ, (ρ, GRest.dann (Block.narrow e lo' hi' sonst rest) k)⟩ :
                (Λ : List (Res D)) × Env D Γ × GRest D (vertragVon D (M.faeden u).kopf.f) l Γ Λ)⟩ :
            (Γ : Ctx) × (Λ : List (Res D)) × Env D Γ × GRest D (vertragVon D (M.faeden u).kopf.f) l Γ Λ)⟩ :
        (l : Bool) × (Γ : Ctx) × (Λ : List (Res D)) × Env D Γ × GRest D (vertragVon D (M.faeden u).kopf.f) l Γ Λ))
  (σ₁ : World D) (hs₁ : σ₁ = (M.weltVon u).lese Λ e.orte) (h : lo' ≤ (eval σ₁ e σ₁ ρ).n ∧ (eval σ₁ e σ₁ ρ).n ≤ hi')
  (neu : List (Ereignis D)) (hneu : σ₁.spur = neu ++ (M.faeden u).spur) (hΛ : HeldIn Λ (offen (M.faeden u).spur)) :
  FadenSA P O passes Q S lok Tg m zyk
      ({ speicher := M.speicher,
            faeden :=
              rufUpdateG M.faeden u
                { stapel := (M.faeden u).stapel,
                  kopf :=
                    { f := (M.faeden u).kopf.f, rho := (M.faeden u).kopf.rho, s0 := (M.faeden u).kopf.s0,
                      rest :=
                        (⟨l,
                            (⟨Ty.int lo' hi' :: Γ,
                                (⟨Λ,
                                    (Env.cons
                                        { n := (eval σ₁ e σ₁ ρ).n, lo_le := h.left, le_hi := h.right : Zahl lo' hi' } ρ,
                                      GRest.dann rest k.schrumpf)⟩ :
                                  (Λ : List (Res D)) ×
                                    Env D (Ty.int lo' hi' :: Γ) ×
                                      GRest D (vertragVon D (M.faeden u).kopf.f) l (Ty.int lo' hi' :: Γ) Λ)⟩ :
                              (Γ : Ctx) ×
                                (Λ : List (Res D)) × Env D Γ × GRest D (vertragVon D (M.faeden u).kopf.f) l Γ Λ)⟩ :
                          (l : Bool) ×
                            (Γ : Ctx) ×
                              (Λ : List (Res D)) × Env D Γ × GRest D (vertragVon D (M.faeden u).kopf.f) l Γ Λ) :
                      RufRahmenG D },
                  spur := σ₁.spur, log := (M.faeden u).log : RufFadenG D },
            lauf := M.lauf ++ rufEigenG u neu, start := M.start : RufMaschineG D }.faeden
        u)
      ({ speicher := M.speicher,
            faeden :=
              rufUpdateG M.faeden u
                { stapel := (M.faeden u).stapel,
                  kopf :=
                    { f := (M.faeden u).kopf.f, rho := (M.faeden u).kopf.rho, s0 := (M.faeden u).kopf.s0,
                      rest :=
                        (⟨l,
                            (⟨Ty.int lo' hi' :: Γ,
                                (⟨Λ,
                                    (Env.cons
                                        { n := (eval σ₁ e σ₁ ρ).n, lo_le := h.left, le_hi := h.right : Zahl lo' hi' } ρ,
                                      GRest.dann rest k.schrumpf)⟩ :
                                  (Λ : List (Res D)) ×
                                    Env D (Ty.int lo' hi' :: Γ) ×
                                      GRest D (vertragVon D (M.faeden u).kopf.f) l (Ty.int lo' hi' :: Γ) Λ)⟩ :
                              (Γ : Ctx) ×
                                (Λ : List (Res D)) × Env D Γ × GRest D (vertragVon D (M.faeden u).kopf.f) l Γ Λ)⟩ :
                          (l : Bool) ×
                            (Γ : Ctx) ×
                              (Λ : List (Res D)) × Env D Γ × GRest D (vertragVon D (M.faeden u).kopf.f) l Γ Λ) :
                      RufRahmenG D },
                  spur := σ₁.spur, log := (M.faeden u).log : RufFadenG D },
            lauf := M.lauf ++ rufEigenG u neu, start := M.start : RufMaschineG D }.weltVon
        u) ∧
    LogOk P
      ({ speicher := M.speicher,
              faeden :=
                rufUpdateG M.faeden u
                  { stapel := (M.faeden u).stapel,
                    kopf :=
                      { f := (M.faeden u).kopf.f, rho := (M.faeden u).kopf.rho, s0 := (M.faeden u).kopf.s0,
                        rest :=
                          (⟨l,
                              (⟨Ty.int lo' hi' :: Γ,
                                  (⟨Λ,
                                      (Env.cons
                                          { n := (eval σ₁ e σ₁ ρ).n, lo_le := h.left, le_hi := h.right : Zahl lo' hi' }
                                          ρ,
                                        GRest.dann rest k.schrumpf)⟩ :
                                    (Λ : List (Res D)) ×
                                      Env D (Ty.int lo' hi' :: Γ) ×
                                        GRest D (vertragVon D (M.faeden u).kopf.f) l (Ty.int lo' hi' :: Γ) Λ)⟩ :
                                (Γ : Ctx) ×
                                  (Λ : List (Res D)) × Env D Γ × GRest D (vertragVon D (M.faeden u).kopf.f) l Γ Λ)⟩ :
                            (l : Bool) ×
                              (Γ : Ctx) ×
                                (Λ : List (Res D)) × Env D Γ × GRest D (vertragVon D (M.faeden u).kopf.f) l Γ Λ) :
                        RufRahmenG D },
                    spur := σ₁.spur, log := (M.faeden u).log : RufFadenG D },
              lauf := M.lauf ++ rufEigenG u neu, start := M.start : RufMaschineG D }.faeden
          u).log := by
  simp only [RufMaschineG.weltVon, rufUpdateG_self]
  subst hs₁
  refine ⟨fadenSA_lese hF hhead _ (.dann rest (.schrumpf k)) _ Λ e.orte
    (fun hok => by
      obtain ⟨_, hss, _⟩ := hok
      obtain ⟨hes, _, _⟩ := teile2 hss
      exact expr_stabilX (hFS _) e hes)
    (fun σ hg hok => ?_), hL⟩
  obtain ⟨hks, hss, hrest⟩ := hok
  obtain ⟨_, hkr⟩ := and_teile hks
  obtain ⟨_, _, hrS⟩ := teile2 hss
  have he' : eval σ e σ ρ = eval ((M.weltVon u).lese Λ e.orte) e ((M.weltVon u).lese Λ e.orte) ρ :=
    eval_gleichAuf e (fun _ h => List.mem_append_right _ h) hg ρ
  have h' : lo' ≤ (eval σ e σ ρ).n ∧ (eval σ e σ ρ).n ≤ hi' := by rw [he']; exact h
  refine ⟨σ, Nat.le_refl _, GleichAuf.mono (fun _ h => List.mem_append_left _ h) hg,
    ⟨hkr, hrS, hrest⟩, fun R O' U A σ0 _ _ hσ0 => ?_⟩
  have h1 := semHA_narrowOk S O' U A passes R e lo' hi' sonst rest k σ0 ρ (by rw [hσ0]; exact h')
  have hz : (⟨(eval (leseA A σ0 Λ e.orte) e (leseA A σ0 Λ e.orte) ρ).n,
      (by rw [hσ0]; exact h' : lo' ≤ (eval (leseA A σ0 Λ e.orte) e (leseA A σ0 Λ e.orte) ρ).n ∧
        (eval (leseA A σ0 Λ e.orte) e (leseA A σ0 Λ e.orte) ρ).n ≤ hi').1,
      (by rw [hσ0]; exact h' : lo' ≤ (eval (leseA A σ0 Λ e.orte) e (leseA A σ0 Λ e.orte) ρ).n ∧
        (eval (leseA A σ0 Λ e.orte) e (leseA A σ0 Λ e.orte) ρ).n ≤ hi').2⟩ :
      Wert D (.int lo' hi')) =
      ⟨(eval ((M.weltVon u).lese Λ e.orte) e ((M.weltVon u).lese Λ e.orte) ρ).n, h.1, h.2⟩ := by
    simp only [hσ0, he']
  rw [hz, hσ0] at h1
  exact ZErgG.folgt_of_eq h1

end Gabbro.Grammatik
