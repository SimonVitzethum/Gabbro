/-
  File:      Grammatik/Gen/Erzeuger/Probe.lean
  Subject:   WITNESSES and a PLANTED DEFECT for the generator and its completeness.

  `probeD` is a small concrete declaration (one table with a counted field, one static, one function, one lock
  site absent) with complete enumerations (`probeA`). On it:

  * the generator is NOT EMPTY: it produces terms of every shape the probe admits, and the completeness
    theorem (`genExpr_vollst`) puts a concrete term of size 2 into `genExpr 2`;
  * the PLANTED DEFECT `genExprOhneNeg` is the generator with the clause of `neg` removed: the same concrete
    term is NOT generated (decided by the kernel on the head constructors of the generated list), so a bounded
    instance of completeness FAILS for a generator that skips a constructor -- the theorem is not vacuous.
-/
import Grammatik.Gen.Erzeuger.Gueltig

namespace Gabbro.Grammatik.Gen

open Gabbro.Grammatik Gabbro.Grammatik.Zielsatz

/-- The probe's one function signature: no parameters, no result, no channel, writes everything. -/
def probeSig : Signatur Unit Unit Empty Empty where
  params := []
  erg := none
  gruende := 0
  haelt := []
  schreibt := fun _ => true
  gschreibt := fun _ => true
  konsumiert := []
  produziert := []

/-- The probe declaration: `Tab = Unit` (count 2, one field `0 .. 3`), `Glob = Unit` (`0 .. 1`),
    `Fn = Unit`; locks, marks, invariants, axioms, registers are empty. -/
def probeD : Deklaration where
  Tab := Unit
  decTab := inferInstance
  count := fun _ => 2
  Feld := fun _ => Unit
  decFeld := fun _ => inferInstance
  typ := fun _ _ => .int 0 3
  erlaubt := fun _ _ _ _ => false
  tabNr := fun | 0 => some () | _ => none
  Glob := Unit
  decGlob := inferInstance
  gtyp := fun _ => .int 0 1
  nutzlast := fun _ => []
  atomar := fun _ => false
  geteilt := fun _ => false
  ggeteilt := fun _ => false
  Lock := Empty
  decLock := inferInstance
  rang := fun e => nomatch e
  maskiert := fun e => nomatch e
  Marke := Empty
  decMarke := inferInstance
  stufen := fun e => nomatch e
  braucht := fun _ => []
  gbraucht := fun _ => []
  eigner := fun _ => []
  Fn := Unit
  sig := fun _ => 0
  sigNr := fun _ => probeSig
  eigner_nie_erzeugt := fun _ _ _ _ h => by simp at h
  Inv := Empty
  traeger := fun e => nomatch e
  invs := []
  Ax := Empty
  aparams := fun e => nomatch e
  aerg := fun e => nomatch e
  aschreibt := fun e => nomatch e
  agschreibt := fun e => nomatch e
  Reg := Empty
  rtyp := fun e => nomatch e
  rklasse := fun e => nomatch e
  spiegel := fun e => nomatch e
  rzusage := fun e => nomatch e
  Annahme := Unit
  a10 := ()
  geteilt_bewacht := fun _ h => by simp at h
  invarianten_gehalten := fun _ i => nomatch i
  ggeteilt_bewacht := fun _ h => by simp at h

/-- Complete enumerations of the probe. -/
instance probeA : Aufz probeD where
  tab := [()]
  tab_mem := fun _ => List.mem_singleton.2 rfl
  feld := fun _ => [()]
  feld_mem := fun _ _ => List.mem_singleton.2 rfl
  glob := [()]
  glob_mem := fun _ => List.mem_singleton.2 rfl
  lock := []
  lock_mem := fun e => nomatch e
  marke := []
  marke_mem := fun e => nomatch e
  fn := [()]
  fn_mem := fun _ => List.mem_singleton.2 rfl
  inv := []
  inv_mem := fun e => nomatch e
  ax := []
  ax_mem := fun e => nomatch e
  reg := []
  reg_mem := fun e => nomatch e
  annahme := [()]
  annahme_mem := fun _ => List.mem_singleton.2 rfl
  decFn := inferInstanceAs (DecidableEq Unit)
  decInv := fun e => nomatch e
  decAx := fun e => nomatch e
  decReg := fun e => nomatch e
  decAnnahme := inferInstanceAs (DecidableEq Unit)

/-- Is the head constructor `neg`? -/
def istNeg {D : Deklaration} {Γ : Ctx} {Λ : List (Res D)} {τ : Ty} : Expr D Γ Λ τ → Bool
  | .neg _ => true
  | _ => false

/-- Is the head constructor a literal? -/
def istLit {D : Deklaration} {Γ : Ctx} {Λ : List (Res D)} {τ : Ty} : Expr D Γ Λ τ → Bool
  | .lit _ => true
  | _ => false

/-- The head constructor is `slot`? -/
def istSlot {D : Deklaration} {Γ : Ctx} {Λ : List (Res D)} {τ : Ty} : Expr D Γ Λ τ → Bool
  | .slot .. => true
  | _ => false

/-! ## The generator is not empty, and the theorem puts a concrete term into it -/

/-- A literal, a negation, a table slot are generated by `genExpr 2` (decided by the kernel). -/
example : ((genExpr (D := probeD) 2 [] []).any fun p => istLit p.2) = true := by decide +kernel
example : ((genExpr (D := probeD) 2 [] []).any fun p => istNeg p.2) = true := by decide +kernel
example : ((genExpr (D := probeD) 2 [] []).any fun p => istSlot p.2) = true := by decide +kernel

/-- The concrete term `-0` (size 2) is in the generator -- from the completeness theorem. -/
example : (⟨_, Expr.neg (Expr.lit 0)⟩ : SE probeD [] []) ∈ genExpr 2 [] [] :=
  genExpr_vollst 2 [] [] _ _ (by decide)

/-! ## The planted defect: a generator that skips the constructor `neg` -/

/-- `genExprS` without the clause of `neg`. -/
def genExprSOhneNeg [Aufz D] {Γ : Ctx} {Λ : List (Res D)} (m : Nat) (es : List (SE D Γ Λ))
    (rek : ∀ Γ' : Ctx, List (SE D Γ' Λ)) : List (SE D Γ Λ) :=
  gLit m ++ gBool ++ gVar Γ Λ ++ gGlob ++ gSlot es ++ gThru es ++ gPtrOf m ++ gFnref ++ gOldG ++ gOldS es ++
  gWiden m es ++ gAdd es ++ gSub es ++ gMul es ++ gDiv es ++ gRem es ++ gSdiv es ++ gSrem es ++
  gGetBytes m es ++ gBand es ++ gBor m es ++ gBxor m es ++ gShl m es ++ gShr m es ++ gLt es ++ gLe es ++ gEq es ++
  gFllt es ++ gFlle es ++ gAnd es ++ gOr es ++ gNot es ++ gNone m ++ gSome m es ++ gIstSome es ++ gCase m es ++
  gWhy m ++ gForall rek ++ gExists rek ++ gReaches es

/-- The defective generator. -/
def genExprOhneNeg [Aufz D] : Nat → (Γ : Ctx) → (Λ : List (Res D)) → List (SE D Γ Λ)
  | 0, _, _ => []
  | m + 1, Γ, Λ => genExprSOhneNeg m (genExprOhneNeg m Γ Λ) (fun Γ' => genExprOhneNeg m Γ' Λ)

/-- The defective generator never produces a `neg` (decided by the kernel on the probe). -/
theorem ohneNeg_keine_neg : ((genExprOhneNeg (D := probeD) 2 [] []).any fun p => istNeg p.2) = false := by
  decide +kernel

/-- **The bounded instance of completeness FAILS for the defective generator**: `-0` has size 2 and is
    not generated at fuel 2 -- whereas the real generator contains it (`example` above). -/
theorem defekt_luecke : (⟨_, Expr.neg (Expr.lit 0)⟩ : SE probeD [] []) ∉ genExprOhneNeg 2 [] [] := by
  intro h
  have h1 : ((genExprOhneNeg (D := probeD) 2 [] []).any fun p => istNeg p.2) = true :=
    List.any_eq_true.2 ⟨_, h, rfl⟩
  rw [ohneNeg_keine_neg] at h1
  exact Bool.false_ne_true h1


/-! ## A valid program, and the theorem's instances on it -/

/-- The empty program of the probe: every predicate `true`, the one body is `return;`. -/
def probeP : Programm probeD where
  invariante := fun e => nomatch e
  requires := fun _ => .tru
  ensures := fun _ => .tru
  rumpf := fun _ => .ret .empty (List.Perm.refl [])

/-- No lock family (there is no lock). -/
def probeS : SperrInv probeD where
  orte := fun e => nomatch e
  inv := fun e => nomatch e

/-- The probe program is accepted by the checker's Bool (decided by the kernel). -/
theorem probeP_gueltig : AkzeptiertX probeP probeS [()] [] [.inl (), .inr ()] [()] = true := by
  decide +kernel

/-- **(C) at a concrete valid program**: it is generated at its size. -/
theorem probeP_erzeugt : probeP ∈ genGueltig probeS [()] [] [.inl (), .inr ()] [()] (groesseProg probeP) :=
  gueltig_vollst probeS [()] [] [.inl (), .inr ()] [()] probeP_gueltig (Nat.le_refl _)

/-- The same program with ONE root declared twice (`ws = [(), ()]`) is refused by exactly component 6 (the
    single-pool component: a start declared once running on several threads), accepted by the other nine. -/
theorem probeP_nur_an_6 : NurAn 6 probeP probeS [()] [] [.inl (), .inr ()] [(), ()] := by
  unfold NurAn
  decide +kernel

/-- **(C) for a single-fault refusal**: it is generated at its size, under its label. -/
theorem probeP_bad_erzeugt :
    probeP ∈ genBad 6 probeS [()] [] [.inl (), .inr ()] [(), ()] (groesseProg probeP) :=
  bad_vollst probeS [()] [] [.inl (), .inr ()] [(), ()] probeP_nur_an_6 (Nat.le_refl _)

end Gabbro.Grammatik.Gen
