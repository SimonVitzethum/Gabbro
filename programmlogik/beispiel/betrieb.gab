-- Datei 2 -- die Ruempfe. Sie schreiben in eine Tabelle, die in Datei 1 steht.
module betrieb {

use lager::Faecher;
use lager::Menge;
use lager::Marken;
use lager::HALLE;

pub impl fn raeumen(f : index into Faecher)
    requires Held(HALLE), Faecher.slots[f].belegt
    effects  { reads Faecher.slots, writes Faecher.slots, locks HALLE }
    costs    <= 12 ops
{
    Faecher.slots[f].belegt  = false;
    Faecher.slots[f].menge   = 0;
    Faecher.slots[f].sperrig = false;
}

-- **Ein Rumpf, der RUFT.** Er steht hier, damit der Kanal einen Ruf zu uebersetzen hat --
-- und der Ruf wird ueber den VERTRAG von `raeumen` genommen, nie ueber dessen Rumpf.
pub impl fn raeumen_und_merken(f : index into Faecher)
    requires Held(HALLE), Faecher.slots[f].belegt
    ensures  Faecher.slots[f].belegt == false
    effects  { reads Faecher.slots, writes Faecher.slots, locks HALLE }
    costs    <= 20 ops
{
    raeumen(f);
}

-- **Ein Rumpf, der RECHNET** -- eine Schiebung, eine Maske und eine Division. Er steht hier,
-- damit die Bitrechnung des Modells einmal uebersetzt und einmal bewiesen wird, und damit
-- ein Satz ueber ihr auch einmal FAELLT: `SpecGift.lean` rundet ab, wo C abschneidet.
--
-- `/ 2` ist schreibbar, weil der Nenner eine Konstante ohne Null ist (M102); `>> 4` und
-- `& 3` bleiben in `0 .. 255`, also greift auch M104 nicht.
pub impl fn kennzeichnen(f : index into Faecher, roh : Marken)
    requires Held(HALLE)
    effects  { reads Faecher.slots, writes Faecher.slots, locks HALLE }
    costs    <= 24 ops
{
    Faecher.slots[f].marken = (roh >> 4) & 3;
    Faecher.slots[f].menge  = Faecher.slots[f].menge / 2;
}

pub impl fn einlagern(f : index into Faecher, m : Menge)
    requires Held(HALLE)
    effects  { reads Faecher.slots, writes Faecher.slots, locks HALLE }
    costs    <= 12 ops
{
    Faecher.slots[f].belegt = true;
    Faecher.slots[f].menge  = m;
}

}
