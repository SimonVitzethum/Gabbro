// Named assumptions may be architecture-specific or architecture-independent.
// An ordinary function's arch clause also declares the unit's machine.
module example::assumption_machine {
module entry_machine {
assume service_is_available arch x86_64
    "The environment service is available."
    falsifier probe_service;
assume timer_ticks
    "The environment delivers timer ticks."
    falsifier probe_timer;
impl fn dispatch() effects { pure } costs <= 1 ops { }
entry start arch x86_64 { dispatch example::assumption_machine::entry_machine::dispatch; }
}
module function_machine {
assume counter_is_monotonic arch x86_64
    "The environment counter does not decrease."
    falsifier probe_counter;
impl fn barrier() effects { pure } costs <= 1 ops arch x86_64 { }
}
}
