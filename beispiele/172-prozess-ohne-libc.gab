-- 172 -- A Linux process WITHOUT a C library: the program's own `write`.
--
-- `beispiele/64` binds libc's `write`; this file binds the KERNEL's. The call is a
-- `syscall` gate the program declares -- number, register map, errors, the assumption
-- the kernel keeps -- and the manifest next door (`172-prozess-ohne-libc.bau`) says
-- `nolibc`: the build links `-nostdlib -static` and enters `main` from a generated `_start`.
-- There is no C file in it, and `nm -u` on the binary is empty (`instrumente/zaehle-c.py`).
--
-- The gate for `write` carries the buffer clause of every byte-moving call (`N464`):
-- `requires len <= lenof(buf)`, decided at the call below (`N463`) -- the same duty
-- `beispiele/64` states for libc's, now held on the kernel's.
module beispiel::prozess_ohne_libc {

reason SchreibFehler {
    BadFd = 9 "the file descriptor is not open"
    exhaustive
}

assume linux_write
    "The Linux x86_64 `write` reads exactly `len` bytes from `buf`, answers the count written or -errno, and destroys only rcx and r11."
    falsifier sonde_write;

syscall write(fd : u64, buf : ptr<normal, r> u8, len : u64) -> u64 or SchreibFehler
    abi linux arch x86_64 number 1
    regs in { rdi = fd, rsi = buf, rdx = len }
    regs out { rax }
    clobbers { rcx, r11 }
    errors { EBADF => BadFd }
    requires len <= lenof(buf)
    effects { reads buf }
    costs <= 8 ops
    assume linux_write falsifier sonde_write;

pub const KAP : u32 = 16;

pub static mut PUFFER : [u8; KAP] = 0;

pub fn main() -> i32 in 0 .. 1
    effects { reads PUFFER, writes PUFFER }
    costs   <= 200 ops
{
    PUFFER[0] = 72;    -- H
    PUFFER[1] = 97;    -- a
    PUFFER[2] = 108;   -- l
    PUFFER[3] = 108;   -- l
    PUFFER[4] = 111;   -- o
    PUFFER[5] = 10;    -- newline
    let n = write(1, PUFFER, 6) else (e) { return 1; }
    return 0;
}

}
