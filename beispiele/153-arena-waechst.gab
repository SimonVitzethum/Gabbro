-- 153 -- **Growth under a ceiling, spelled with today's tools.**
--
-- A dynamic arena declares a ceiling `max M` (address reserved) and a committed
-- prefix grown explicitly by `grow` (`dokumente/PLAN-DYNAMISCH.md`). That syntax
-- is not in the tree yet (no parser lane owns `max`/`grow`), so this file is the
-- static shape the dynamic form must preserve byte for byte: `capacity 2 .. 8`
-- with `M = hi = 8`. Every allocation past the reservation `lo = 2` carries its
-- `else` -- the growth points are enumerable by grep, each with its branch, the
-- way an explicit `grow` will be. The second phase (`reset`, then allocate
-- again) is the phase discipline the monotone commit relies on: `reset` starts
-- a fresh generation and leaves the committed prefix alone.
--
-- Fully clean, and it emits: a static array of eight elements beside its `used`
-- counter, no heap allocation in the C. The slots are 16-bit (the reads widen
-- to 32 bits on load, the `99` shape), so the eight-way sum fits `u32` by
-- construction, and the re-allocation after `reset` stores one 16-bit read --
-- no narrowing owed anywhere. Executed result: 370 (see the report).
module beispiel::arena_waechst {
arena Wachstum capacity 2 .. 8 of u16;

impl fn waechst() -> u32 effects { writes Wachstum } costs <= 64 ops {
    let a = alloc Wachstum (10);
    let b = alloc Wachstum (20);
    let c = alloc Wachstum (30) else {
        return 0;
    };
    let d = alloc Wachstum (40) else {
        return 0;
    };
    let e = alloc Wachstum (50) else {
        return 0;
    };
    let f = alloc Wachstum (60) else {
        return 0;
    };
    let g = alloc Wachstum (70) else {
        return 0;
    };
    let h = alloc Wachstum (80) else {
        return 0;
    };
    let x1 : u32 = Wachstum[a];
    let x2 : u32 = Wachstum[b];
    let x3 : u32 = Wachstum[c];
    let x4 : u32 = Wachstum[d];
    let x5 : u32 = Wachstum[e];
    let x6 : u32 = Wachstum[f];
    let x7 : u32 = Wachstum[g];
    let x8 : u32 = Wachstum[h];
    let sum = x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8;
    reset Wachstum;
    let k = alloc Wachstum (x1);
    let r : u32 = Wachstum[k];
    return r + sum;
}
}
