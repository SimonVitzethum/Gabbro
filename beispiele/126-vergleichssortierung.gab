// 126 -- **A sort-like routine through a comparator pointer.**
//
// The pointer type is a SIGNATURE (2026-10-21, `Deklaration.passt` in the Lean model):
// two `u32` in, a `bool` out, no effect, a cost bound. `kleiner` fits because its own
// signature conforms; `sortiere` knows nothing about `kleiner` but the type: the hull and
// the costs at `v->cmp(...)` read the slot. What the comparator MEANS (a total order)
// is no clause of the type -- a pointer type carries no contract (`N589`, TODO O43) --
// so sortedness below is the user's own `ensures`, counted as `N`.
module beispiel::vergleichssortierung {

table Zahlen count 4 {
    slot {
        wert : u32,
    }
}

lock ZAHLEN protects { Zahlen } rank 0 held <= 64 ops;

// The comparator signature, at the TYPE: no carrier, only the two arguments.
type Vergleich = {
    cmp : fn(a : u32, b : u32) -> bool
        effects { pure }
        costs   <= 3 ops,
};

// The function behind the pointer: its own `ensures` stays with it.
impl fn kleiner(a : u32, b : u32) -> bool
    ensures result == (a <= b)
    effects { pure }
    costs   <= 3 ops
{
    return a <= b;
}

// The producer form: `&kleiner` is the one shape in which a function becomes a value.
impl fn nimm() -> Vergleich
    effects { pure }
    costs   <= 2 ops
{
    return Vergleich(cmp: &kleiner);
}

// One compare-and-swap through the slot: the hull reads `pure` and the costs read `3`.
impl fn ordne(v : ptr<normal, r> Vergleich, i : index into Zahlen, j : index into Zahlen)
    requires Held(ZAHLEN)
    effects { reads v, reads Zahlen.slots, writes Zahlen.slots }
    costs   <= 18 ops
{
    if !v->cmp(Zahlen.slots[i].wert, Zahlen.slots[j].wert) {
        let t = Zahlen.slots[i].wert;
        Zahlen.slots[i].wert = Zahlen.slots[j].wert;
        Zahlen.slots[j].wert = t;
    }
}

// A sorting network for four elements: five compare-swaps, each through the slot.
// Sortedness below is the USER's (`ensures` is counted as `N`, not proved); what the
// checker carries is that every swap went through a function of the comparator's type.
impl fn sortiere(v : ptr<normal, r> Vergleich)
    requires Held(ZAHLEN)
    ensures Zahlen.slots[0].wert <= Zahlen.slots[1].wert,
            Zahlen.slots[1].wert <= Zahlen.slots[2].wert,
            Zahlen.slots[2].wert <= Zahlen.slots[3].wert
    effects { reads v, reads Zahlen.slots, writes Zahlen.slots }
    costs   <= 96 ops
{
    ordne(v, 0, 1);
    ordne(v, 2, 3);
    ordne(v, 0, 2);
    ordne(v, 1, 3);
    ordne(v, 1, 2);
}

}
