-- 173 -- The end of a process is a Gabbro function: a `-> never` gate over `exit_group`.
--
-- A watchdog (`on_exceeded`) names a function that does not come back. Until the C-free lane
-- that function was a foreign body -- `abort()` behind an `extern fn` -- and a program with one
-- carried a C file and a libc import for it. Here the watchdog is written in Gabbro:
-- `exit_group` is a `syscall` gate declared `-> never` (its contract says the process ends, so
-- it has no answer to decode), and a `-> never` function that ends in it ends in a call to a
-- diverging name, which is all `S009` asks. There is no C file in the unit, and `nm -u` on the
-- binary is empty (`instrumente/zaehle-c.py`); the manifest next door says `nolibc`.
module beispiel::abbruch_ohne_libc {

assume linux_exit_group
    "The Linux x86_64 `exit_group` ends every thread of the process with status `code & 255` and never returns to its caller."
    falsifier sonde_exit_group;

syscall exit_group(code : u64) -> never
    abi linux arch x86_64 number 231
    regs in { rdi = code }
    regs out { rax }
    clobbers { rcx, r11 }
    errors { }
    effects { diverges }
    costs <= 8 ops
    assume linux_exit_group falsifier sonde_exit_group;

-- The watchdog: status 134 is what `abort()` leaves behind, so a caller that tells the two
-- apart by status sees no difference.
fn haengt() -> never
    effects { diverges }
    costs <= 10 ops
{
    exit_group(134);
}

pub fn main() -> i32 in 0 .. 1
    effects { pure }
{
    let mut i : u32 in 0 .. 3 = 0;
    forever zaehlend
        per_pass bounded 64 ops
        on_exceeded haengt
        effects { pure }
    {
        if i >= 3 {
            leave zaehlend;
        }
        i += 1;
    }
    return 0;
}

}
