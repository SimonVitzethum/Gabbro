-- 110 -- **The guarded footprint: every written carrier a contract, a body or a
-- callee contract reads is held by signature.**
--
-- The positive shape beside `gift/930` and `916`…`918`: `zaehler` is written, read in a
-- contract (`lies`), read in a body (`lies`, `lies_doppelt`) and inherited through a
-- call (`lies_doppelt` over `lies`) -- and every one of those functions holds the
-- guard `ZAEHLER` by signature, so E245 through E248 all stay silent. `erhoehe` takes
-- the lock in the body instead; taking is not holding, but a writer needs no
-- footprint guard for what it writes without reading.
module beispiel::fussgarantie {

static mut zaehler : u32 = 0;

lock ZAEHLER protects { zaehler } rank 0 held <= 8 ops;

-- A reader: contract and body over a written carrier, guarded by signature.
impl fn lies() -> u32
    requires Held(ZAEHLER)
    ensures result == zaehler
    effects { reads zaehler }
    costs   <= 8 ops
{
    return zaehler;
}

-- A caller: the callee contract joins its footprint under the same guard.
impl fn lies_doppelt() -> u32
    requires Held(ZAEHLER)
    effects { reads zaehler }
    costs   <= 16 ops
{
    let a = lies();
    return a;
}

-- A writer: takes the lock in the body.
impl fn erhoehe() effects { writes zaehler, locks ZAEHLER } costs <= 8 ops
{
    locks ZAEHLER {
        zaehler = 1;
    }
}

}
