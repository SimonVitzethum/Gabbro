-- 90 -- the error path of a system call: the kernel says no.
--
-- The same `write` shape as `beispiele/74`, called on a descriptor that is
-- never open. The kernel answers `EBADF`, the generated decoding delivers
-- `BadFd` through the `or IoError` channel, and the wrapper names it. The
-- emission check runs this file beside 74: 74 measures the value path (a
-- `write(1, "ok\n", 3)` returns 3), this one the reason path.

module beispiel::syscall_errno {

reason IoError {
    BadFd       = 9  "the file descriptor is not open"
    Interrupted = 4  "the call was interrupted before anything was written"
    WouldBlock  = 11 "the descriptor is non-blocking and the write would block"
    exhaustive
}

assume linux_write_contract
    "Write keeps its contract on this machine."
    falsifier sonde_write;

assume metal_kernel_contract
    "The image's kernel entry (vector 0x80, laufzeit/metall/) answers every number it serves under the Linux x86_64 convention -- the answer in rax, -errno in -4095..-1, no other register destroyed -- and keeps each gate's contract for it."
    falsifier sonde_metall_systemruf;

syscall sys_write;

syscall write(fd : u64, buf : u64, len : u64) -> u64 or IoError
    via sys_write
    requires len <= 1024
    ensures result <= len
    effects { pure }
    costs <= 8 ops;

-- Descriptor 9999 is never open in a test process (and out of range where the
-- table is smaller) -- either way the kernel answers `EBADF`, deterministically.
impl fn schreibe_ungueltig(buf : u64, len : u64) -> u64
    effects { pure }
{
    let n = write(9999, buf, len) else (e) {
        match e {
            BadFd       => { return 777; }
            Interrupted => { return 0; }
            WouldBlock  => { return 0; }
        }
    }
    return n;
}

-- **The targets (OFFEN O31).** The gate above names
-- no kernel; the binding below does. `linux_x86_64` is the literal half this gate
-- carried until Opus agent L, unchanged; `metal` is the same number and register map
-- through `int $0x80` into the image's kernel entry, which destroys no register, under
-- its own assumption -- never silently the Linux one (`N566`). The selection keeps the
-- hosted stub unchanged; `gabbro emit --target metal` builds the other.
target linux_x86_64 abi linux arch x86_64 {
    sys_write = number 1
        regs in { rdi = fd, rsi = buf, rdx = len }
        regs out { rax }
        clobbers { rcx, r11 }
        errors { EBADF => BadFd, EINTR => Interrupted, EAGAIN => WouldBlock }
        assume linux_write_contract falsifier sonde_write;
}

target metal abi metal arch x86_64 {
    sys_write = number 1
        regs in { rdi = fd, rsi = buf, rdx = len }
        regs out { rax }
        clobbers { }
        errors { EBADF = 9 => BadFd, EINTR = 4 => Interrupted, EAGAIN = 11 => WouldBlock }
        assume metal_kernel_contract falsifier sonde_metall_systemruf;
}

target linux_x86_64;

}
