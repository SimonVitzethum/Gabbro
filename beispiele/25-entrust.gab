-- 25 -- `entrust`: der Raum, dessen INHALT Gabbro nicht kennt.
--
-- **Gabbro sagt ueber den Gast nichts.** Keine Kosten, keine Wirkungen, keine Terminierung,
-- keine Blattheit. Fuer den JIT-*Uebersetzer* gilt die Zusage vollstaendig -- Byteemission,
-- Tabellen, beschraenkte Schleifen. Fuer den GAST gilt Isolation statt Beweis.
--
-- *Das ist keine Luecke, sondern der Zweck eines Mikrokernels.* Was Gabbro sagt, ist der
-- Vertrag am EINTRITT, und die Annahme, unter der er gilt.

-- **Und der Erzeuger weigert sich BENANNT** (`C001`): `entrust` ist erklaert, geprueft und
-- bezeugt -- abgesenkt ist es nicht. Die Uebergabe an den Gast ist ein Registervertrag und
-- ein Sprung, also dieselbe Baustelle wie `entry`, und die steht offen. *Ein Erzeuger, der
-- hier raet, macht jeden Pass davor zunichte.*

module beispiel::gast {

-- Der `code`-Raum als deklariertes Ding. `at` nimmt einen NAMEN: ein `entrust` auf einen
-- gerechneten Wert waere ein Sprung an eine ausgerechnete Adresse.
type Gastbild = {
    eintritt : u64,
    laenge   : u32,
};

-- **Die Annahme ist Pflicht und nicht schmueckend.** Dass der Gast in seinem Raum bleibt,
-- ist eine Aussage ueber die Umgebung -- hier ueber die Seitentabellen, die ihn einsperren.
-- Der Falsifikator ist die Sonde, die einen Ausbruch bemerkt: **eine Annahme, der keine
-- Sonde je widersprechen kann, ist keine Isolation, sondern ein Wunsch.**
assume gast_bleibt_in_seinem_raum
    "Der Gast springt nur an seine Eintrittsadresse und bleibt in seinem Raum -- die Seitentabellen erzwingen es."
    falsifier sonde_gastausbruch;

entrust jitpuffer at Gastbild arch x86_64 {
    regs in { eintritt : rdi, kappe : rsi, }
    stack  gaststapel
    assume gast_bleibt_in_seinem_raum;
}

-- Der ERZEUGER des Gastcodes ist gewoehnliches Gabbro -- er schreibt Bytes in eine Tabelle,
-- und jede dieser Zeilen traegt ihre Klempnerei wie jede andere.
const NBYTES : u32 = 4096;
type Bytelage = u32 in 0 ..< NBYTES;

table Puffer count 4096 {
    slot { wert : u8, }
}

impl fn byte_legen(p : ptr<normal, rw> Puffer, wo : Bytelage, was : u8)
    effects { writes p.slots }
    costs   <= 2 ops
{
    p.slots[wo].wert = was;
}

}
