-- Eine Halde mit Deckel: 30 GiB ADRESSRAUM, hinterlegt wird, was da ist.
--
-- **Und `30 GiB` ist die Einheit der Seiten, nicht die des Objekts** (gemessen 2026-08-31).
-- `DECKE` zaehlt Seiten a 4 KiB; der erzeugte C-Typ misst `sizeof(Arena)` = 125829120 Byte
-- = 120 MiB. Ein Koerper entsteht hier ohnehin nicht: `Arena` laeuft als `ptr<…> Arena`
-- durch die Parameter, und wer die Tabelle beim NAMEN nennt, bekommt erst `static Arena
-- Arena_speicher;` (`emit.rs`). *Der 2-GiB-Uebergang liegt woanders und ist in
-- `messung/proben/probe-zwei-gibibyte.gab` gemessen.*
--
-- Bis zum 2026-08-31 war dies die einzige Datei im Baum, die nie emittiert wurde: sie fiel
-- an einem `L104`, das ein Fehlalarm war -- `narrow … else` lief in M2 als geradliniger
-- Rumpf statt als Zweig.
module app::halde {

const DECKE : u32 = 7864320;          -- 30 GiB / 4 KiB
const BODEN : u32 = 25600;            -- 100 MiB immer

static mut hinterlegt : u32 in 25600 .. 7864320 = 25600;

table Arena count 7864320 backed hinterlegt {
    slot { belegt : bool, wert : u64, }
}

-- **Der Zeuge.** Eine Vergabe erzeugt ihn, eine Freigabe verbraucht ihn.
-- `ghost` heisst: im Erzeugnis steht davon keine Zeile.
linear ghost type Griff;

extern fn griff_fuer(i : index into Arena) -> Griff effects { pure } costs <= 0 ops;
extern fn griff_weg(g : Griff)                     effects { consumes g } costs <= 0 ops;

impl fn vergeben(a : ptr<normal, rw> Arena, i : index into Arena) -> Griff
    effects { reads hinterlegt, writes a.slots }
    costs   <= 8 ops
{
    narrow i to 0 ..< hinterlegt else { return griff_fuer(i); }
    a.slots[i].belegt = true;
    return griff_fuer(i);
}

impl fn freigeben(a : ptr<normal, rw> Arena, i : index into Arena, g : Griff)
    effects { reads hinterlegt, writes a.slots, consumes g }
    costs   <= 8 ops
{
    narrow i to 0 ..< hinterlegt else { griff_weg(g); return; }
    a.slots[i].belegt = false;
    griff_weg(g);
}

}
