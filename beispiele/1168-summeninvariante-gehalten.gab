// 1168 -- a sum invariant re-established inside the section (the clean side of `gift/1481`).
//
// `x + y == 100` holds again at the release because the section writes `x = 30` and `y = 70` and the
// release analysis evaluates the sum from those two facts. (Before the differential harness only
// equalities between cells and constants were evaluated, so a sum invariant had to be held by signature.)
module beispiel1168 {

table P count 2 { slot { x : u32 in 0 .. 100, } }
table Q count 2 { slot { y : u32 in 0 .. 100, } }
lock K protects { P, Q } rank 0 held <= 50 ops invariant P.slots[0].x + Q.slots[0].y == 100;

impl fn f(k : ptr<normal, rw> P, m : ptr<normal, rw> Q)
    effects { writes k.slots, writes m.slots, locks K }
    costs <= 40 ops
{
    locks K {
        k.slots[0].x = 30;
        m.slots[0].y = 70;
    }
}

}
