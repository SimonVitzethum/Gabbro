// **The `until` predicate of a `retry` stands under the guard of the table it reads.**
//
// Clean twin of `gift/1482-retry-until-ohne-sperre.gab`: the whole loop is inside `locks L`, so the
// predicate's read of `T` is guarded and the hold bound (`held <= 100 ops`) covers the bounded wait.
module retry_until_under_guard {

table T count 4 {
    slot {
        v : u32 in 0 .. 100,
    }
}

lock L protects { T } rank 0 held <= 100 ops;

assume ok_ "the cell changes" falsifier sonde_ok;

extern fn zeit() -> never effects { diverges } costs <= 1 ops;

impl fn waits_guarded(i : index into T)
    effects { reads T.slots, locks L }
    costs   <= 64 ops
{
    locks L {
        retry warten until T.slots[i].v == 1
            bounded 8 ops
            progress ok_
            on_exceeded zeit
            effects { reads T.slots }
        { }
    }
}

}
