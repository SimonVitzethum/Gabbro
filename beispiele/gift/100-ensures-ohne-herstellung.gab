-- erwartet: M111
-- **Eine Zusage, die weder `result` nennt noch einen geschriebenen Ort, kann die Funktion
-- nicht HERSTELLEN.** Sie ist dann ein `requires` oder ein `maintains` am falschen Platz.
--
-- Das ist die schaerfste der drei Regeln und die einzige, die nicht bloss Buchhaltung ist:
-- sie haelt die Nachbedingung gegen `effects`, also gegen eine Klausel, die GELESEN wird.
module gift::herstellung {

static mut ZAEHLER : u32 in 0 .. 100 = 0;

impl fn liest_nur(x : u32 in 0 .. 10) -> u32
    ensures ZAEHLER == 5
    effects { reads ZAEHLER }
    costs   <= 2 ops
{
    return x;
}

}
