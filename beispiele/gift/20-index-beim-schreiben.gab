-- MUSS fallen (M103): identisch zu gift/03-index.gab, nur SCHREIBEND statt lesend.
static mut last : [u32; 64] = 0;
type Weit = u32 in 0 .. 127;

impl fn e1(i : Weit) effects { writes last } {
    last[i] = 1;
}
