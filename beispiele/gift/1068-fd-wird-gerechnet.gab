-- erwartet: D003
-- **Gift 1068 -- a descriptor does not compute.**
--
-- `Fd` (`beispiele/149`) is an opaque carrier: counts stay `u64`, flags
-- stay `u64`, and the two never meet in an operation. OR-ing a flag word
-- into a descriptor falls where it stands -- the same rule
-- `beispiele/gift/211` pins for its own carrier, here in the clothes the
-- open/read wrappers wear. What the wrappers may do instead stands beside
-- it: keep the descriptor a descriptor and pass the flag word as its own
-- parameter (`scheck` stays green: it hands on `fd` untouched and leaves
-- `kennzeichen` for the gate that takes it), and convert once, at the one
-- named wrap (`beispiele/149`'s `oeffnen`), into `Fd`.
--
-- (Review G04 F5, fix lane F5: the twin used to `return kennzeichen;` --
-- a flag word handed out AS a descriptor. Inside the module that conversion
-- is silent by design, `D004` stands at the wall, so it checked green, and
-- the file presented a forged descriptor as the honest alternative.)
--
-- The gate below is user-made down to the invented constants (`myabi`, number `101`): it stands so the file says what the computed value was
-- FOR. The refusal itself needs no gate -- `D003` bites at the `return`.

module gift::fd_wird_gerechnet {

opaque type Fd = u32;

assume linux_write_contract
    "Write keeps its contract on this machine."
    falsifier sonde_write;

syscall gate_lesen(fd : Fd, anzahl : u64) -> u64
    abi myabi arch x86_64 number 101
    regs in { rdi = fd, rsi = anzahl }
    regs out { rax }
    clobbers { rcx, r11 }
    errors {}
    effects { pure }
    costs <= 40 ops
    assume linux_write_contract falsifier sonde_write;

impl fn scheck(fd : Fd, kennzeichen : u32) -> Fd
    effects { pure }
    costs <= 4 ops
{
    return fd;
}

impl fn maske(fd : Fd, kennzeichen : u32) -> Fd
    effects { pure }
    costs <= 4 ops
{
    return fd | kennzeichen;
}

}
