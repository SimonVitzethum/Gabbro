-- erwartet: M104
--
-- Ein Fakt ueber eine GLOBALE Groesse stirbt beim Aufruf. Ein blosser Name ohne Punkt
-- und ohne Index sah lange lokal aus -- `static mut` erfuellt das.
--
-- Aus der Gegenpruefung vom 2026-08-14: diese Datei kam einmal mit 0 Fehlern
-- durch (MESSUNGEN.md). Sie steht hier, damit das Loch nicht zurueckkehrt.

module gift {

const GRENZE : u32 = 65535;
type Zaehler = u32 in 0 .. GRENZE;
static mut g : Zaehler = 5;
impl fn null() -> u32 effects { writes g } { g = 0; return 1; }
impl fn f1() effects { writes g } {
    if g >= 1 {
        null();
        g -= 1;
    }
}

}
