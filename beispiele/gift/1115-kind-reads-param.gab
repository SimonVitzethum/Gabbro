-- erwartet: N452 allein
-- **1115 -- the `child` path reads an unhanded parameter (lane 249).**
--
-- The gate is valid on purpose (`stack rsi`: bound, kept, answered --
-- `N446`/`N447` silent, and a gate stands behind the path, so `N450`
-- stays silent too). The path is well-formed beside it: no `return`
-- inside (`N448` silent) and every path ends in the never-returning
-- `ausgang` (`N449` silent). What falls is the spill read: `art` is a
-- caller parameter the gate never handed -- the call handed `stapel`
-- (the bare-place argument at the stack parameter), and `rdi` does not
-- travel to the handed stack. On the child path `art` is a dead slot.
--
-- Without this rule NOTHING falls -- the emitted C is a braced block
-- passing `art` on, and `cc -Werror` takes it. Same shape gate as
-- 1107-1114 (not the raw clone, `1000` not an OS number; `abi linux`
-- names the template the stub is written against, not a kernel table).

module gift1115 {

reason UebergabeFehler {
    KeinStapel = 1 "no stack was handed"
    exhaustive
}

assume faden_start_vertrag
    "The starter keeps its contract on this machine."
    falsifier sonde_faden_start;

syscall roher_start(art : u64, stapel : u64) -> u64 or UebergabeFehler
    abi linux arch x86_64 number 1000
    regs in { rdi = art, rsi = stapel }
    regs out { rax }
    stack rsi
    clobbers { rcx, r11 }
    errors { NSTACK => KeinStapel }
    effects { pure }
    costs <= 64 ops
    assume faden_start_vertrag falsifier sonde_faden_start;

extern fn ausgang(code : u64) -> never effects { diverges } costs <= 1 ops;

impl fn starter(art : u64, stapel : u64) -> u64
    effects { diverges }
{
    let v = roher_start(art, stapel) else (e) {
        match e {
            KeinStapel => { return 999; }
        }
    }
    if v == 0 {
        child {
            ausgang(art);
        }
    }
    return v;
}

}
