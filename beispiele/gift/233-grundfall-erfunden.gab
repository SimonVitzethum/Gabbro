-- erwartet: M121
-- **Gift 233 -- der `reason` steht da, der FALL nicht.**
--
-- Getrennt von `M126`, und das ist Absicht: *eine gemeinsame Meldung haette den Tippfehler
-- im Fallnamen wie eine fehlende Deklaration aussehen lassen.* Hier ist die Deklaration da
-- und vollstaendig; was fehlt, ist die eine Zeile, die der Rumpf nennt.
--
-- **Die Absage zaehlt die vorhandenen Faelle mit auf** -- eine Absage, die den Vorrat nennt,
-- kostet nichts und erspart das Nachschlagen.

module gift::grundfall_erfunden {

reason Buchfehler {
    Unbelegt     = 1 "der Platz war gar nicht belegt"
    Buchfuehrung = 2 "der Zaehler stand auf null"
    exhaustive
}

impl fn f(x : u32) -> u32 or Buchfehler effects { pure } costs <= 4 ops {
    if x == 0 {
        return Buchfehler::GibtsNicht;
    }
    return x;
}

}
