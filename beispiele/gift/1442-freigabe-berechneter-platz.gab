-- erwartet: N586
-- Only a bound name can die: a literal freed here would stay readable there,
-- and no name would carry the death. Nothing else is wrong with this unit.
module gift::freigabe_berechneter_platz {
arena Vorrat capacity 0 .. 4 of u64;

fn nutze() -> u64 effects { reads Vorrat, writes Vorrat } costs <= 128 ops {
    let a = alloc Vorrat (7) else { return 1; };
    free Vorrat[0];
    return Vorrat[a];
}
}
