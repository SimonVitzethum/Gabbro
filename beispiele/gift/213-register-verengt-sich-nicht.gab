-- erwartet: M103
-- **Gift 213 -- eine Registerstelle, die sich verengen liess.**
--
-- Bis zum 2026-08-20 ging das mit **0 Fehlern** durch: `if d.ST.IDX < 8` gab V1 eine
-- Schranke, und `T.slots[d.ST.IDX]` galt damit als gedeckt.
--
-- **Es sind ZWEI Lesungen.** Ein Register senkt zu `*(volatile uint32_t *)(basis + 0)` ab,
-- und `volatile` ist genau die Aussage *„das darf sich zwischen zwei Lesungen aendern."*
-- Das erzeugte C indizierte ein Feld mit acht Plaetzen mit einem Wert, den die Hardware
-- zwischen den beiden Zeilen frei setzt.
--
-- **Der Ordner beschrieb die richtige Regel und der Pruefer tat das Gegenteil:**
-- `PFLICHTEN.md` fuehrte «B33» als *„die V-Regeln verengen eine Registerstelle nicht"*.
-- *Eine Zusage, die kein Pass einloest, ist die stille Richtung.*
--
-- Die ehrliche Form steht in `beispiele/44-register-einmal-lesen.gab`: einmal in eine
-- lokale Bindung lesen, dann die Bindung verengen.

module gift213 {

device Statusgeraet(basis : u64) at mmio {
    reg ST : u32 @0x00 class r fields { IDX @[7:0] }
}

table Platz count 8 { slot { wert : u32, } }

impl fn lesen(d : Statusgeraet) -> u32
    effects { reads Statusgeraet, reads Platz }
    costs    <= 8 ops
{
    if d.ST.IDX < 8 { return Platz.slots[d.ST.IDX].wert; }
    return 0;
}

}
