-- erwartet: C001
-- **Gift 797 -- a checked syscall is refused at the emitter, by name.**
--
-- Until lane S5 this file fell at the parser (`P042`: specified, not yet
-- implemented). Since lane S5 the declaration CHECKS -- the register map, the
-- errno decoding, the machine and the named assumption all hold -- and what is
-- still missing is the lowering: the stub template (inline `syscall`, register
-- binding, clobbers) is lane S6's. The emitter refuses the unit with `C001`
-- instead of emitting a hand-written `asm` block for it.

module gift::syscall_emission_offen {

reason IoError {
    BadFd = 9 "the file descriptor is not open"
    exhaustive
}

assume linux_write_contract
    "Write keeps its contract on this machine."
    falsifier sonde_write;

syscall write(fd : u64) -> u64 or IoError
    abi linux arch x86_64 number 1
    regs in { rdi = fd }
    regs out { rax }
    clobbers { rcx, r11 }
    errors { EBADF => BadFd }
    effects { pure }
    assume linux_write_contract falsifier sonde_write;

}
