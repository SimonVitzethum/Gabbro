module gift974 {

impl fn arm(x : u32) -> u32 effects { pure } costs <= 2 ops { return x; }

axiom hol() -> fn(u32) -> u64 effects { pure } costs <= 2 ops effects { pure } unfalsifiable "probe";

impl fn f() -> u32 effects { pure } costs <= 8 ops {
    let p = hol();
