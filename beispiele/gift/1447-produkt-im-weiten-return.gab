// erwartet: M104
// return of `u32 * u32` at a `u64` result.
//
// The product of two `u32` values leaves 32 bits; the wider return type does not widen the
// operands. Bind each operand into `u64` first (example 1164).
module gift1447 {

pub fn prod(a : u32, b : u32) -> u64
    effects { pure }
    costs <= 4 ops
{
    return a * b;
}

}
