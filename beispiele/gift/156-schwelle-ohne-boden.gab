-- erwartet: N022
-- **Eine einseitige Schwelle ohne `floor`.**
--
-- Die Groesse hat nach unten keinen Bereich, und `0 >= 0` besteht jede Pruefung. *Der vierte
-- der vier versprochenen Fehler.*
module gift::schwelle_ohne_boden {

static mut k : u32 = 0;
impl fn tor() effects { reads k } costs <= 1 ops { return; }

check c {
    claim    "Eine Schwelle, unter der nichts steht."
    measures k
    gates    tor
    can_fail { if k >= 3 { return false; } return true; }
}

}
