-- erwartet: K003
--
-- Eine Kostenzusage ueber einem Aufruf, der selbst keine nennt. Die Zahl waere dann eine
-- Zahl ueber Unbekanntem -- entweder der Gerufene bekommt `costs`, oder der Rufer gibt
-- seine Zusage auf. Ein drittes gibt es nicht.

impl fn verspricht(x : u32) -> u32
    effects { reads welt }
    costs   <= 10 ops
{
    return fremd(x);
}

extern fn fremd(x : u32) -> u32 effects { reads welt };
