-- erwartet: N522
-- **1276 -- two pool instances, one cursor (lane 264, OFFEN O20 row 3).**
--
-- `concurrent { f, f }` runs `f` on two threads; both instances bump the
-- plain `used` word. `W001`/`W002` never pair a routine with itself, so the
-- pool shape is this rule's alone. Measured `["N522"]`. The admitted twins:
-- one lock protecting `A` taken inside both routines, or one arena per
-- routine (`paesse.rs`: `arena_zaehler_bewacht_sauber`).
module gift1276 {

arena A capacity 2 .. 8 of u16;

impl fn f() -> u32 effects { writes A } costs <= 64 ops {
    let i = alloc A (1) else {
        return 999;
    };
    let x : u32 = A[i];
    return x;
}

concurrent { f, f };

}
