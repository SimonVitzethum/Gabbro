-- erwartet: N240
-- **Shared-shared starts stay silent; the exclusive pair beside them falls.**
--
-- `read_a` and `read_b` both require `Held(L, shared)`: a shared lock exists
-- to be co-held, so N240 stays silent over the pair -- this is the rule's
-- deliberate boundary, and `H005` already tells the strengths apart. `read_c`
-- and `read_d` both require `Held(M)` EXCLUSIVELY: that pair falls with N240,
-- and the refusal names only `M`, never `L`. All four bodies only READ, so no
-- write-hull rule fires beside either pair: the refusal set is exactly
-- `[N240]`, and the shared pair inside it is the passing half of the probe.
module gift913 {

table T count 4 {
    slot { v : u32, }
}

table U count 4 {
    slot { v : u32, }
}

lock L protects { T } rank 0 held <= 100 ops;

lock M protects { U } rank 1 held <= 100 ops;

-- Must pass N240: both start holding `L` shared, and shared is co-holdable.
impl fn read_a() -> u32
    requires Held(L, shared)
    effects { reads T.slots }
    costs <= 4 ops
{
    return T.slots[0].v;
}

impl fn read_b() -> u32
    requires Held(L, shared)
    effects { reads T.slots }
    costs <= 4 ops
{
    return T.slots[1].v;
}

-- Must fall (N240, with each other): both start holding `M` exclusively.
impl fn read_c() -> u32
    requires Held(M)
    effects { reads U.slots }
    costs <= 4 ops
{
    return U.slots[0].v;
}

impl fn read_d() -> u32
    requires Held(M)
    effects { reads U.slots }
    costs <= 4 ops
{
    return U.slots[1].v;
}

concurrent { read_a, read_b };

concurrent { read_c, read_d };

}
