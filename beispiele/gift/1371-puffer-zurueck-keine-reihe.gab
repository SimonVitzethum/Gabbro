-- erwartet: N569
-- M-ALLTAG C: `reset X at i count n;` names something that is no `static` array
-- -- here a scalar. There is no run of bytes at a fixed address to give back
-- (positive twin: `beispiele/172`).
module beispiel::puffer_keine_reihe {
static mut ZAEHLER : u64 = 0;

impl fn f() -> u32 effects { writes ZAEHLER } costs <= 16 ops {
    reset ZAEHLER at 0 count 1;
    return 0;
}
}
