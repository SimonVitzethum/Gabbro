-- erwartet: N451
-- **1147 -- a caller `let` as a lock index on the child path (fix lane F3, review G11 F3).**
--
-- The emission walker reads the BODY of a `locks` block, never the lock
-- place: `locks S[w]` evaluates `w`, a caller temporary that died at the
-- gate. The exhaustive `kindzugriff` walk reads the lock place's indices.
-- The language declares no lock arrays, so an indexed lock place is refused
-- on its own today (`H016`, `E006` beside it); the probe pins that the spill
-- rule no longer leans on that -- the day a lock family lands, `N451` stands.

module gift1147 {

reason UebergabeFehler {
    KeinStapel = 1 "no stack was handed"
    exhaustive
}

assume faden_start_vertrag
    "The starter keeps its contract on this machine."
    falsifier sonde_faden_start;

syscall roher_start(art : u64, stapel : u64) -> u64 or UebergabeFehler
    abi linux arch x86_64 number 1000
    regs in { rdi = art, rsi = stapel }
    regs out { rax }
    stack rsi
    clobbers { rcx, r11 }
    errors { NSTACK => KeinStapel }
    effects { pure }
    costs <= 64 ops
    assume faden_start_vertrag falsifier sonde_faden_start;

extern fn ausgang(code : u64) -> never effects { diverges } costs <= 1 ops;

impl fn starter(art : u64, stapel : u64) -> u64
    effects { diverges }
{
    let w = art;
    let v = roher_start(art, stapel) else (e) {
        return 999;
    }
    if v == 0 {
        child {
            locks S[w] {
                ausgang(1);
            }
        }
    }
    return v;
}

}
