-- erwartet: C001
-- **1125 -- an in-range literal index checks clean (lane 256).**
--
-- The positive side of `N454`: literal `7` stands below the max 8, so
-- the index is accepted the M103 way. (The lowering lane owes the
-- exact-length side before it lowers any index.) The emitter stops the
-- unit with `C001`, so no C is written.

module gift1125 {
impl fn nimm(s: string max 8) -> u32
    effects { pure }
    costs <= 64 ops
{
    let c = s[7];
    return lenof(s);
}
}
