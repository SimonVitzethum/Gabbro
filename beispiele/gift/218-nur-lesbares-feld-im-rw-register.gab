-- erwartet: R006
-- **Gift 218 -- «B23»: das Feld traegt seine eigene Klasse, und sie ist die engere.**
--
-- `FSTS` ist `class rw` -- das ganze Wort darf gelesen und geschrieben werden. **`FRI` ist
-- es nicht:** 15:8 sind der Index, an dem der Treiber den Fehlereintrag findet, und den
-- setzt die Hardware.
--
-- Bis zum 2026-08-20 trug `regdecl` EINE Klasse fuer das ganze Wort. Damit war FRI
-- untypisierbar -- und FRI ist die Stelle, an der der Treiber ueberhaupt anfaengt.
--
-- *Eine Probe, die nur das Register trifft, misst nicht die Mischung.* Die saubere Seite
-- steht in `beispiele/45`.

module gift218 {

device Vtd(basis : u64) at mmio {
    reg FSTS : u32 @0x34 class rw fields { PFO @0 class w1c, FRI @[15:8] class r }
}

impl fn setzt_den_index(v : ptr<mmio, rw> Vtd)
    effects { writes v.FSTS }
    costs    <= 4 ops
{
    v.FSTS.FRI = 3;
}

}
