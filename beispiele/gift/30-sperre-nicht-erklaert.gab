-- erwartet: E006
--
-- Ein `locks`-Block im Rumpf, der in keiner Wirkung steht. Die Sperrordnung -- und damit
-- die Deadlockfreiheit -- faellt aus den ERKLAERTEN Sperren; ein Rumpf, der eine nimmt,
-- ohne sie zu nennen, nimmt sie ausserhalb der Ordnung.

lock KAPPEN protects { eintraege } rank 0 held <= 100 ops;

type Zelle = { wert : u32, };

impl fn heimlich(c : ptr<normal, rw> Zelle)
    effects { writes c }
{
    locks KAPPEN {
        c.wert = 0;
    }
}
