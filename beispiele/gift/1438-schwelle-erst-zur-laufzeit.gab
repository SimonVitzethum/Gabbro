-- erwartet: N585
-- The threshold stands only at run time (`n` is a parameter), so no emitted
-- comparison could hold the commit: the threshold is a translation-time
-- number or it is no threshold. Nothing else is wrong with this unit.
module beispiel::halde_schwelle_erst_zur_laufzeit {
arena Vorrat capacity 0 .. 2 of u64 druckfrage frei unter grenze;

impl fn frei() -> u64 effects { pure } costs <= 4 ops {
    return 99999999;
}

fn nutze(n : u64) -> u64 effects { reads Vorrat, writes Vorrat } costs <= 64 ops {
    let grenze = n;
    let a = alloc Vorrat (7) else { return 1; };
    return Vorrat[a] +% grenze;
}
}
