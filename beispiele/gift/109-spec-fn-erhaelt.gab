-- erwartet: M113
-- **Eine Spezifikation IST die Aussage.** `maintains` an einer `spec fn` ist eine Pflicht,
-- die kein Rumpf schuldet -- dieselbe Bauart wie `M110` (`result` an einer Funktion ohne
-- Ergebnis): eine Zusage ueber etwas, das an dieser Stelle nicht existiert.
module gift::spec_erhaelt {

table W count 8 {
    slot { a : u32 in 0 .. 10, }
    invariant klein cost O(n) runs offline :
        forall s in slots of W : W.slots[s].a <= 10;
}

spec fn alles_null() -> bool
    maintains klein
    effects { pure }
    = forall s in slots of W : W.slots[s].a == 0;

}
