-- erwartet: D012
--
-- **Die ZWEITE Voraussetzung von `umhaengen_erhaelt` fehlt: `¬ ueber σ p s`.**
--
-- Der neue Elter ist erreichbar -- das steht da, und es ist wortgleich die Zeile, die
-- `einhaengen` in `beispiele/47` traegt. Dass `s` nicht auf `p`s Elternkette liegt, steht
-- NICHT da, und ohne es faellt der Satz: `beweise/Table_Ops_Erhaltung.thy` fuehrt mit
-- `umhaengen_faellt` das Gegenbeispiel vor -- zwei Plaetze, einer unter den anderen gehaengt,
-- und **keiner der beiden** erreicht danach noch eine Wurzel.
--
-- *`G-1` sagt sogar genau, dass dieses Gegenbeispiel die HIER fehlende Voraussetzung ist und
-- keine andere:* `wohlgeformt zwei` und `erreicht zwei 1` gelten dort beide.
--
-- **Eine halbe Voraussetzung ist die gefaehrlichste Sorte** -- dieselbe Bauart wie Gift 323,
-- eine Operation weiter. Die saubere Seite steht in `beispiele/47` an `umhaengen`.

module gift::ohnekettenbedingung {

const N : u32 = 8;

table Ordner count N {
    const WURZEL : u32 = 0;

    tree { parent elter }

    slot {
        benutzt : bool,
        elter   : option index into Ordner,
    }

    ops insert, remove, relabel;

    occupied benutzt;

    invariant jeder_erreicht_die_wurzel cost O(n) runs offline :
        forall s in slots of Self : Self.slots[s] reaches WURZEL via elter;
}

impl fn umhaengen(o : ptr<normal, rw> Ordner,
                  s : index into Ordner,
                  p : index into Ordner)
    requires o.slots[p] reaches WURZEL via elter
    effects  { writes o.slots }
    costs    <= 6 ops
{
    Ordner::relabel(o, s, p);
}

}
