-- erwartet: H021
-- **A variant constructor is no call -- `Kurz(x)` names no function.**
--
-- The checker already refuses this shape, just not by a rule of its own: M1
-- types the unknown callee as untyped (`M1 saw 2 expressions, 1 of them
-- without a type`), the call graph finds no edge (`H021`), and the cost pass
-- finds no declaration (`K003` where costs are promised). The emitter is never
-- reached (`has errors -- no C written`), so no generic call text escapes --
-- and a `static` initialiser of the same shape, which no body pass visits,
-- is refused by the emitter instead (`C001`). This probe pins the body
-- direction: `H021` must fall wherever a variant is called like a function.
module gift::variant_constructor_is_no_call {

tagged type Nachricht = { Leer, Kurz(u32), Lang(u64) };

impl fn baue(x : u32) -> Nachricht
    effects { pure }
    costs   <= 4 ops
{
    return Kurz(x);
}

}
