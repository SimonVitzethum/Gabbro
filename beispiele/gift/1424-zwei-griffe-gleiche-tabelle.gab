-- erwartet: M147
-- **Aliased handles (Task 5d).** `t` and `u` are two `rw` handles of one
-- table; they may name the same table at run time, so a write through `u`
-- expires a value read through `t`. Carriers key by table since task 5d
-- (same-handle staleness already fell: `gift/702`).
module gift::zwei_griffe_gleiche_tabelle {

table T count 4 {
    slot {
        x : u32,
    }
}

impl fn f(t : ptr<normal, rw> T, u : ptr<normal, rw> T, i : index into T) -> u32
    effects { reads t.slots, writes u.slots }
    costs <= 64 ops
{
    let v : u32 = t.slots[i].x;
    u.slots[i].x = 1;
    if v == 0 { return 1; }
    return 0;
}

}
