// erwartet: N589
// **Poison 247 -- a `requires` at a function pointer type.**
//
// A pointer type is a signature (Lean: `Deklaration.passt`, `SigPasst`): a function fits
// where its own parameters, result and effects conform to it, and the model's signatures
// carry no contract. A `requires` here is a clause nobody could read, so it is refused at
// the clause (2026-10-21; TODO O43 names the missing model of a contravariant `requires`).

module gift::fnzeiger_mit_requires {

static mut ZUSTAND : u32 = 0;

type Treiber = {
    senden : fn(b : u8)
        requires b > 0
        effects { writes ZUSTAND }
        costs   <= 4 ops,
};

impl fn nutze(t : ptr<normal, r> Treiber)
    effects { reads t, writes ZUSTAND }
    costs   <= 8 ops
{
    t->senden(1);
}

}
