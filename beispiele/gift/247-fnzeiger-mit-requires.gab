-- erwartet: N295
-- **Poison 247 -- an indirect call that breaks the pointer type's `requires`.**
--
-- Until lane 177 this file fell at `N037`: a `requires` at the pointer type was refused
-- outright, on the ground that no pass read it. The reader is built now -- the slot's
-- `requires` is checked at the indirect call the way a callee's is checked at a direct
-- one (`M115`'s weak reading) -- so the file falls at the USE, not at the clause. The
-- literal `0` lies outside `b > 0` the way no range reasoning is needed to see.

module gift::fnzeiger_mit_requires {

static mut ZUSTAND : u32 = 0;

type Treiber = {
    senden : fn(b : u8)
        requires b > 0
        effects { writes ZUSTAND }
        costs   <= 4 ops,
};

impl fn nutze(t : ptr<normal, r> Treiber)
    effects { reads t, writes ZUSTAND }
    costs   <= 8 ops
{
    t->senden(0);
}

}
