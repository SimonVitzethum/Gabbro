-- erwartet: N585
-- The probe takes an argument, so a nullary commit-time call cannot ask it.
-- Nothing else is wrong with this unit.
module beispiel::halde_frage_mit_parameter {
arena Vorrat capacity 0 .. 2 of u64 pb zaehlt blw 1048576;

impl fn zaehlt(x : u64) -> u64 effects { pure } costs <= 4 ops {
    return x;
}

fn nutze() -> u64 effects { reads Vorrat, writes Vorrat } costs <= 64 ops {
    let a = alloc Vorrat (7) else { return 1; };
    return Vorrat[a];
}
}
