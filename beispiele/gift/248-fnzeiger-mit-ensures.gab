// erwartet: N589
// **Poison 248 -- an `ensures` at a function pointer type.**
//
// The twin of `gift/247` on the other clause: a covariant `ensures` at the type has no
// model either (TODO O43), so the answer of an indirect call is the declared type and no
// more, and the clause is refused where it stands (2026-10-21).

module gift::fnzeiger_mit_ensures {

static mut ZUSTAND : u32 = 0;

type Treiber = {
    senden : fn(b : u8) -> bool
        ensures result == true
        effects { writes ZUSTAND }
        costs   <= 4 ops,
};

impl fn nutze(t : ptr<normal, r> Treiber, b : u8)
    effects { reads t, writes ZUSTAND }
    costs   <= 8 ops
{
    let ok = t->senden(b);
}

}
