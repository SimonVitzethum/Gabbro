-- erwartet: M147
-- **V4 freshness across a DIRECT call, MUST-FAIL: the callee's writes-hull expires the caller's taint.**
--
-- `alt` is read from carrier `ZUSTAND`, then `schreiber()` runs -- whose declared
-- `effects { writes ZUSTAND }` names that carrier -- and deciding on `alt`
-- afterwards falls as `M147`. The transport is the callee's declared writes-hull
-- read at the call edge (`m1.rs` `rufe_toeten_fakten` / `geschriebene_orte`):
-- a direct call expires only what the hull names. The disjoint half (a hull
-- naming another carrier expires nothing) is pinned by gift/753; the
-- refresh/store boundary by gift/754. The indirect-call shape, which names no
-- hull and expires everything, is pinned by gift/715.
module gift752 {

static mut ZUSTAND : u32 = 0;

impl fn schreiber()
    effects { writes ZUSTAND }
    costs <= 4 ops
{
    ZUSTAND = 1;
}

impl fn entscheide() -> u32
    effects { reads ZUSTAND, writes ZUSTAND }
    costs <= 32 ops
{
    let alt : u32 = ZUSTAND;
    schreiber();
    if alt != 0 { return 1; }
    return 0;
}

}
