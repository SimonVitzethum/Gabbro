-- erwartet: M152
-- **M152 must-pass twins beside the falling site: the rule reads facts, not
-- declarations.**
--
-- `eng` narrows the denominator away from `-1`, so nothing can trap. `klein`
-- narrows the dividend away from the smallest value, so `-1` divides
-- everything left. `offen` carries neither fact and falls. One file, both
-- directions.
module gift765 {

impl fn eng(x : i32, y : i32 in 1 .. 100) -> i32 effects { pure } {
    return x % y;
}

impl fn klein(x : i32 in -100 .. 100, y : i32 in -1 .. -1) -> i32 effects { pure } {
    return x % y;
}

impl fn offen(x : i32, y : i32 in -1 .. -1) -> i32 effects { pure } {
    return x % y;
}

}
