-- erwartet: M147
-- **V4 freshness across a TRANSITIVE call chain, MUST-FAIL: the mid's declared hull expires the caller's taint.**
--
-- `alt` is read from carrier `ZUSTAND`, then `mitte()` runs -- which calls
-- `schreiber()`, whose declared `effects { writes ZUSTAND }` names that carrier,
-- and `mitte` itself declares `effects { writes ZUSTAND }` covering it (`E008`
-- reconciles each body hull against its declared list) -- and deciding on `alt`
-- afterwards falls as `M147`. The transport is the same as gift/752's: the
-- callee's declared writes-hull read at the call edge (`m1.rs`
-- `rufe_toeten_fakten` / `geschriebene_orte`). The one-hop shape is pinned by
-- gift/752; this file pins that the identical kill fires one hop further out,
-- through a mid whose declaration covers its callee's write. The disjoint half
-- (a chain naming another carrier expires nothing) is pinned by gift/770; the
-- refresh/store boundary by gift/771.
module gift769 {

static mut ZUSTAND : u32 = 0;

impl fn schreiber()
    effects { writes ZUSTAND }
    costs <= 4 ops
{
    ZUSTAND = 1;
}

impl fn mitte()
    effects { writes ZUSTAND }
    costs <= 8 ops
{
    schreiber();
}

impl fn entscheide() -> u32
    effects { reads ZUSTAND, writes ZUSTAND }
    costs <= 32 ops
{
    let alt : u32 = ZUSTAND;
    mitte();
    if alt != 0 { return 1; }
    return 0;
}

}
