-- erwartet: M104
-- **No declared context, no widening.** `u32 + u32` as an operand of
-- an `if` condition is typed bottom-up in the operands width, exactly
-- as before the breiter-Kontext rule (which only fires where a declared
-- integer type stands behind the whole arithmetic value).
module gift::bedingung_ohne_kontext {

pub fn f(a : u32, b : u32) -> u32
    effects { pure }
    costs <= 8 ops
{
    if a + b == 0 {
        return 0;
    }
    return 1;
}

}
