-- erwartet: N521
-- **1274 -- a member's `reset` beside a started root's use (lane 264).**
--
-- The started root `leser` allocates and reads while the concurrent member
-- `setzer` resets. `N462` resolves no arena `writes` (its carriers are
-- tables), so the sharing start root is this rule's alone; the setter
-- resets only, so `N522` stays silent beside it. Measured `["N521"]`.
module gift1274 {

arena A capacity 2 .. 8 of u16;

impl fn leser() effects { writes A, reads A } costs <= 64 ops {
    let i = alloc A (1) else {
        return;
    };
    let x : u32 = A[i];
    if x == 0 {
        return;
    }
}

impl fn setzer() -> u32 effects { writes A } costs <= 64 ops {
    reset A;
    return 0;
}

impl fn starter() effects { writes A, reads A } costs <= 128 ops {
    start { leser };
}

concurrent { setzer };

}
