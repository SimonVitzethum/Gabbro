-- erwartet: P002
-- **Wo kein Nachbarwort als Name taugt, schweigt die Absage.**
--
-- `None` ist reserviert, und kein Wort mit derselben Initiale im Abstand zwei ist ein
-- Name. Die Gegenprobe zu `698`: die Absage faellt mit `P002`, ohne etwas vorzuschlagen.
module gift {

impl fn nehmen() -> u32 effects { pure } {
    let None = 1;
    return 0;
}

}
