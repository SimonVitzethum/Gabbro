-- erwartet: N577
-- **An `entry fn` is not handed on inside a loop.**
--
-- One mention of the parameter, so a count of mentions alone would pass it -- but the loop
-- runs the hand-over up to four times, and with it the root on up to four threads at once.
-- The rule holds the hand-over outside every loop (C-free lane, C2 slice 3).
module gift::eintritt_in_schleife {

assume start_vertrag
    "`fremd_start` runs `lauf` once on a new thread, or answers 1 and runs nothing."
    falsifier sonde_start;

pub table Versuche count 4 {
    slot { getan : u64, }
}

extern fn fremd_start(lauf : entry fn(ptr<normal, rw> u8) -> i32) -> u32
    effects { pure }
    costs <= 1000 ops;

pub fn starte(lauf : entry fn(ptr<normal, rw> u8) -> i32) -> u32
    effects { reads Versuche, reads Versuche.slots, writes Versuche.slots }
    costs <= 5000 ops
{
    traverse i over slots of Versuche by unvisited {
        Versuche.slots[i].getan = 1;
        let r = fremd_start(lauf);
    }
    return 0;
}

}
