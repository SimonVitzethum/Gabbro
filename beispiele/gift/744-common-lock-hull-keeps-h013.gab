-- erwartet: H013
-- **Footprints from effects under a common lock hull (`Geteilt.Bau` probe 2/3).**
--
-- Both entries write the unshared `static mut z` DIRECTLY -- no call hop, so the
-- footprint the Bau carries (`schreibtFn`, read off the declared `writes` lines
-- as `fussAus` reads `D.schreibt`) is the whole story. Both hulls also carry
-- `locks L`, taken around each write: the pair level is lock-shared, so the
-- interference rules stay silent -- but `H013` does not read locks, and the W5
-- answer beside it does not either. Both refuse the same carrier for the same
-- reason: written through entries, declared shared nowhere. The twin `ruhig`
-- writes the lock's own table under its guard and stands in no entry.
module gift::bau_common_lock_hull {

static mut z : u32 = 0;

table T count 8 {
    slot {
        v : u32,
    }
}

lock L protects { T } rank 0 held <= 100 ops;

impl fn links() effects { writes z, locks L } costs <= 16 ops { locks L { z = 1; } }

impl fn rechts() effects { writes z, locks L } costs <= 16 ops { locks L { z = 2; } }

entry syscall_a vector 0x80 arch x86_64 {
    regs in  { }
    regs out { }
    preserves { rbx }
    clobbers  { rcx }
    stack ka per cpu nested never
    dispatch gift::bau_common_lock_hull::links;
}

entry syscall_b vector 0x81 arch x86_64 {
    regs in  { }
    regs out { }
    preserves { rbx }
    clobbers  { rcx }
    stack kb per cpu nested never
    dispatch gift::bau_common_lock_hull::rechts;
}

-- Must pass: every write under the guard the line names, and no entry reaches it.
impl fn ruhig(j : index into T, m : index into T)
    effects { writes T.slots, locks L }
    costs   <= 16 ops
{
    locks L {
        T.slots[j].v = 0;
        T.slots[m].v = 1;
    }
}

}
