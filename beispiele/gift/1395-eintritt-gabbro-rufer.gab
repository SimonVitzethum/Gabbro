-- erwartet: N576
-- **A function that takes an `entry fn` is named by no Gabbro source.**
--
-- `starte` hands its `entry fn` on to the foreign start, as the rule asks. But `weiter` CALLS it
-- -- and a Gabbro caller has no code of its own to hand: the only values of the type are the
-- designators a generated driver writes around declared roots (C-free lane, C2 slice 3). Here
-- the caller forwards its own parameter, so even this call is code from nowhere: `weiter` has
-- no caller either, and every chain of such forwards ends at a Gabbro call site or at the
-- driver. Only the driver may stand at its head.
module gift::eintritt_gabbro_rufer {

assume start_vertrag
    "`fremd_start` runs `lauf` once on a new thread, or answers 1 and runs nothing."
    falsifier sonde_start;

extern fn fremd_start(lauf : entry fn(ptr<normal, rw> u8) -> i32) -> u32
    effects { pure }
    costs <= 1000 ops;

pub fn starte(lauf : entry fn(ptr<normal, rw> u8) -> i32) -> u32
    effects { pure }
    costs <= 1100 ops
{
    return fremd_start(lauf);
}

pub fn weiter(lauf : entry fn(ptr<normal, rw> u8) -> i32) -> u32
    effects { pure }
    costs <= 1200 ops
{
    return starte(lauf);
}

}
