-- erwartet: N456
-- **1141 -- a `child` started inside `locks L` (fix lane F3, review G11 F2).**
--
-- The review's scenario, verbatim: `locks L { g = 1; child { g = 2; ausgang(0); } }`.
-- Until fix lane F3 every held-set walker carried the parent's `locks L` into the
-- child, so `g = 2` counted as guarded -- but the child runs BESIDE the parent and
-- holds nothing: once lowered, it writes an `L`-guarded carrier without `L` while
-- the parent keeps writing it. Two lines fall now: `N456` (a child inside a
-- holding context) and `H007` (`g` is protected by `L`, and the child path does
-- not hold it -- the `H007` walk starts the child with an empty held set).

module gift1141 {

reason UebergabeFehler {
    KeinStapel = 1 "no stack was handed"
    exhaustive
}

assume faden_start_vertrag
    "The starter keeps its contract on this machine."
    falsifier sonde_faden_start;

syscall roher_start(art : u64, stapel : u64) -> u64 or UebergabeFehler
    abi linux arch x86_64 number 1000
    regs in { rdi = art, rsi = stapel }
    regs out { rax }
    stack rsi
    clobbers { rcx, r11 }
    errors { NSTACK => KeinStapel }
    effects { pure }
    costs <= 64 ops
    assume faden_start_vertrag falsifier sonde_faden_start;

extern fn ausgang(code : u64) -> never effects { diverges } costs <= 1 ops;

static mut g : u64 = 0;
lock L protects { g } rank 0 held <= 100 ops;

impl fn starter(art : u64, stapel : u64) -> u64
    effects { writes g, locks L, diverges }
{
    let v = roher_start(art, stapel) else (e) {
        return 999;
    }
    locks L {
        g = 1;
        child {
            g = 2;
            ausgang(0);
        }
    }
    return v;
}

}
