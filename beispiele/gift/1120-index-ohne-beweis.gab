-- erwartet: N454
-- **1120 -- computed index into a bounded string proves nothing (lane 256).**
--
-- No fact shows that `i` stands below the length `s` happens to hold, so
-- the index is refused (`N454`) -- even though `i` is narrowed to `0 .. 100`
-- and the max is 8. Since fix lane F6 a guard proves it
-- (`if i < lenof(s) { … s[i] … }`, `gift/1159`); a range or the max never
-- does.

module gift1120 {
impl fn nimm(s: string max 8, i: u32 in 0 .. 100) -> u32
    effects { pure }
    costs <= 64 ops
{
    let c = s[i];
    return lenof(s);
}
}
