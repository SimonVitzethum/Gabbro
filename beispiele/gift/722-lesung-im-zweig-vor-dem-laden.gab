-- erwartet: V007
-- **Die Leseseite steigt nicht ab.** `V006` faengt seit `gift/186` ein Schreiben, das
-- hinter einem release-Speichern im ZWEIG steht -- weil `schreibziele` in Unterbloecke
-- absteigt. Die Lesung sammelte nur `eigene_ausdruecke`: ein Lesen, das VOR dem `awaits`
-- in einem frueheren Zweig steht, erreichte `gelesen` nie, und `V007` schwieg. Dieselbe
-- Frage, dieselbe Antwort -- die Leseseite bekommt ihren Abstieg.
--
-- Die Gegenprobe liest ERST nach der Erwerbung und schweigt.
module gift::lesung_im_zweig_vor_dem_laden {

static mut n : u32 = 0;
static mut k : u32 = 0;
atomic F : bool release;
atomic G : bool release;

impl fn w(v : u32) effects { writes n, publishes F } costs <= 8 ops
{ n = v; F = true publishes { n }; }

-- Muss fallen: `vorher` wird vor der Erwerbung gelesen -- nur steht die Lesung einen
-- Zweig frueher als das Laden.
impl fn r(v : u32) -> u32 effects { reads F, reads n } costs <= 16 ops
{
    if v > 0 {
        let vorher = n;
        if vorher > 0 {
            return vorher;
        }
    }
    let f = F awaits { n };
    if f { return n; }
    return 0;
}

-- Gegenprobe, muss schweigen: dieselbe Lesung, aber NACH dem `awaits`.
impl fn wg(v : u32) effects { writes k, publishes G } costs <= 8 ops
{ k = v; G = true publishes { k }; }

impl fn g(v : u32) -> u32 effects { reads G, reads k } costs <= 16 ops
{
    let f = G awaits { k };
    if v > 0 {
        if f { return k; }
    }
    if f { return k; }
    return 0;
}

}
