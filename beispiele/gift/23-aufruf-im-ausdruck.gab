-- erwartet: M104
--
-- `let t = nuller(z);` ist derselbe Aufruf wie `nuller(z);`. Lange toetete nur die
-- zweite Form Fakten: ein Zeichen Unterschied entschied ueber die Zusage.
--
-- Aus der Gegenpruefung vom 2026-08-14: diese Datei kam einmal mit 0 Fehlern
-- durch (MESSUNGEN.md). Sie steht hier, damit das Loch nicht zurueckkehrt.

-- MUSS fallen: `nuller(z)` setzt z.wert auf 0. Der Fakt ueber `z.wert` (FELDzugriff!) muss
-- laut MESSUNGEN.md bei JEDEM Aufruf sterben.
module gift {

const GRENZE : u32 = 65535;
type Zaehler = u32 in 0 .. GRENZE;

impl fn nuller(z : ptr<normal, rw> Zelle) -> u32 effects { writes z } {
    z.wert = 0;
    return 7;
}

impl fn m1(z : ptr<normal, rw> Zelle) effects { writes z } {
    if z.wert >= 1 {
        let t : u32 = nuller(z);
        z.wert -= 1;
    }
}

type Zelle = { wert : Zaehler, };

}
