-- erwartet: H019
-- **The boundary: `reads` covers no contract read, and locals are no carriers (hG shape).**
--
-- The frame `H019` holds the contract against is the WRITE frame. `grenzt_lesung_aus`
-- reads the global `stand` with `reads stand` declared -- the read side is covered, the
-- write side is not -- and still falls with `H019`. `grenzt_nur_lokal` reads nothing but
-- its own parameter and stays silent: parameters, `result` and bound names are no
-- carrier reads, so there is no footprint to hold against any frame.
module gift736 {

static mut stand : u32 = 0;

table Kappe count 8 {
    slot {
        x : u32,
    }
}

-- Must fall: `requires` reads `stand`, declared under `reads` but written nowhere.
impl fn grenzt_lesung_aus(j : index into Kappe)
    requires stand >= 1
    effects { reads stand, writes Kappe.slots }
    costs <= 16 ops
{
    if stand >= 1 {
        Kappe.slots[j].x = 1;
    } else {
        Kappe.slots[j].x = 0;
    }
}

-- Must pass: the same clause shape over a parameter only -- no carrier, no frame.
impl fn grenzt_nur_lokal(x : u32, j : index into Kappe)
    requires x >= 1
    effects { writes Kappe.slots }
    costs <= 16 ops
{
    Kappe.slots[j].x = x;
}

}
