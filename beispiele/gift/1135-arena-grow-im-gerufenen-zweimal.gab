-- erwartet: N426
-- Fix lane F2 (review G08 F1): one `grow A by 8` in a callee, and a caller
-- that calls it twice. The body alone fits `max 16` over the floor `8`;
-- the second call does not. The callee's per-invocation bound (`8`) is
-- added at every call site, so the run may commit `16` over the floor, and
-- the commit inside the callee is refused. Nothing else is wrong.
module gift::arena_grow_im_gerufenen {
arena A capacity 2 .. 8 max 16 of u16;
impl fn g() -> u32 effects { writes A } costs <= 64 ops {
    grow A by 8 else {
        return 1;
    };
    return 0;
}
impl fn h() -> u32 effects { writes A } costs <= 256 ops {
    let x = g();
    let y = g();
    return x | y;
}
}
