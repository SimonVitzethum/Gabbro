-- erwartet: E221
-- **An `ensures` that reads a written carrier without cover falls.**
--
-- The `ensures` leg of the same frame promise: `ungedeckt` reads `zaehler`
-- (next to `result`, which is no read) while `zaehler` is written below and
-- uncovered. `gedeckt` covers it with `writes` -- reads OR writes close the
-- rule -- and stays silent.
module gift::vertrag_fuss_ensures {

static mut zaehler : u32 = 0;

-- Must fall: the `ensures` reads a carrier the effects do not cover.
impl fn ungedeckt() -> u32
    ensures result == zaehler
    effects { pure }
    costs   <= 8 ops
{
    return 0;
}

-- Must pass: the same read covered by `reads` beside `writes` (the body reads
-- `zaehler` back, and reads need their own cover -- E010, not this rule).
impl fn gedeckt() -> u32
    ensures result == zaehler
    effects { reads zaehler, writes zaehler }
    costs   <= 8 ops
{
    zaehler = 41;
    return zaehler;
}

-- The writer that makes `zaehler` non-read-only.
impl fn schreibt() effects { writes zaehler } costs <= 8 ops
{
    zaehler = 1;
}

}
