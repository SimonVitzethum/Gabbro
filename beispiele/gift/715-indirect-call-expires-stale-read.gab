-- erwartet: M147
-- **V4 freshness across an indirect call, MUST-FAIL: a stale decision after `t->ruf()`.**
--
-- `alt` is read from carrier `ZUSTAND`, then an indirect statement-call runs.
-- No path names the callee, so M1 cannot read a writes-hull -- and the coarse
-- rule that already kills every non-local V1 fact here must expire every V4
-- taint with it. Deciding on `alt` afterwards falls as `M147`. A direct call
-- with a readable hull expires only what the callee can touch; an indirect
-- call can touch anything, so it expires everything.
module gift715 {

static mut ZUSTAND : u32 = 0;

type Treiber = {
    ruf : fn()
        effects { writes ZUSTAND }
        costs   <= 4 ops,
};

impl fn entscheide(t : ptr<normal, r> Treiber) -> u32
    effects { reads t, reads ZUSTAND, writes ZUSTAND }
    costs <= 32 ops
{
    let alt : u32 = ZUSTAND;
    t->ruf();
    if alt != 0 { return 1; }
    return 0;
}

}
