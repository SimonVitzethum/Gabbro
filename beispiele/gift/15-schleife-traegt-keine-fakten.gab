-- erwartet: M104
-- **Schleifen tragen keine Fakten hinein.** Was vor der Schleife geprueft wurde, gilt in
-- ihrem Rumpf nicht -- das traegt die Invariante der Traversierung, und die gehoert dem
-- Beweiser, nicht M1.
const GRENZE : u32 = 65535;
type Zaehler = u32 in 0 .. GRENZE;

impl fn schleifen(z : ptr<normal, rw> Zelle, c : ptr<normal, rw> T)
    effects { writes z, writes c }
{
    if z.wert >= 1 {
        traverse s over slots of c by unvisited touches writes c.slots {
            z.wert -= 1;
        }
    }
}

type Zelle = { wert : Zaehler, };
