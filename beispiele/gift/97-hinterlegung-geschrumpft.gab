-- erwartet: M108
-- **Die Gefahr ist nicht das Wachsen, sondern das SCHRUMPFEN.**
--
-- Die Tatsache `i < hinterlegt` wird gewonnen -- und dann faellt die Hinterlegung. Danach
-- gilt sie nicht mehr, und es braucht dafuer KEINE Monotonieregel: ein Schreiben loescht
-- jede Tatsache, die auf ihm ruht, wie fuer jeden anderen Fakt auch.
module gift::schrumpf {

static mut hinterlegt : u32 in 0 .. 1024 = 0;

table Halde count 1024 backed hinterlegt { slot { wert : u64, } }

impl fn schrumpf(h : ptr<normal, r> Halde, i : index into Halde) -> u64
    effects { reads h.slots, reads hinterlegt, writes hinterlegt } costs <= 8 ops
{
    narrow i to 0 ..< hinterlegt else { return 0; }
    hinterlegt = 0;
    return h.slots[i].wert;
}

}
