-- erwartet: M103
-- **«C1» -- ein `option index into T` wird als Index benutzt, ohne ge`match`t zu sein.**
--
-- Das ist die zweite Haelfte von `option.sonderwert`, und sie stand bis zum 2026-08-19 als
-- OFFEN in der Schablonenliste -- mit der Begruendung, der Erzeuger weigere sich ohnehin fuer
-- `None` als Ausdruck. **Seit «C1» weigert er sich nicht mehr**: `T_NONE` steht wirklich im
-- erzeugten C. Damit war die Begruendung verbraucht und die Luecke lebendig.
--
-- Gemessen am selben Tag, vor der Regel: `h.slots[frei].kopf` -- **null Fehler**, und `frei`
-- kann `count` sein. Im erzeugten C waere das ein Zugriff einen Slot hinter dem Feld.
--
-- Die Regel ist keine neue: `option index into T` reicht bis `N`, `index into T` bis `N-1`.
-- *Es waren bis heute derselbe Typ mit demselben Bereich* -- der Sonderwert war unsichtbar.
module gift::option_als_index {

table Halde count 8 {
    slot {
        kopf    : u64,
        naechst : option index into Halde,
    }
}

static mut frei : option index into Halde = None;

impl fn lesen(h : ptr<normal, r> Halde) -> u64
    effects { reads frei, reads h.slots }
    costs   <= 3 ops
{
    -- `frei` muss erst ge`match`t werden. Der `Some`-Zweig bindet einen gueltigen Index.
    return h.slots[frei].kopf;
}

}
