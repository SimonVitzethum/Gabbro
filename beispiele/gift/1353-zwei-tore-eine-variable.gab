-- erwartet: N562
-- Gift 1353 -- **Two gates on one system-call variable.** A binding's register map names ONE gate's
-- parameters; a second gate on the same variable would read a map written for the first
-- (OFFEN O31).

module gift::zwei_tore_eine_variable {

reason IoError {
    BadFd = 9 "the file descriptor is not open"
    exhaustive
}

assume linux_write_contract
    "Write keeps its contract on this machine."
    falsifier sonde_write;

assume metal_kernel_contract
    "The image's kernel entry keeps the Linux x86_64 convention for the numbers it serves."
    falsifier sonde_metall_systemruf;

syscall sys_write;

syscall write(fd : u64) -> u64 or IoError
    via sys_write
    effects { pure }
    costs <= 8 ops;

syscall write2(fd : u64) -> u64 or IoError
    via sys_write
    effects { pure }
    costs <= 8 ops;

target linux_x86_64 abi linux arch x86_64 {
    sys_write = number 1
        regs in { rdi = fd }
        regs out { rax }
        clobbers { rcx, r11 }
        errors { EBADF => BadFd }
        assume linux_write_contract falsifier sonde_write;
}

}
