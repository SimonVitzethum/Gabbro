-- erwartet: N511
-- **Lane 263 (OFFEN O12) -- a callee overwriting a promised cell after the promise.**
--
-- `setze` promises both slots, but `stoere` writes `konto.slots` afterwards and
-- promises nothing. Order matters: the same two calls in the other order would
-- hold. The refusal names the `release` exit and both cells, whose promised
-- values the later write killed.
module gift::ruf_nach_versprechen_schreibt {

type Stand = u32 in 0 .. 100;

table konto count 2 {
    slot {
        stand : Stand,
    }
}

lock L protects { konto } rank 0 held <= 100 ops
    invariant konto.slots[0].stand == konto.slots[1].stand;

impl fn setze(x : Stand)
    requires Held(L), konto.slots[0].stand == konto.slots[1].stand
    ensures  konto.slots[0].stand == konto.slots[1].stand && konto.slots[0].stand == x
    effects  { reads konto.slots, writes konto.slots, locks L }
    costs    <= 64 ops
{
    konto.slots[0].stand = x;
    konto.slots[1].stand = x;
}

impl fn stoere()
    requires Held(L)
    effects  { writes konto.slots, locks L }
    costs    <= 32 ops
{
    konto.slots[1].stand = 3;
}

impl fn haupt()
    effects  { reads konto.slots, writes konto.slots, locks L }
    costs    <= 512 ops
{
    locks L {
        setze(30);
        stoere();
    }
}

}
