-- erwartet: M147
-- **V4 freshness across a TRANSITIVE call chain, the disjoint boundary: a chain naming another carrier expires nothing.**
--
-- `intakt` reads `alt` from `ZUSTAND` and calls `mitte_fremd`, whose chain writes
-- only `ANDERE` (`fremd` declares `effects { writes ANDERE }`, `mitte_fremd`
-- declares the same covering it) -- so `alt` stays fresh and deciding on it stays
-- silent. `faellig` is the control: the same read, but `mitte`'s chain names
-- `ZUSTAND`, so the decision falls as `M147`. A run over this file must report
-- `M147` at the control only -- the silent arm is the pin this file owes:
-- carrier granularity at the call edge, one hop further out, no path overlap,
-- syntax only. The one-hop shape of this boundary is pinned by gift/753.
module gift770 {

static mut ZUSTAND : u32 = 0;
static mut ANDERE : u32 = 0;

impl fn fremd()
    effects { writes ANDERE }
    costs <= 4 ops
{
    ANDERE = 1;
}

impl fn mitte_fremd()
    effects { writes ANDERE }
    costs <= 8 ops
{
    fremd();
}

impl fn schreiber()
    effects { writes ZUSTAND }
    costs <= 4 ops
{
    ZUSTAND = 1;
}

impl fn mitte()
    effects { writes ZUSTAND }
    costs <= 8 ops
{
    schreiber();
}

impl fn intakt() -> u32
    effects { reads ZUSTAND, writes ANDERE }
    costs <= 32 ops
{
    let alt : u32 = ZUSTAND;
    mitte_fremd();
    if alt != 0 { return 1; }
    return 0;
}

impl fn faellig() -> u32
    effects { reads ZUSTAND, writes ZUSTAND }
    costs <= 32 ops
{
    let alt : u32 = ZUSTAND;
    mitte();
    if alt != 0 { return 1; }
    return 0;
}

}
