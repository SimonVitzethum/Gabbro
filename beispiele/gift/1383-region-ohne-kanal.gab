-- erwartet: C186
-- **A region gate without its `or R` channel falls at the emitter.**
--
-- The checker has nothing against the declaration: a gate may answer a pointer. But the
-- kernel's refusals are negative words, and a gate with no channel could send them only to the
-- hardware stop -- a gate that hands over memory CAN refuse, and the refusal must reach the
-- program's `else` (`tor.region`, `emit.rs` `Antwort::Region`).
module gift::region_ohne_kanal {

pub reason MapFehler {
    Nomem = 12 "no memory for the mapping"
    Inval = 22 "an argument the kernel refuses"
    exhaustive
}

pub reason SchreibFehler {
    BadFd = 9 "the file descriptor is not open"
    exhaustive
}

assume linux_seiten_holen
    "The Linux x86_64 anonymous-mapping call (number 9) with `fd` = -1 and the flags private and anonymous (34) answers the base of at least `len` fresh bytes, readable and writable, reading as zero and shared with no other mapping, or -errno; it destroys only rcx and r11."
    falsifier sonde_seiten_holen;

assume linux_write
    "The Linux x86_64 `write` reads exactly `len` bytes from `buf`, answers the count written or -errno, and destroys only rcx and r11."
    falsifier sonde_write;

assume linux_exit_group
    "The Linux x86_64 `exit_group` ends every thread of the process with status `code & 255` and never returns to its caller."
    falsifier sonde_exit_group;

syscall seiten_holen(addr : u64, len : u64, prot : u64, flags : u64, fd : u64, off : u64) -> ptr<normal, rw> u8
    abi linux arch x86_64 number 9
    regs in { rdi = addr, rsi = len, rdx = prot, r10 = flags, r8 = fd, r9 = off }
    regs out { rax }
    clobbers { rcx, r11 }
    errors { }
    ensures len <= lenof(result)
    effects { pure }
    costs <= 8 ops
    assume linux_seiten_holen falsifier sonde_seiten_holen;

syscall write(fd : u64, buf : ptr<normal, r> u8, len : u64) -> u64 or SchreibFehler
    abi linux arch x86_64 number 1
    regs in { rdi = fd, rsi = buf, rdx = len }
    regs out { rax }
    clobbers { rcx, r11 }
    errors { EBADF => BadFd }
    requires len <= lenof(buf)
    effects { reads buf }
    costs <= 8 ops
    assume linux_write falsifier sonde_write;

syscall exit_group(code : u64) -> never
    abi linux arch x86_64 number 231
    regs in { rdi = code }
    regs out { rax }
    clobbers { rcx, r11 }
    errors { }
    effects { diverges }
    costs <= 8 ops
    assume linux_exit_group falsifier sonde_exit_group;

pub const SEITE : u64 = 4096;
pub const LESEN_SCHREIBEN : u64 = 3;
pub const PRIVAT_ANONYM : u64 = 34;
pub const KEINE_DATEI : u64 = 0xFFFFFFFFFFFFFFFF;

pub fn main() -> never
    effects { diverges }
    costs   <= 100 ops
{
    exit_group(0);
}

}
