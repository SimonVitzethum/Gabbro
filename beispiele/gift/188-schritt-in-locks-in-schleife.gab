-- erwartet: O006
-- **Ein `locks { }` machte `O006` stumm.**
--
-- `enthaelt_schritt` sah nur die OBERSTE Ebene des Schleifenrumpfs, und von den Anweisungen
-- dort nur `Ruf` und ein `Let` mit direktem Ruf. Ein `locks { }` um denselben Schritt
-- genuegte.
--
-- > Eine Regel, die an der Einrueckung endet, ist keine Regel ueber den Fluss.
--
-- Der Fall lag einen syntaktischen Schritt neben der kanonischen Form.

module gift {

linear ghost type Phase order { roh, mmu };

static mut mmu_an_zahl : u32 = 0;

table Puffer count 4 { slot { a : u32, } }

lock L protects { Puffer } rank 1 held <= 40 ops;

extern fn mmu_an(p : Phase) -> Phase
    ensures  mmu_an_zahl == 1
    advances roh -> mmu
    effects  { consumes p, writes mmu_an_zahl } costs <= 4096 ops;

assume irgendwas
    "Irgendetwas ausserhalb dieser Einheit bewegt sich bei jedem Durchlauf."
    falsifier sonde_irgendwas;

extern fn aufgeben() -> never effects { diverges };

impl fn hochlauf(p : Phase)
    advances roh -> mmu
    effects { consumes p, writes mmu_an_zahl, locks L }
    costs   <= 32768 ops
{
    retry warten until false
        bounded 4096 ops
        progress irgendwas
        on_exceeded aufgeben
        effects { consumes p, writes mmu_an_zahl, locks L }
    {
        locks L {
            let p1 = mmu_an(p);
        }
    }
}

}
