-- erwartet: M147
-- **V4 freshness across a TRANSITIVE call chain, the refresh/store boundary.**
--
-- Arm 1 re-reads AFTER the overlapping chain -- the re-read IS the refresh, so
-- deciding on `frisch` stays silent. Arm 2 only STORES the stale name after
-- the chain -- store/move positions never decide, so no refusal. Arm 3 decides
-- on the stale name itself, and only that decision falls, as `M147`. The
-- transitive mirror of gift/754, which pins the same boundary across a direct
-- call (and that file mirrors gift/717 across an indirect call). A run over
-- this file must report exactly one `M147`, at arm 3.
module gift771 {

static mut ZUSTAND : u32 = 0;

impl fn schreiber()
    effects { writes ZUSTAND }
    costs <= 4 ops
{
    ZUSTAND = 1;
}

impl fn mitte()
    effects { writes ZUSTAND }
    costs <= 8 ops
{
    schreiber();
}

impl fn aufgefrischt() -> u32
    effects { reads ZUSTAND, writes ZUSTAND }
    costs <= 32 ops
{
    let alt : u32 = ZUSTAND;
    mitte();
    let frisch : u32 = ZUSTAND;
    if frisch != 0 { return 1; }
    return 0;
}

impl fn abgelegt() -> u32
    effects { reads ZUSTAND, writes ZUSTAND }
    costs <= 32 ops
{
    let alt : u32 = ZUSTAND;
    mitte();
    ZUSTAND = alt;
    return 0;
}

impl fn faellig() -> u32
    effects { reads ZUSTAND, writes ZUSTAND }
    costs <= 32 ops
{
    let alt : u32 = ZUSTAND;
    mitte();
    if alt != 0 { return 1; }
    return 0;
}

}
