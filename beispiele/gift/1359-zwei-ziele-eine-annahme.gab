-- erwartet: N566
-- Gift 1359 -- **Two targets, one named assumption.** `metal` binds `sys_write` under
-- `linux_write_contract`: a gate's assumption is a statement about ONE kernel, and another
-- kernel keeps its contract under its own name, never silently under the first one's
-- (OFFEN O31).

module gift::zwei_ziele_eine_annahme {

reason IoError {
    BadFd = 9 "the file descriptor is not open"
    exhaustive
}

assume linux_write_contract
    "Write keeps its contract on this machine."
    falsifier sonde_write;

assume metal_kernel_contract
    "The image's kernel entry keeps the Linux x86_64 convention for the numbers it serves."
    falsifier sonde_metall_systemruf;

syscall sys_write;

syscall write(fd : u64) -> u64 or IoError
    via sys_write
    effects { pure }
    costs <= 8 ops;

target linux_x86_64 abi linux arch x86_64 {
    sys_write = number 1
        regs in { rdi = fd }
        regs out { rax }
        clobbers { rcx, r11 }
        errors { EBADF => BadFd }
        assume linux_write_contract falsifier sonde_write;
}

target metal abi metal arch x86_64 {
    sys_write = number 1
        regs in { rdi = fd }
        regs out { rax }
        clobbers {  }
        errors { EBADF => BadFd }
        assume linux_write_contract falsifier sonde_write;
}

target linux_x86_64;

}
