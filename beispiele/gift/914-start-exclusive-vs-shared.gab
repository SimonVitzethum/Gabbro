-- erwartet: N240
-- **Exclusive against shared on one lock falls -- exclusivity excludes everyone.**
--
-- `read_a` requires `Held(L)` exclusively while `read_b` requires
-- `Held(L, shared)`: an exclusive holder excludes every other holder, so the
-- pair cannot start together and N240 falls. Only shared-shared co-holding is
-- silent (gift 913); any exclusive side falls. Both bodies only READ, so the
-- refusal set is exactly `[N240]`. The second set pairs `read_b` with `idle`,
-- which holds nothing -- the positive twin: the shared reader beside a
-- lock-free start stays silent.
module gift914 {

table T count 4 {
    slot { v : u32, }
}

lock L protects { T } rank 0 held <= 100 ops;

-- Must fall (N240, with `read_b`): exclusive `L` against shared `L`.
impl fn read_a() -> u32
    requires Held(L)
    effects { reads T.slots }
    costs <= 4 ops
{
    return T.slots[0].v;
}

-- Must pass N240 beside `idle`, must fall beside `read_a`.
impl fn read_b() -> u32
    requires Held(L, shared)
    effects { reads T.slots }
    costs <= 4 ops
{
    return T.slots[1].v;
}

-- Must pass N240: starts holding nothing.
impl fn idle() -> u32
    effects { pure }
    costs <= 1 ops
{
    return 0;
}

concurrent { read_a, read_b };

concurrent { read_b, idle };

}
