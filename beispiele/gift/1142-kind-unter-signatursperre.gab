-- erwartet: N456
-- **1142 -- a `child` in a function that holds a lock by signature (fix lane F3).**
--
-- `requires Held(L)` says the CALLER holds `L` for this body -- the parent
-- thread. The child started here holds nothing, so the signature-held lock
-- is no cover on its path. `N456` refuses the child in such a function; take
-- `L` inside the child instead (`child { locks L { … } … }`).

module gift1142 {

reason UebergabeFehler {
    KeinStapel = 1 "no stack was handed"
    exhaustive
}

assume faden_start_vertrag
    "The starter keeps its contract on this machine."
    falsifier sonde_faden_start;

syscall roher_start(art : u64, stapel : u64) -> u64 or UebergabeFehler
    abi linux arch x86_64 number 1000
    regs in { rdi = art, rsi = stapel }
    regs out { rax }
    stack rsi
    clobbers { rcx, r11 }
    errors { NSTACK => KeinStapel }
    effects { pure }
    costs <= 64 ops
    assume faden_start_vertrag falsifier sonde_faden_start;

extern fn ausgang(code : u64) -> never effects { diverges } costs <= 1 ops;

static mut g : u64 = 0;
lock L protects { g } rank 0 held <= 100 ops;

impl fn starter(art : u64, stapel : u64) -> u64
    requires Held(L)
    effects { reads g, diverges }
{
    let v = roher_start(art, stapel) else (e) {
        return 999;
    }
    if v == 0 {
        child {
            ausgang(0);
        }
    }
    return g;
}

}
