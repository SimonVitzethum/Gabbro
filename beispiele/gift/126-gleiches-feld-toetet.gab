-- erwartet: M101
-- **Die zweite Gegenrichtung: dasselbe Feld.**
-- Die Ausnahme gilt fuer VERSCHIEDENE Felder desselben Objekts. Wird das Feld selbst
-- ueberschrieben, stirbt seine Tatsache -- das ist die aelteste Regel der Faktenmenge
-- (`SPRACHE.md` 3.2: ein Fakt stirbt bei jedem Schreiben auf seinen Platz).
module gift::gleiches_feld {

const KAP : u32 = 64;
type Text = { bytes : [u8; KAP], len : u32 in 0 .. KAP, };

impl fn a(s : ptr<normal, rw> Text) -> bool
    effects { reads s, writes s } costs <= 12 ops
{
    narrow s.len to 0 ..< KAP else { return false; }
    s.len = 64;
    s.len += 1;
    return true;
}

}
