-- erwartet: U007
-- **Gift 66 -- eine Gruppen-Invariante, die nichts verbindet.**
--
-- Die Gruppe existiert fuer eine Aussage ZWISCHEN Traegern. Diese hier quantifiziert ueber
-- `Endpunkte` und liest `Endpunkte` -- sie nennt `Faeden` gar nicht. Damit ist sie eine
-- `table Endpunkte … invariant` mit mehr Zeremonie, und die Gruppe waere bloss die
-- bequemere Schreibweise.
--
-- **Ein Konstrukt, das nur bequemer ist, hat in diesem Ordner keinen Beleg** (W3).
--
-- `U007` ist dieselbe Absage wie `U004`, eine Ebene tiefer: dort ist die DEKLARATION
-- einelementig, hier die AUSSAGE.
--
-- ERWARTET: U007, und sonst nichts.



module gift66 {

const NFAEDEN    : u32 = 256;
const NPUNKTE    : u32 = 64;
const KEIN_FADEN : u32 = 4294967295;

table Faeden count NFAEDEN {
    slot {
        gruende  : u32,
        bereit   : bool,
    }
}

table Endpunkte count NPUNKTE {
    slot {
        wartet : u32,
    }
}

lock PUNKTE protects { Endpunkte } rank 1 held <= 40 ops;
lock PLAN   protects { Faeden }    rank 2 held <= 40 ops;

-- Die Verbindungs-Invariante lebt zwischen den beiden Traegern, nicht in einem.
group Zustellung over { Endpunkte, Faeden } {
    -- **Die Aussage, die es ohne Gruppe nicht gibt.** Sie quantifiziert ueber Endpunkte und
    -- liest Faeden -- keine `table … invariant` kann das sagen, weil sie nur ueber ihrem
    -- eigenen Traeger quantifiziert. `U007` faellt, wenn eine Gruppen-Invariante nur EINEN
    -- Traeger nennt: dann gehoert sie an die Tabelle, und die Gruppe waere bloss bequemer.
    invariant wartende_haben_grund cost O(n) runs offline :
        forall e in slots of Endpunkte : Endpunkte.slots[e].wartet > 0;
}

-- **Der Fehler.** Beide Traeger geschrieben, nur `PUNKTE` gehalten.
impl fn einreihen(e : index into Endpunkte, t : index into Faeden)
    effects { reads Endpunkte.slots, writes Endpunkte.slots, writes Faeden.slots,
              locks PUNKTE, locks PLAN }
    costs   <= 40 ops
{
    locks PUNKTE {
      locks PLAN {
        Endpunkte.slots[e].wartet = t;
        Faeden.slots[t].gruende   = 1;
      }
    }
}

}
