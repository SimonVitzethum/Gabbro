-- erwartet: H007
-- **Gift 74 -- `protects` beisst, seit K11.2.1.**
--
-- Bis zum 2026-08-17 ging diese Datei mit **0 Fehlern** durch. `H001`-`H006` pruefen die
-- DISZIPLIN einer genommenen Sperre -- geteilt gegen exklusiv, Rang, Haltezeit. Sie pruefen
-- nicht, **dass sie genommen wird**.
--
-- *Die Klasse Rennen hing damit nicht am Speichermodell, sondern an einer Regel, die niemand
-- gebaut hatte.*

module gift74 {

table K count 8 { slot { a : u32, } }
lock KAPPEN protects { K } rank 3 held <= 40 ops;

-- Diese hier macht es richtig -- damit ist die Sperre GENOMMEN und `H008` schweigt.
-- *Eine Giftprobe soll EINEN Befund zeigen, nicht zwei uebereinander.*
impl fn ordentlich(i : index into K) -> bool
    effects { writes K, locks KAPPEN } costs <= 40 ops
{
    locks KAPPEN {
        K.slots[i].a = 1;
    }
    return true;
}

impl fn schreib(i : index into K) -> bool
    effects { writes K } costs <= 4 ops
{
    K.slots[i].a = 1;
    return true;
}

}
