-- erwartet: K006
-- **Die einzige Schleifenform, die unendlich laufen darf, hatte keine geprüfte
-- Kostenaussage.** `bounded N ops` WAR die Zusage: der Pass las die Zahl und sah den Rumpf
-- nie an. *Zehn Zuweisungen unter `bounded 2 ops` gingen mit null Fehlern durch* -- und die
-- Wartestelle, deren Latenz an dieser Zahl haengt, log um den Faktor fuenf.
module gift::retry_rumpf {

static mut a : u32 = 0;

extern fn zeitablauf() -> never effects { diverges };
assume geraet_antwortet "Das Geraet antwortet innerhalb der zugesagten Leseoperationen."
    falsifier sonde_geraet_antwortet;

impl fn warte(f : u32) -> u32
    effects { writes a }
    costs   <= 64 ops
{
    retry warten until f == 1
        bounded 2 ops
        progress geraet_antwortet
        on_exceeded zeitablauf
        effects { writes a }
    {
        a = 1; a = 2; a = 3; a = 4; a = 5;
        a = 6; a = 7; a = 8; a = 9; a = 10;
    }
    return 0;
}

}
