-- 06 -- Hardware-Annahmen, Axiome und die lineare Pruefpflicht.
--
-- **Drei Klassen, und die dritte gibt es syntaktisch nicht:** *falsifiziert* (Sonde lief),
-- *nicht falsifizierbar* (mit Grund als Zeichenkette), *nicht gefahren* -- und das ist die
-- Abwesenheit beider Angaben und ein Uebersetzungsfehler. Eine nicht gefahrene Annahme darf
-- nie wie eine falsifizierte aussehen.
--
-- `gabbro annahmen 06-annahmen.gab` gibt daraus die Menge, unter der alles Weitere gilt.

module beispiel::annahmen {

opaque type Pa      = u64;
opaque type FadenId = u32;

assume mmu_folgt_ihrem_modell
    "Eine Uebersetzung mit P=0 faultet, bevor ein Zugriff die Zeile beruehrt."
    falsifier sonde_pf_bei_p0;

assume tlb_ist_nach_cr3_leer
    "Ein Schreiben auf CR3 verwirft die nicht-globalen Eintraege."
    falsifier sonde_tlb_nach_cr3;

assume x2apic_zweischritt
    "EN und EXTD in einem Schreibvorgang ist ein verbotener Uebergang."
    unfalsifiable "qemu64 hat kein x2APIC -- die Sonde hat hier kein Geraet";

assume ipi_kommt_an
    "Ein gesendetes IPI erreicht den Zielkern in endlicher Zeit."
    unfalsifiable "Lebendigkeit faellt unter keinen Mechanismus dieser Sprache";

-- Je privilegiertem Befehl ein erklaerter Effekt. Das ist die groesste unbewiesene
-- Flaeche der Sprache -- groesser als der Uebersetzer -- und deshalb zaehlbar.
axiom write_cr3(p : Pa) effects { writes tlb, writes aktive_tabelle } falsifier sonde_cr3;
axiom invlpg(v : u64)   effects { writes tlb }                       falsifier sonde_invlpg;
axiom rdtsc()           effects { reads zeitzaehler }                falsifier sonde_tsc;
axiom wbinvd()          effects { writes cache }
    unfalsifiable "die Wirkung ist auf dieser Maschine nicht beobachtbar";

-- `check` erzeugt eine `linear ghost Duty(name)`: eine Pflicht, die verbraucht werden MUSS.
-- Vier Uebersetzungsfehler fallen dabei aus M1/M2/M3 statt aus Sonderregeln: `gates` fehlt
-- -> die Pflicht wird nie verbraucht; `can_fail` fehlt -> dito; eine Groesse unter
-- `measures`, die der gemessene Pfad schreibt -> Schreibrecht; einseitige Schwelle ohne
-- `floor` -> die Groesse hat keinen Bereich.
check stapel_wasserstand {
    claim        "Kein Kern hat je mehr als 3/4 seines Stapels benutzt."
    measures     tiefe_max, tiefe_lebend, kerne_gemessen
    gates        abnahme, freigabe
    can_fail {
        let g = groesse_gemessen() else (e1) { return; }
        if tiefe_max * 4 >= g * 3 {
            return;
        }
    }
    floor        kerne_gemessen >= 2, tiefe_max >= 1
    counterprobe "Ein Kern mit kuenstlich tiefem Aufruf muss die Pflicht fallen lassen."
        expects sonde_tiefer_stapel
}

extern fn groesse_gemessen() -> u64 effects { reads stapel };

-- ==========================================================================================
-- K100.2 -- die fuenf UMGEBUCHTEN Klempnereipflichten (2026-08-17)
--
-- **Eine Umbuchung ist keine Erledigung.** Diese fuenf Saetze standen bis heute als haengende
-- Klempnereipflichten in `PFLICHTEN.md` -- Stellen, an denen der Mensch etwas von Hand zu
-- zeigen hatte. Sie sind es nicht: es sind Aussagen ueber die MASCHINE, und dafuer gibt es
-- den richtigen Ort.
--
-- > *Sie hier zu fuehren heisst, sie beim Namen mit einer Sonde zu tragen -- nicht, sie
-- > erledigt zu haben.* Genau diese Vertrauensform ist gemeint, wenn jemand sagt „im
-- > Vertrauen auf Gabbro und seine Hardwareannahmen": das Vertrauen bekommt eine Liste.
--
-- **Und der Preis steht dabei:** die Vertrauensbasis waechst um fuenf Saetze, zwei davon
-- ohne Sonde. Wer die Klempnereizahl liest, muss diese Zeile mitlesen.

assume dma_veroeffentlichung_braucht_barriere
    "Ein Speichern in eine DMA-Region wird fuer das Geraet erst nach der Barriere des Raumes sichtbar; ohne sie liest das Geraet den alten Wert."
    falsifier sonde_dma_ohne_barriere;

assume masks_irq_schuetzt_wie_eine_sperre
    "Auf einem Kern mit maskierten Interrupts kann kein anderer Pfad desselben Kerns dazwischentreten; der Wert ueberquert die Grenze unveraendert."
    falsifier sonde_irq_maskiert;

assume mmu_schreibt_nur_a_und_d
    "Die MMU setzt in einem Seitentabelleneintrag ausschliesslich die Bits A und D; kein anderes Feld aendert sich ohne Software."
    unfalsifiable "eine Sonde muesste die MMU anhalten und dabei genau das Fenster oeffnen, in dem sie schreibt";

assume release_stellt_sichtbarkeit_her
    "Ein Release-Speichern macht jede vorher geschriebene Nutzlast fuer den Leser sichtbar, der dieselbe Zelle mit Acquire liest."
    unfalsifiable "das Speichermodell ist nicht durch Ausfuehrung widerlegbar -- eine erfolgreiche Probe zeigt nur, dass die Umordnung diesmal ausblieb";

assume geraeteregister_veroeffentlicht_wie_ein_atomic
    "Ein volatiler Speichervorgang in ein Geraeteregister macht die zuvor geschriebene Nutzlast fuer das Geraet sichtbar, sobald das Register geschrieben ist."
    falsifier sonde_virtio_avail;

}
