-- 160 -- A checked clone handoff that reads the handed stack (lane 260).
--
-- The clean twin of `beispiele/gift/1181`: the same gate, but the region
-- stands behind the `if v == 0` guard holding nothing but it, so the gate
-- lowers to the inline trap (lane 260) and the child enters the region by
-- jump at its label. The region reads `stapel` -- exactly what the gate
-- call handed over (`roher_start(art, stapel)`) -- so the spill rules stay
-- silent (`N451`/`N452`), and the path is well-formed beside it
-- (`N448`/`N449`, `N450`, `N456`/`N457` silent). 0 errors, 0 hints at the
-- checker; the emitter lowers gate and region, and the C compiles.
--
-- Same shape gate as 155/156 (not the raw clone, `1000` not an OS number;
-- the real-number counterpart lives outside the tree).

module beispiel::kind_liest_stapel {

reason UebergabeFehler {
    KeinStapel = 1 "no stack was handed"
    exhaustive
}

assume faden_start_vertrag
    "The starter keeps its contract on this machine."
    falsifier sonde_faden_start;

syscall roher_start(art : u64, stapel : u64) -> u64 or UebergabeFehler
    abi linux arch x86_64 number 1000
    regs in { rdi = art, rsi = stapel }
    regs out { rax }
    stack rsi
    clobbers { rcx, r11 }
    errors { NSTACK => KeinStapel }
    effects { pure }
    costs <= 64 ops
    assume faden_start_vertrag falsifier sonde_faden_start;

extern fn ausgang(code : u64) -> never effects { diverges } costs <= 1 ops;

impl fn starter(art : u64, stapel : u64) -> u64
    effects { diverges }
{
    let v = roher_start(art, stapel) else (e) {
        match e {
            KeinStapel => { return 999; }
        }
    }
    if v == 0 {
        child {
            let r = stapel;
            ausgang(r);
        }
    }
    return v;
}

}
