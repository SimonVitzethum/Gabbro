-- 01 -- `table`: eine Datenstruktur mit Invarianten und erzeugten Mutationen.
--
-- Der Zuschnitt entscheidet sich an EINER Zeile: eine `table` MIT `ops` laesst keine
-- handgeschriebene Mutation mehr zu (der Erzeuger zeigt die Erhaltung einmal ueber der
-- Deklaration), eine OHNE ist reine Beschreibung. Beides ist dieselbe Syntax -- der
-- Unterschied ist sichtbar gewaehlt statt schleichend.

module beispiel::tabelle {

const NSLOTS   : u32 = 4096;
const NOBJEKTE : u32 = 1024;

type SlotIdx  = u32 in 0 ..< NSLOTS;
type ObjIdx   = u32 in 0 ..< NOBJEKTE;
type Zaehler  = u32 in 0 .. 65535;

opaque type Pa      = u64;
opaque type EpId    = u32;
opaque type FadenId = u32;

tagged type ObjektArt = { Speicher(Pa), Endpunkt(EpId), Faden(FadenId), Antwort(EpId) };

reason KappenFehler {
    KeinSlot    = 1 "kein freier Slot mehr"
    Ungueltig   = 2 "abgelaufenes Handle"
    HatKinder   = 3 "erst die Nachfahren einsammeln"
    exhaustive
}

lock KAPPEN protects { eintraege, baum } rank 0 held <= 400 ops masks irqs;

-- Zweite Tabelle: `table` kennt genau EIN `slot`-Wort, und die Verbindung zwischen
-- beiden traegt `index into` -- ein Index, dessen Schranke aus der Deklaration faellt.
table Objekte {
    slot {
        benutzt : bool,
        marke   : u32 wrapping,
        art     : ObjektArt,
        zaehler : Zaehler,
    }
}

table Kappenraum {
    const WURZEL : u32 = 0;

    slot {
        benutzt      : bool,
        marke        : u32 wrapping,
        objekt       : index into Objekte,
        abzeichen    : u64,
        elter        : option index into Kappenraum,
        erstes_kind  : option index into Kappenraum,
        naechstes    : option index into Kappenraum,
        vorheriges   : option index into Kappenraum,
    }

    invariant wurzel_ohne_vorgaenger cost O(n) runs offline :
        forall s in slots of Self : Self.slots[s].elter == None
            => Self.slots[s].vorheriges == None;

    -- Ohne `ops` ist diese Tabelle Zuschnitt (a): reine Beschreibung mit erzeugtem
    -- Pruefer. Mit `ops einfuegen, …` waere jede Handmutation unten ein Fehler --
    -- der Unterschied ist eine Zeile und damit sichtbar gewaehlt.
    invariant baum_bleibt_baum cost O(n) runs offline
        by induction over descendants of Self :
        forall s in slots of Self : Self.slots[s] reaches WURZEL via elter;
}

spec fn ist_blatt(c : ptr<normal, r> Kappenraum, s : SlotIdx) -> bool
    effects { pure }
    = c.slots[s].benutzt && c.slots[s].erstes_kind == None;

spec fn baum_wohlgeformt(c : ptr<normal, r> Kappenraum) -> bool
    effects { pure }
    = forall s in slots of c : c.slots[s] reaches WURZEL via elter;

impl fn aushaengen(c : ptr<normal, rw> Kappenraum, s : SlotIdx)
    requires  Held(KAPPEN), c.slots[s].benutzt
    ensures   c.slots[s].elter == None,
              c.slots[s].vorheriges == None,
              c.slots[s].naechstes == None
    maintains baum_wohlgeformt
    effects   { writes c.slots, locks KAPPEN }
    costs     <= 40 ops
{
    match c.slots[s].vorheriges {
        Some(p) => { c.slots[p].naechstes = c.slots[s].naechstes; }
        None     => {
            match c.slots[s].elter {
                Some(e) => { c.slots[e].erstes_kind = c.slots[s].naechstes; }
                None     => { }
            }
        }
    }
    match c.slots[s].naechstes {
        Some(n) => { c.slots[n].vorheriges = c.slots[s].vorheriges; }
        None     => { }
    }
    c.slots[s].elter      = None;
    c.slots[s].erstes_kind = None;
    c.slots[s].naechstes  = None;
    c.slots[s].vorheriges = None;
}

-- `by consuming` traegt Terminierung UND Blattheit: die Domaene liefert ihre Zeugen in
-- der von der Struktur erzeugten Ordnung, tiefenfallend. Der Rumpf schrumpft auf eine Zeile.
impl fn einsammeln(c : ptr<normal, rw> Kappenraum,
                   o : ptr<normal, rw> Objekte,
                   s : SlotIdx)
    requires  Held(KAPPEN), baum_wohlgeformt(c)
    maintains baum_wohlgeformt
    effects   { consumes c.slots, writes o.slots, locks KAPPEN }
    costs     <= 4096 ops
    by        induction over descendants of s
{
    traverse opfer over descendants of c.slots[s] by consuming
        touches consumes c.slots, writes o.slots
    {
        blatt_loeschen(c, o, opfer);
    }
}

impl fn blatt_loeschen(c : ptr<normal, rw> Kappenraum,
                       o : ptr<normal, rw> Objekte,
                       s : SlotIdx)
    requires  Held(KAPPEN), c.slots[s].benutzt, ist_blatt(c, s)
    ensures   !c.slots[s].benutzt
    maintains baum_wohlgeformt
    effects   { writes c.slots, writes o.slots, locks KAPPEN }
    costs     <= 200 ops
{
    let obj = c.slots[s].objekt;
    aushaengen(c, s);
    c.slots[s].marke   += 1;
    c.slots[s].benutzt  = false;

    -- Die Buchfuehrung: der Zaehler faellt nur, wenn er oben ist. Ohne die Pruefung
    -- verlaesst `- 1` den Bereich von `Zaehler` -- M1 sagt das, nicht ein Testlauf.
    if o.slots[obj].zaehler >= 1 {
        o.slots[obj].zaehler -= 1;
    }

    if o.slots[obj].zaehler == 0 {
        match o.slots[obj].art {
            Speicher(p)  => { speicher_freigeben(p); }
            Endpunkt(e)  => { }
            Faden(f)     => { }
            Antwort(a)   => { }
        }
        o.slots[obj].benutzt = false;
    }
}

extern fn speicher_freigeben(p : Pa) effects { writes halde };

}
