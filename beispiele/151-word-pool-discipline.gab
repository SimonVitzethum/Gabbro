-- 151 -- **THE LAYOUT FACTOR: a byte-addressed pool in word-sized storage.**
--
-- A firewall keeps one counter per rule, one flag per connection -- bytes by
-- meaning, words by machine. The byte-addressed pool below holds NBYTES payload
-- bytes in NWORDS `u32` slots (NBYTES = 4 * NWORDS, exact by construction), and
-- every access derives its two numbers from the byte index `i`:
--
--     w = i >> 2        the word holding byte i
--     s = (i & 3) * 8   the bit offset of byte i inside that word
--
-- A read is `(wort >> s) & 255`; a write is a read-modify-write through the mask
-- `u32(255) << s`. Both functions check with `0 errors, 0 hints`, emit plain C
-- (`WPOOL_speicher.slots[w].w`, no run-bound check per access), and compile under
-- `cc -Werror -O0` and `-O2` with identical results (measured, see MUSE-REPORT-237).
--
-- WHY THIS IS THE MIDDLE OF THREE LANES. Lane 224 builds the bound shapes in
-- `m1.rs`; lane 236 proves bucket discipline on top. This file is the layout that
-- makes both possible: every index expression below is a shape the checker
-- accepts TODAY, with the range the checker reads beside it --
--
--     i >> 2          `u32 in 0 .. 1023`  (shr narrows: hi >> amount)
--     i & 3           `u32 in 0 .. 3`     (band: min of the two maxima)
--     (i & 3) * 8     `u32 in 0 .. 24`    (mul: min/max of the four corners)
--     wort >> s       clean               (amount range below the width)
--     (wort >> s) & 255  `u32 in 0 .. 255` (band again)
--     u32(255) << s   clean               (amount 0 .. 24 below 32)
--
-- -- and M103 holds each derived index against `count NWORDS` once, at the
-- -- access, instead of the emitter re-checking every access at run time (that is
-- -- what `152-byte-pool-cost.gab` measures: the direct byte carrier emits a
-- -- bound check per access, x3.16 the C per read -- 79 vs 25 characters).
--
-- TWO DOCUMENTED GAPS, not worked around:
-- 1. `255 << s` is refused (`M104`: the literal `255` carries `u8`, and the
--    amount `0 .. 24` leaves that width). The file writes `u32(255) << s` --
--    the remedy the refusal names -- and the shape a per-shape lane could add
--    is "a literal takes the shift operand's width".
-- 2. Wrapping `+%` needs an exact range `0 .. 2^N - 1` (`M153`): a pool of 1000
--    words cannot offer `slots[i +% 1]`. This pool is 1024 words deep exactly so
--    the ring shape stays available; the refusal text is quoted in MUSE-REPORT-237.
--
-- LINK BUDGET (measured, not bumped -- MARKE_EMIT moves at merge, see report):
-- the same discipline over `count 1048576` (4 MiB static) emits 1783 bytes of C
-- and links on the build machine with 4194336 bytes of bss. The emitted C does
-- not grow with the pool; the static storage is one word per word. Fits statically.
module beispiel151 {

pub const NWORDS : u32 = 1024;
pub const NBYTES : u32 = 4096;

pub table WPOOL count NWORDS {
    slot {
        w : u32,
    }
}

pub lock WSPERRE protects { WPOOL } rank 0 held <= 64 ops;

-- The word layer: what lane 236's bucket discipline stands on. A bare slot
-- index, no arithmetic -- the shape every derived index above is held against.
pub impl fn lies_wort(w : u32 in 0 ..< NWORDS) -> u32
    requires Held(WSPERRE)
    effects { reads WPOOL.slots, locks WSPERRE }
    costs   <= 2 ops
{
    return WPOOL.slots[w].w;
}

-- The byte read: word `i >> 2`, bit offset `(i & 3) * 8`, extract and mask.
pub impl fn lies_byte(i : u32 in 0 ..< NBYTES) -> u32 in 0 ..< 256
    requires Held(WSPERRE)
    effects { reads WPOOL.slots, locks WSPERRE }
    costs   <= 14 ops
{
    let w : u32 = i >> 2;
    let s : u32 = (i & 3) * 8;
    let wort : u32 = WPOOL.slots[w].w;
    return (wort >> s) & 255;
}

-- The byte write: the same derivation, then a read-modify-write through the
-- lane mask. Neighbouring bytes in the word survive: the mask clears exactly
-- the addressed lane and `|` sets it.
pub impl fn schreibe_byte(i : u32 in 0 ..< NBYTES, v : u32 in 0 ..< 256)
    requires Held(WSPERRE)
    effects { reads WPOOL.slots, writes WPOOL.slots, locks WSPERRE }
    costs   <= 24 ops
{
    let w : u32 = i >> 2;
    let s : u32 = (i & 3) * 8;
    let wort : u32 = WPOOL.slots[w].w;
    let maske : u32 = u32(255) << s;
    WPOOL.slots[w].w = (wort & ~maske) | (v << s);
}

}
