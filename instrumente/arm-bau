#!/usr/bin/env bash
# Queued build of arm/ (separate Lake project, Lean pinned by arm/lean-toolchain, no mathlib).
# Up to three builds at a time. Error count of the COMPLETE output first.
cd "$(dirname "$(realpath "$0")")/arm" || exit 2
OUT=$(/home/simon/Dokumente/gabbro-arm/bin/arm-slot bash -c "env -u ELAN_TOOLCHAIN ~/.elan/bin/lake build 2>&1"); RC=$?
echo "== exit $RC; $(echo "$OUT" | grep -cE "error") error line(s) in the COMPLETE output"
echo "$OUT" | grep -E "^[^ ].*: error" | cut -c1-160 | head -40
echo "$OUT" | tail -15
exit "$RC"
